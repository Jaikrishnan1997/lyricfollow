[{"q":{"en":"Who wrote the song of songs?","ta":"உன்னதப்பாட்டைப் பாடினவர் யார்?","ml":"ഉത്തമഗീതം എഴുതിയതു ആര്?"},"a":{"en":"Solomon","ta":"சாலொமோன்","ml":"ശലോമോൻ"},"ref":[21,1,1]},{"q":{"en":"What did the bride say is better than wine?","ta":"திராட்சரசத்தைப் பார்க்கிலும் இன்பமானது எது?","ml":"വീഞ്ഞിലും രസകരമായതു എന്ത്?"},"a":{"en":"Thy love","ta":"உமது நேசம்","ml":"നിന്റെ പ്രേമം"},"ref":[21,1,2]},{"q":{"en":"What is the beloved's name compared to?","ta":"நேசருடைய நாமம் எதற்கு ஒப்பாயிருக்கிறது?","ml":"പ്രിയന്റെ നാമം എന്തിനോടു തുല്യമാകുന്നു?"},"a":{"en":"Ointment poured forth","ta":"ஊற்றுண்ட பரிமளதைலம்","ml":"പകർന്ന തൈലം"},"ref":[21,1,3]},{"q":{"en":"Who love the beloved, according to the bride?","ta":"நேசரை நேசிக்கிறவர்கள் யார்?","ml":"പ്രിയനെ സ്നേഹിക്കുന്നതു ആര്?"},"a":{"en":"The virgins","ta":"கன்னியர்கள்","ml":"കന്യകമാർ"},"ref":[21,1,3]},{"q":{"en":"Where did the king bring the bride?","ta":"ராஜா அவளை எங்கே அழைத்துக்கொண்டுவந்தார்?","ml":"രാജാവു അവളെ എവിടേക്കു കൊണ്ടുവന്നു?"},"a":{"en":"Into his chambers","ta":"தமது அறைகளில்","ml":"പള്ളിയറകളിലേക്കു"},"ref":[21,1,4]},{"q":{"en":"What will they remember more than wine?","ta":"திராட்சரசத்தைப் பார்க்கிலும் எதை நினைப்போம்?","ml":"വീഞ്ഞിനെക്കാൾ എന്തിനെ ശ്ളാഘിക്കും?"},"a":{"en":"Thy love","ta":"உமது நேசத்தை","ml":"നിന്റെ പ്രേമത്തെ"},"ref":[21,1,4]},{"q":{"en":"What did the bride say she was, though black?","ta":"கறுப்பாயிருந்தாலும் அவள் எப்படி இருக்கிறாள்?","ml":"കറുത്തവളെങ്കിലും അവൾ എങ്ങനെയുള്ളവൾ?"},"a":{"en":"Comely","ta":"அழகாயிருக்கிறேன்","ml":"അഴകുള്ളവൾ"},"ref":[21,1,5]},{"q":{"en":"Whose tents is the bride compared to?","ta":"மணவாட்டி யாருடைய கூடாரங்களுக்கு ஒப்பிடப்படுகிறாள்?","ml":"മണവാട്ടിയെ ഏതു കൂടാരങ്ങളോടു ഉപമിക്കുന്നു?"},"a":{"en":"Kedar","ta":"கேதாரின் கூடாரங்கள்","ml":"കേദാര്യകൂടാരങ്ങൾ"},"ref":[21,1,5]},{"q":{"en":"Whose curtains is the bride compared to?","ta":"மணவாட்டி யாருடைய திரைகளுக்கு ஒப்பிடப்படுகிறாள்?","ml":"മണവാട്ടിയെ ആരുടെ തിരശ്ശീലകളോടു ഉപമിക്കുന്നു?"},"a":{"en":"Solomon's","ta":"சாலொமோனின் திரைகள்","ml":"ശലോമോന്റെ തിരശ്ശീലകൾ"},"ref":[21,1,5]},{"q":{"en":"Whom does the bride address as daughters?","ta":"மணவாட்டி யாரை நோக்கிப் பேசுகிறாள்?","ml":"മണവാട്ടി ആരോടു സംസാരിക്കുന്നു?"},"a":{"en":"Daughters of Jerusalem","ta":"எருசலேமின் குமாரத்திகள்","ml":"യെരൂശലേംപുത്രിമാർ"},"ref":[21,1,5]},{"q":{"en":"What had looked upon the bride and made her dark?","ta":"மணவாட்டியின்மேல் பட்டு அவளைக் கறுப்பாக்கினது எது?","ml":"മണവാട്ടിയെ കറുപ്പിച്ചതു എന്തു?"},"a":{"en":"The sun","ta":"வெய்யில்","ml":"വെയിൽ"},"ref":[21,1,6]},{"q":{"en":"Who were angry with the bride?","ta":"மணவாட்டிமேல் கோபமாயிருந்தவர்கள் யார்?","ml":"മണവാട്ടിയോടു കോപിച്ചതു ആര്?"},"a":{"en":"Her mother's children","ta":"தாயின் பிள்ளைகள்","ml":"അമ്മയുടെ പുത്രന്മാർ"},"ref":[21,1,6]},{"q":{"en":"What did her mother's children make her?","ta":"தாயின் பிள்ளைகள் அவளை எதற்கு வைத்தார்கள்?","ml":"അമ്മയുടെ പുത്രന്മാർ അവളെ എന്തിനു ആക്കി?"},"a":{"en":"Keeper of the vineyards","ta":"திராட்சத்தோட்டங்களுக்குக் காவற்காரி","ml":"മുന്തിരിത്തോട്ടങ്ങൾക്കു കാവൽ"},"ref":[21,1,6]},{"q":{"en":"When does the beloved make his flock rest?","ta":"நேசர் தமது மந்தையை எப்போது மடக்குகிறார்?","ml":"പ്രിയൻ ആടുകളെ എപ്പോൾ കിടത്തുന്നു?"},"a":{"en":"At noon","ta":"மத்தியானத்தில்","ml":"ഉച്ചെക്കു"},"ref":[21,1,7]},{"q":{"en":"Beside what shall the bride feed her kids?","ta":"மணவாட்டி தன் ஆட்டுக்குட்டிகளை எங்கே மேயவிடவேண்டும்?","ml":"മണവാട്ടി കുഞ്ഞാടുകളെ എവിടെ മേയിക്കേണം?"},"a":{"en":"The shepherds' tents","ta":"மேய்ப்பர்களுடைய கூடாரங்களண்டையில்","ml":"ഇടയന്മാരുടെ കൂടാരങ്ങളുടെ അരികെ"},"ref":[21,1,8]},{"q":{"en":"To what in Pharaoh's chariots is the beloved compared?","ta":"பார்வோனுடைய இரதங்களில் எதற்கு அவளை ஒப்பிடுகிறார்?","ml":"ഫറവോന്റെ രഥത്തിൽ എന്തിനോടു അവളെ ഉപമിക്കുന്നു?"},"a":{"en":"A company of horses","ta":"பரிகள் பவுஞ்சு","ml":"പെൺകുതിര"},"ref":[21,1,9]},{"q":{"en":"Whose chariots are mentioned in the verse?","ta":"இந்த வசனத்தில் யாருடைய இரதங்கள் சொல்லப்பட்டுள்ளன?","ml":"ഈ വാക്യത്തിൽ ആരുടെ രഥം പറയുന്നു?"},"a":{"en":"Pharaoh's","ta":"பார்வோனுடைய","ml":"ഫറവോന്റെ"},"ref":[21,1,9]},{"q":{"en":"What are the bride's cheeks comely with?","ta":"மணவாட்டியின் கன்னங்கள் எவைகளால் அழகாயிருக்கின்றன?","ml":"മണവാട്ടിയുടെ കവിൾത്തടങ്ങൾ എന്തുകൊണ്ടു ശോഭിച്ചിരിക്കുന്നു?"},"a":{"en":"Rows of jewels","ta":"ஆபரணாதிகள்","ml":"രത്നാവലി"},"ref":[21,1,10]},{"q":{"en":"What will they make for the bride with studs of silver?","ta":"வெள்ளிப் பொட்டுகளுடன் அவளுக்கு எதைப் பண்ணுவோம்?","ml":"വെള്ളിമണികളോടുകൂടെ അവൾക്കു എന്തു ഉണ്ടാക്കിത്തരാം?"},"a":{"en":"Borders of gold","ta":"பொன் ஆபரணங்கள்","ml":"സുവർണ്ണസരപ്പളി"},"ref":[21,1,11]},{"q":{"en":"What sends forth its smell while the king sits at his table?","ta":"ராஜா பந்தியிலிருக்கையில் வாசனை வீசுவது எது?","ml":"രാജാവു ഭക്ഷണത്തിന്നിരിക്കുമ്പോൾ സുഗന്ധം വീശുന്നതു എന്ത്?"},"a":{"en":"My spikenard","ta":"நளததைலம்","ml":"ജടാമാംസി"},"ref":[21,1,12]},{"q":{"en":"What is the beloved to the bride between her breasts?","ta":"நேசர் அவளுக்கு எப்படிப்பட்டவர்?","ml":"പ്രിയൻ അവൾക്കു എന്തുപോലെയാകുന്നു?"},"a":{"en":"A bundle of myrrh","ta":"வெள்ளைப்போளச் செண்டு","ml":"മൂറിൻ കെട്ടുപോലെ"},"ref":[21,1,13]},{"q":{"en":"In which vineyards is the beloved like a cluster of camphire?","ta":"நேசர் எங்கேதி ஊர் எந்தத் தோட்டங்களில் முளைக்கும் பூங்கொத்துபோல்?","ml":"ഏതു മുന്തിരിത്തോട്ടങ്ങളിലെ പൂക്കുലപോലെ പ്രിയൻ ഇരിക്കുന്നു?"},"a":{"en":"The vineyards of En-gedi","ta":"எங்கேதி ஊர் திராட்சத்தோட்டங்கள்","ml":"ഏൻ ഗെദി മുന്തിരിത്തോട്ടങ്ങൾ"},"ref":[21,1,14]},{"q":{"en":"A cluster of what is the beloved compared to?","ta":"நேசர் எதன் பூங்கொத்துக்கு ஒப்பிடப்படுகிறார்?","ml":"പ്രിയനെ ഏതു പൂകൊണ്ടുള്ള കുലയോടു ഉപമിക്കുന്നു?"},"a":{"en":"Camphire","ta":"மருதோன்றி","ml":"മയിലാഞ്ചി"},"ref":[21,1,14]},{"q":{"en":"What kind of eyes does the beloved have?","ta":"நேசியின் கண்கள் எப்படிப்பட்டவை?","ml":"പ്രിയയുടെ കണ്ണു എങ്ങനെയുള്ളതു?"},"a":{"en":"Doves' eyes","ta":"புறாக்கண்கள்","ml":"പ്രാവിന്റെ കണ്ണു"},"ref":[21,1,15]},{"q":{"en":"What did the bride say is green?","ta":"பசுமையானது என்று அவள் எதைச் சொன்னாள்?","ml":"പച്ചയാകുന്നതു എന്തു എന്നു അവൾ പറഞ്ഞു?"},"a":{"en":"Our bed","ta":"நம்முடைய மஞ்சம்","ml":"നമ്മുടെ കിടക്ക"},"ref":[21,1,16]},{"q":{"en":"What are the beams of their house made of?","ta":"அவர்கள் வீட்டின் உத்திரங்கள் எந்த மரம்?","ml":"അവരുടെ വീട്ടിന്റെ ഉത്തരം എന്തു കൊണ്ടുള്ളതു?"},"a":{"en":"Cedar","ta":"கேதுருமரம்","ml":"ദേവദാരു"},"ref":[21,1,17]},{"q":{"en":"What are the rafters of their house made of?","ta":"அவர்கள் வீட்டின் மச்சு எந்த மரம்?","ml":"അവരുടെ വീട്ടിന്റെ കഴുക്കോൽ ഏതു വൃക്ഷം?"},"a":{"en":"Fir","ta":"தேவதாருமரம்","ml":"സരളവൃക്ഷം"},"ref":[21,1,17]},{"q":{"en":"What flower did the bride say she was, of Sharon?","ta":"சாரோனின் எந்தப் புஷ்பம் நான் என்றாள்?","ml":"ശാരോനിലെ ഏതു പുഷ്പം ഞാൻ എന്നു അവൾ പറഞ്ഞു?"},"a":{"en":"The rose","ta":"ரோஜா","ml":"പനിനീർപുഷ്പം"},"ref":[21,2,1]},{"q":{"en":"Which flower of the valleys did the bride say she was?","ta":"பள்ளத்தாக்குகளின் எந்தப் புஷ்பம் நான் என்றாள்?","ml":"താഴ്വരകളിലെ ഏതു പൂവു ഞാൻ എന്നു അവൾ പറഞ്ഞു?"},"a":{"en":"The lily","ta":"லீலிபுஷ்பம்","ml":"താമരപ്പൂവു"},"ref":[21,2,1]},{"q":{"en":"Among what is the lily compared to the beloved?","ta":"லீலிபுஷ்பம் எவைகளுக்குள்ளே இருக்கிறது?","ml":"താമര ഏവയുടെ ഇടയിൽ ഇരിക്കുന്നു?"},"a":{"en":"Thorns","ta":"முள்ளுகளுக்குள்ளே","ml":"മുള്ളുകളുടെ ഇടയിൽ"},"ref":[21,2,2]},{"q":{"en":"What tree among the trees of the wood is the beloved compared to?","ta":"காட்டுமரங்களுக்குள்ளே நேசர் எந்த மரத்துக்கு ஒப்பானவர்?","ml":"കാട്ടുമരങ്ങളുടെ ഇടയിൽ പ്രിയൻ ഏതു മരംപോലെ?"},"a":{"en":"The apple tree","ta":"கிச்சிலிமரம்","ml":"നാരകം"},"ref":[21,2,3]},{"q":{"en":"How was the fruit of the beloved to her taste?","ta":"நேசருடைய கனி அவள் வாய்க்கு எப்படியிருந்தது?","ml":"പ്രിയന്റെ പഴം അവളുടെ രുചിക്കു എങ്ങനെയായിരുന്നു?"},"a":{"en":"Sweet","ta":"மதுரம்","ml":"മധുരം"},"ref":[21,2,3]},{"q":{"en":"Where did the beloved bring the bride?","ta":"நேசர் அவளை எங்கே அழைத்துக்கொண்டுபோனார்?","ml":"പ്രിയൻ അവളെ എവിടേക്കു കൂട്ടിക്കൊണ്ടുചെന്നു?"},"a":{"en":"The banqueting house","ta":"விருந்துசாலைக்கு","ml":"വീഞ്ഞുവീട്ടിലേക്കു"},"ref":[21,2,4]},{"q":{"en":"What was his banner over her?","ta":"அவருடைய கொடி என்ன?","ml":"അവൻ പിടിച്ചിരുന്ന കൊടി എന്തായിരുന്നു?"},"a":{"en":"Love","ta":"நேசம்","ml":"സ്നേഹം"},"ref":[21,2,4]},{"q":{"en":"What did the bride say she was sick of?","ta":"அவள் எதனால் சோகமடைந்திருக்கிறாள்?","ml":"അവൾ എന്തുകൊണ്ടു പരവശയായിരിക്കുന്നു?"},"a":{"en":"Love","ta":"நேசத்தால்","ml":"പ്രേമം"},"ref":[21,2,5]},{"q":{"en":"Where is his left hand?","ta":"அவர் இடதுகை எங்கே இருக்கிறது?","ml":"അവന്റെ ഇടങ്കൈ എവിടെ ഇരിക്കട്ടെ?"},"a":{"en":"Under my head","ta":"என் தலையின்கீழ்","ml":"എന്റെ തലയിൻ കീഴെ"},"ref":[21,2,6]},{"q":{"en":"By which animals did the bride charge the daughters of Jerusalem?","ta":"எருசலேமின் குமாரத்திகளை எவைகள்மேல் ஆணையிடுகிறாள்?","ml":"യെരൂശലേംപുത്രിമാരെ ഏതു മൃഗങ്ങളാണ ഇടുവിക്കുന്നു?"},"a":{"en":"Roes and hinds of the field","ta":"வெளிமான்கள், மரைகள்","ml":"ചെറുമാനുകൾ, പേടമാനുകൾ"},"ref":[21,2,7]},{"q":{"en":"Where does the beloved come leaping?","ta":"நேசர் எவைகள்மேல் குதித்து வருகிறார்?","ml":"പ്രിയൻ എവയിന്മേൽ ചാടി വരുന്നു?"},"a":{"en":"Upon the mountains","ta":"மலைகள்மேல்","ml":"മലകളിന്മേൽ"},"ref":[21,2,8]},{"q":{"en":"To what animal is the beloved like?","ta":"நேசர் எந்த மிருகத்துக்கு ஒப்பாயிருக்கிறார்?","ml":"പ്രിയൻ ഏതു മൃഗത്തിന്നു തുല്യൻ?"},"a":{"en":"A roe or a young hart","ta":"வெளிமானுக்கும் மரைக்குட்டிக்கும்","ml":"ചെറുമാനിന്നും കലകൂട്ടിക്കും"},"ref":[21,2,9]},{"q":{"en":"Where does the beloved stand, looking forth?","ta":"நேசர் எங்கே நின்று பார்க்கிறார்?","ml":"പ്രിയൻ എവിടെ നിന്നു നോക്കുന്നു?"},"a":{"en":"Behind our wall","ta":"எங்கள் மதிலுக்குப்புறம்பே","ml":"നമ്മുടെ മതില്ക്കു പുറമേ"},"ref":[21,2,9]},{"q":{"en":"What did the beloved say to the bride to do?","ta":"நேசர் அவளிடம் என்ன செய்யச் சொன்னார்?","ml":"പ്രിയൻ അവളോടു എന്തു ചെയ്‍വാൻ പറഞ്ഞു?"},"a":{"en":"Rise up and come away","ta":"எழுந்து வா","ml":"എഴുന്നേൽക്ക, വരിക"},"ref":[21,2,10]},{"q":{"en":"What season is past, according to the beloved?","ta":"எந்தக் காலம் சென்றது என்று நேசர் சொன்னார்?","ml":"ഏതു കാലം കഴിഞ്ഞു എന്നു പ്രിയൻ പറഞ്ഞു?"},"a":{"en":"The winter","ta":"மாரிகாலம்","ml":"ശീതകാലം"},"ref":[21,2,11]},{"q":{"en":"Whose voice is heard in our land?","ta":"நம் தேசத்தில் யாருடைய சத்தம் கேட்கப்படுகிறது?","ml":"നമ്മുടെ നാട്ടിൽ ഏതു പക്ഷിയുടെ ശബ്ദം കേൾക്കുന്നു?"},"a":{"en":"The turtle","ta":"காட்டுப்புறா","ml":"കുറുപ്രാവു"},"ref":[21,2,12]},{"q":{"en":"What appear on the earth when spring comes?","ta":"பூமியிலே எவைகள் காணப்படுகின்றன?","ml":"ഭൂമിയിൽ എന്തു കാണായ്‍വരുന്നു?"},"a":{"en":"The flowers","ta":"புஷ்பங்கள்","ml":"പുഷ്പങ്ങൾ"},"ref":[21,2,12]},{"q":{"en":"Which tree puts forth her green figs?","ta":"காய்காய்த்த மரம் எது?","ml":"കായ്കൾ പഴുക്കുന്ന മരം ഏതു?"},"a":{"en":"The fig tree","ta":"அத்திமரம்","ml":"അത്തി"},"ref":[21,2,13]},{"q":{"en":"What give a good smell with the tender grape?","ta":"பூப்பூத்து வாசனை வீசுவது எது?","ml":"സുഗന്ധം വീശുന്നതു ഏതു?"},"a":{"en":"The vines","ta":"திராட்சக்கொடிகள்","ml":"മുന്തിരിവള്ളി"},"ref":[21,2,13]},{"q":{"en":"Where is the dove, according to the beloved?","ta":"புறா எங்கே தங்குகிறது என்று நேசர் சொன்னார்?","ml":"പ്രാവു എവിടെ ഇരിക്കുന്നു എന്നു പ്രിയൻ പറഞ്ഞു?"},"a":{"en":"In the clefts of the rock","ta":"கன்மலையின் வெடிப்புகளிலும்","ml":"പാറയുടെ പിളർപ്പിലും"},"ref":[21,2,14]},{"q":{"en":"What did the beloved want to see and hear?","ta":"நேசர் எதைக் காணவும் கேட்கவும் விரும்பினார்?","ml":"പ്രിയൻ എന്തു കാണ്മാനും കേൾപ്പാനും ആഗ്രഹിച്ചു?"},"a":{"en":"Her countenance and her voice","ta":"முகத்தையும் சத்தத்தையும்","ml":"മുഖവും സ്വരവും"},"ref":[21,2,14]},{"q":{"en":"What did they ask to be taken that spoil the vines?","ta":"திராட்சத்தோட்டங்களைக் கெடுக்கிறவைகளில் எவைகளைப் பிடிக்கச் சொன்னார்கள்?","ml":"മുന്തിരിത്തോട്ടം നശിപ്പിക്കുന്ന ഏതിനെ പിടിക്കാൻ പറഞ്ഞു?"},"a":{"en":"The little foxes","ta":"சிறுநரிகள்","ml":"ചെറുകുറുക്കന്മാർ"},"ref":[21,2,15]},{"q":{"en":"Whose did the bride say her beloved is?","ta":"நேசர் யாருடையவர்?","ml":"പ്രിയൻ ആർക്കുള്ളവൻ?"},"a":{"en":"Mine","ta":"என்னுடையவர்","ml":"എനിക്കുള്ളവൻ"},"ref":[21,2,16]},{"q":{"en":"Among what does the beloved feed?","ta":"நேசர் எவைகளுக்குள்ளே மேய்கிறார்?","ml":"പ്രിയൻ ഏവയുടെ ഇടയിൽ ആടുമേയക്കുന്നു?"},"a":{"en":"The lilies","ta":"லீலி புஷ்பங்களுக்குள்ளே","ml":"താമരകളുടെ ഇടയിൽ"},"ref":[21,2,16]},{"q":{"en":"Upon which mountains should the beloved be like a roe?","ta":"நேசர் எந்த மலைகளில் மானுக்குச் சமானமாயிருக்கவேண்டும்?","ml":"പ്രിയൻ ഏതു പർവ്വതങ്ങളിൽ ചെറുമാനിന്നു തുല്യനായിരിക്കേണം?"},"a":{"en":"The mountains of Bether","ta":"குன்றும் பிளப்புமான கன்மலைகள்","ml":"ദുർഘടപർവ്വതങ്ങൾ"},"ref":[21,2,17]}]