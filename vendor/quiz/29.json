[{"q":{"en":"Whose word came to the prophet Joel?","ta":"யோவேலுக்கு உண்டான வசனம் யாருடையது?","ml":"യോവേലിന്നു ഉണ്ടായ അരുളപ്പാടു ആരുടേതു?"},"a":{"en":"The LORD","ta":"கர்த்தருடைய வசனம்","ml":"യഹോവയുടെ അരുളപ്പാടു"},"ref":[28,1,1]},{"q":{"en":"Whose son was the prophet Joel?","ta":"தீர்க்கதரிசி யோவேல் யாருடைய குமாரன்?","ml":"പ്രവാചകനായ യോവേൽ ആരുടെ മകൻ?"},"a":{"en":"Pethuel","ta":"பெத்துவேலின் குமாரன்","ml":"പെഥൂവേലിന്റെ മകൻ"},"ref":[28,1,1]},{"q":{"en":"Whom did Joel call to hear and give ear?","ta":"யோவேல் யாரைச் செவிகொடுக்கச் சொன்னான்?","ml":"യോവേൽ ആരോടാണു ചെവിക്കൊൾവിൻ എന്നു പറഞ്ഞതു?"},"a":{"en":"Old men and all inhabitants of the land","ta":"முதியோரும் தேசத்தின் சகல குடிகளும்","ml":"മൂപ്പന്മാരും ദേശത്തിലെ സകലനിവാസികളും"},"ref":[28,1,2]},{"q":{"en":"To whom should the people tell about the locust plague?","ta":"இந்தச் செய்தியை யாருக்குத் தெரிவிக்க வேண்டும்?","ml":"ഈ കാര്യം ആരോടു വിവരിച്ചുപറയണം?"},"a":{"en":"Their children","ta":"உங்கள் பிள்ளைகளுக்கு","ml":"നിങ്ങളുടെ മക്കളോടു"},"ref":[28,1,3]},{"q":{"en":"What did the locust eat in Joel's day?","ta":"வெட்டுக்கிளி எதைத் தின்றது?","ml":"വെട്ടുക്കിളി എന്തു തിന്നു?"},"a":{"en":"What the palmerworm had left","ta":"பச்சைப்புழு விட்டதை","ml":"തുള്ളൻ ശേഷിപ്പിച്ചതു"},"ref":[28,1,4]},{"q":{"en":"What did the caterpiller eat in Joel's day?","ta":"முசுக்கட்டைப்பூச்சி எதைத் தின்றது?","ml":"പച്ചപ്പുഴു എന്തു തിന്നു?"},"a":{"en":"What the cankerworm had left","ta":"பச்சைக்கிளி விட்டதை","ml":"വിട്ടിൽ ശേഷിപ്പിച്ചതു"},"ref":[28,1,4]},{"q":{"en":"Whom did Joel tell to awake and weep?","ta":"விழித்து எழுந்து அலறும்படி யோவேல் யாரிடம் சொன்னான்?","ml":"ഉണർന്നു കരയുവിൻ എന്നു യോവേൽ ആരോടു പറഞ്ഞു?"},"a":{"en":"The drunkards","ta":"வெறியர்","ml":"മദ്യപന്മാരേ"},"ref":[28,1,5]},{"q":{"en":"Why were the drinkers of wine told to howl?","ta":"திராட்சரசம் குடிக்கிறவர்கள் ஏன் அலற வேண்டும்?","ml":"വീഞ്ഞു കുടിക്കുന്നവർ എന്തുകൊണ്ട് മുറയിടണം?"},"a":{"en":"The new wine is cut off","ta":"புது திராட்சரசம் விலக்கப்பட்டது","ml":"പുതുവീഞ്ഞു അറ്റുപോയിരിക്കയാൽ"},"ref":[28,1,5]},{"q":{"en":"What came up upon the land, strong and without number?","ta":"எண்ணிமுடியாத பலத்த எது தேசத்தின்மேல் வந்தது?","ml":"സംഖ്യയില്ലാത്തതും ശക്തിയുള്ളതുമായ എന്തു ദേശത്തിന്റെ നേരെ വന്നു?"},"a":{"en":"A nation","ta":"ஒரு ஜாதி","ml":"ഒരു ജാതി"},"ref":[28,1,6]},{"q":{"en":"Whose teeth did the invading nation have?","ta":"படையெடுத்த ஜாதிக்கு யாருடைய பற்கள் உண்டு?","ml":"വന്ന ജാതിക്കു ആരുടെ പല്ലു ഉണ്ടു?"},"a":{"en":"The teeth of a lion","ta":"சிங்கத்தின் பற்கள்","ml":"സിംഹത്തിന്റെ പല്ലു"},"ref":[28,1,6]},{"q":{"en":"What did the invader lay waste?","ta":"அழிக்கப்பட்டது எந்தச் செடி?","ml":"ശൂന്യമാക്കിയതു ഏതു വള്ളിയെ?"},"a":{"en":"My vine","ta":"என் திராட்சச்செடி","ml":"എന്റെ മുന്തിരിവള്ളി"},"ref":[28,1,7]},{"q":{"en":"Which tree did the invader bark and strip bare?","ta":"உரிக்கப்பட்ட மரம் எது?","ml":"തോലുരിച്ചു എറിഞ്ഞുകളഞ്ഞ വൃക്ഷം ഏതു?"},"a":{"en":"My fig tree","ta":"என் அத்திமரம்","ml":"എന്റെ അത്തിവൃക്ഷം"},"ref":[28,1,7]},{"q":{"en":"What colour were the branches of the fig tree made?","ta":"அத்திமரத்தின் கிளைகள் என்ன நிறமாயின?","ml":"അത്തിവൃക്ഷത്തിന്റെ കൊമ്പുകൾ എന്തു നിറമായി?"},"a":{"en":"White","ta":"வெண்மை","ml":"വെളുത്തുപോയി"},"ref":[28,1,7]},{"q":{"en":"What should Judah lament like?","ta":"யூதா எப்படிப் புலம்ப வேண்டும்?","ml":"യെഹൂദാ എങ്ങനെ വിലപിക്കണം?"},"a":{"en":"A virgin girded with sackcloth","ta":"இரட்டுடுத்தியிருக்கிற பெண்ணைப்போல","ml":"രട്ടുടുത്തിരിക്കുന്ന കന്യകയെപ്പോലെ"},"ref":[28,1,8]},{"q":{"en":"For whom does the virgin lament in sackcloth?","ta":"அந்தப் பெண் யாருக்காகப் புலம்புகிறாள்?","ml":"കന്യക ആരെച്ചൊല്ലി വിലപിക്കുന്നു?"},"a":{"en":"The husband of her youth","ta":"தன் பாலியவயதின் புருஷனுக்காக","ml":"യൌവനത്തിലെ ഭർത്താവിനെ"},"ref":[28,1,8]},{"q":{"en":"What was cut off from the house of the LORD?","ta":"கர்த்தருடைய ஆலயத்தை விட்டு அற்றுப்போனது என்ன?","ml":"യഹോവയുടെ ആലയത്തിൽനിന്നു അറ്റുപോയതു എന്തു?"},"a":{"en":"The meat offering and the drink offering","ta":"போஜனபலியும் பானபலியும்","ml":"ഭോജനയാഗവും പാനീയയാഗവും"},"ref":[28,1,9]},{"q":{"en":"Who mourn because the offerings were cut off?","ta":"போஜனபலி அற்றுப்போனதால் துக்கிக்கிறவர்கள் யார்?","ml":"വഴിപാടുകൾ മുടങ്ങിയതിനാൽ ദുഃഖിക്കുന്നവർ ആർ?"},"a":{"en":"The priests, the LORD's ministers","ta":"ஆசாரியர்கள்","ml":"പുരോഹിതന്മാർ"},"ref":[28,1,9]},{"q":{"en":"What mourneth because the corn is wasted?","ta":"விளைச்சல் அழிந்ததால் துக்கங்கொண்டாடுவது எது?","ml":"ധാന്യം നശിച്ചതിനാൽ ദുഃഖിക്കുന്നതു എന്തു?"},"a":{"en":"The land","ta":"பூமி","ml":"ദേശം"},"ref":[28,1,10]},{"q":{"en":"What languisheth in the wasted field, besides the new wine drying up?","ta":"புது திராட்சரசம் வற்றியதோடு எது மாண்டுபோயிற்று?","ml":"പുതുവീഞ്ഞു വറ്റിയതോടൊപ്പം ക്ഷയിച്ചതു എന്തു?"},"a":{"en":"The oil","ta":"எண்ணெய்","ml":"എണ്ണ"},"ref":[28,1,10]},{"q":{"en":"Whom did Joel tell to be ashamed?","ta":"வெட்கப்படும்படி யோவேல் யாரிடம் சொன்னான்?","ml":"ലജ്ജിപ്പിൻ എന്നു യോവേൽ ആരോടു പറഞ്ഞു?"},"a":{"en":"The husbandmen","ta":"பயிரிடுங் குடிகள்","ml":"കൃഷിക്കാരേ"},"ref":[28,1,11]},{"q":{"en":"For which two crops were the vinedressers told to howl?","ta":"திராட்சத்தோட்டக்காரர் எந்த இரண்டு பயிருக்காக அலற வேண்டும்?","ml":"മുന്തിരിത്തോട്ടക്കാർ ഏതു രണ്ടു വിളയെച്ചൊല്ലി മുറയിടണം?"},"a":{"en":"Wheat and barley","ta":"கோதுமையும் வாற்கோதுமையும்","ml":"കോതമ്പും യവവും"},"ref":[28,1,11]},{"q":{"en":"Which fruit trees withered besides the vine and the fig tree?","ta":"திராட்சச்செடி, அத்திமரம் தவிர வாடிப்போன மரங்கள் எவை?","ml":"മുന്തിരിവള്ളിയും അത്തിവൃക്ഷവും കൂടാതെ ഉണങ്ങിയ വൃക്ഷങ്ങൾ ഏതു?"},"a":{"en":"Pomegranate, palm and apple tree","ta":"மாதளை, பேரீச்சம், கிச்சலி","ml":"മാതളം, ഈന്തപ്പന, നാരകം"},"ref":[28,1,12]},{"q":{"en":"What was withered away from the sons of men?","ta":"மனுபுத்திரரைவிட்டு ஒழிந்துபோனது என்ன?","ml":"മനുഷ്യരെ വിട്ടു മാഞ്ഞുപോയതു എന്തു?"},"a":{"en":"Joy","ta":"சந்தோஷம்","ml":"ആനന്ദം"},"ref":[28,1,12]},{"q":{"en":"In what were the priests told to lie all night?","ta":"ஆசாரியர்கள் இராத்தங்க வேண்டியது எதை உடுத்தி?","ml":"പുരോഹിതന്മാർ രാത്രി കഴിച്ചുകൂട്ടേണ്ടതു എന്തുടുത്തു?"},"a":{"en":"Sackcloth","ta":"இரட்டு","ml":"രട്ടു"},"ref":[28,1,13]},{"q":{"en":"What was withholden from the house of their God?","ta":"தேவனுடைய ஆலயத்தில் நிறுத்தப்பட்டது என்ன?","ml":"ദൈവത്തിന്റെ ആലയത്തിൽ മുടങ്ങിപ്പോയതു എന്തു?"},"a":{"en":"The meat offering and the drink offering","ta":"போஜனபலியும் பானபலியும்","ml":"ഭോജനയാഗവും പാനീയയാഗവും"},"ref":[28,1,13]},{"q":{"en":"What did Joel tell them to sanctify?","ta":"எதை நியமிக்கும்படி யோவேல் சொன்னான்?","ml":"യോവേൽ എന്തു നിയമിക്കാൻ പറഞ്ഞു?"},"a":{"en":"A fast","ta":"பரிசுத்த உபவாசநாள்","ml":"ഒരു ഉപവാസദിവസം"},"ref":[28,1,14]},{"q":{"en":"Where were the elders and inhabitants to be gathered?","ta":"மூப்பரும் குடிகளும் எங்கே கூடிவர வேண்டும்?","ml":"മൂപ്പന്മാരും നിവാസികളും എവിടെ കൂടിവരണം?"},"a":{"en":"Into the house of the LORD your God","ta":"கர்த்தரின் ஆலயத்திலே","ml":"യഹോവയുടെ ആലയത്തിൽ"},"ref":[28,1,14]},{"q":{"en":"What is at hand, like a destruction from the Almighty?","ta":"சர்வவல்லவரிடத்திலிருந்து சங்காரம்போல வருவது எது?","ml":"സർവ്വശക്തന്റെ പക്കൽനിന്നു സംഹാരം പോലെ വരുന്നതു ഏതു?"},"a":{"en":"The day of the LORD","ta":"கர்த்தருடைய நாள்","ml":"യഹോവയുടെ ദിവസം"},"ref":[28,1,15]},{"q":{"en":"What was cut off before the eyes of the people?","ta":"நம் கண்களைவிட்டு நீக்கப்பட்டது என்ன?","ml":"കണ്ണിന്റെ മുമ്പിൽനിന്നു അറ്റുപോയതു എന്തു?"},"a":{"en":"The meat (food)","ta":"ஆகாரம்","ml":"ആഹാരം"},"ref":[28,1,16]},{"q":{"en":"What is rotten under their clods?","ta":"மண்கட்டிகளின்கீழ் மக்கிப்போனது என்ன?","ml":"കട്ടകളുടെ കീഴിൽ കെട്ടുപോകുന്നതു എന്തു?"},"a":{"en":"The seed","ta":"விதை","ml":"വിത്തു"},"ref":[28,1,17]},{"q":{"en":"Why were the herds of cattle perplexed?","ta":"மாட்டுமந்தைகள் ஏன் கலங்குகின்றன?","ml":"കന്നുകാലികൾ എന്തുകൊണ്ട് ബുദ്ധിമുട്ടുന്നു?"},"a":{"en":"They have no pasture","ta":"அவைகளுக்கு மேய்ச்சல் இல்லை","ml":"മേച്ചൽ ഇല്ലായ്കകൊണ്ടു"},"ref":[28,1,18]},{"q":{"en":"To whom did Joel cry because fire devoured the pastures?","ta":"அக்கினி மேய்ச்சல்களைப் பட்சித்ததால் யோவேல் யாரை நோக்கிக் கூப்பிட்டான்?","ml":"തീ പുല്പുറങ്ങളെ തിന്നതിനാൽ യോവേൽ ആരോടു നിലവിളിച്ചു?"},"a":{"en":"The LORD","ta":"கர்த்தர்","ml":"യഹോവ"},"ref":[28,1,19]},{"q":{"en":"What did the fire devour in the wilderness?","ta":"வனாந்தரத்தில் அக்கினி பட்சித்தது எதை?","ml":"മരുഭൂമിയിൽ തീ ഇരയാക്കിയതു എന്തിനെ?"},"a":{"en":"The pastures","ta":"மேய்ச்சல்கள்","ml":"പുല്പുറങ്ങൾ"},"ref":[28,1,19]},{"q":{"en":"Who cry unto the LORD because the rivers of waters are dried up?","ta":"நதிகள் வற்றியதால் கர்த்தரை நோக்கிக் கதறுபவை எவை?","ml":"തോടുകൾ വറ്റിയതിനാൽ യഹോവയെ നോക്കുന്നവർ ആർ?"},"a":{"en":"The beasts of the field","ta":"வெளியின் மிருகங்கள்","ml":"വയലിലെ മൃഗങ്ങൾ"},"ref":[28,1,20]},{"q":{"en":"What instrument should be blown in Zion?","ta":"சீயோனில் எதை ஊத வேண்டும்?","ml":"സീയോനിൽ എന്തു ഊതണം?"},"a":{"en":"The trumpet","ta":"எக்காளம்","ml":"കാഹളം"},"ref":[28,2,1]},{"q":{"en":"In which mountain should an alarm be sounded?","ta":"எச்சரிப்பின் சத்தம் எந்தப் பர்வதத்தில் இடப்பட வேண்டும்?","ml":"അയ്യംവിളി എവിടെ വേണം?"},"a":{"en":"My holy mountain","ta":"என் பரிசுத்த பர்வதம்","ml":"എന്റെ വിശുദ്ധപർവ്വതത്തിൽ"},"ref":[28,2,1]},{"q":{"en":"Why should the inhabitants of the land tremble?","ta":"தேசத்தின் குடிகள் ஏன் தத்தளிக்க வேண்டும்?","ml":"ദേശനിവാസികൾ എന്തുകൊണ്ട് നടുങ്ങണം?"},"a":{"en":"The day of the LORD cometh","ta":"கர்த்தருடைய நாள் வருகிறது","ml":"യഹോവയുടെ ദിവസം വരുന്നതുകൊണ്ടു"},"ref":[28,2,1]},{"q":{"en":"What kind of day is the day of the LORD described as?","ta":"கர்த்தருடைய நாள் எப்படிப்பட்ட நாள்?","ml":"യഹോവയുടെ ദിവസം എങ്ങനെയുള്ള ദിവസം?"},"a":{"en":"A day of darkness and gloominess","ta":"இருளும் அந்தகாரமுமான நாள்","ml":"ഇരുട്ടും അന്ധകാരവുമുള്ളോരു ദിവസം"},"ref":[28,2,2]},{"q":{"en":"Spread upon the mountains like what is the great and strong people?","ta":"பர்வதங்களின்மேல் பரவுகிறதுபோல் என்ன பரவும்?","ml":"പർവ്വതങ്ങളിൽ പരന്നിരിക്കുന്നതു പോലെ എന്തു?"},"a":{"en":"The morning","ta":"விடியற்கால வெளுப்பு","ml":"പ്രഭാതം"},"ref":[28,2,2]},{"q":{"en":"What devoureth before the invaders?","ta":"அவைகளுக்கு முன்னாகப் பட்சிப்பது எது?","ml":"അവരുടെ മുമ്പിൽ കത്തുന്നതു എന്തു?"},"a":{"en":"A fire","ta":"அக்கினி","ml":"തീ"},"ref":[28,2,3]},{"q":{"en":"The land before them is like which garden?","ta":"அவைகளுக்கு முன்னாக தேசம் எந்தத் தோட்டத்தைப்போல இருக்கும்?","ml":"അവരുടെ മുമ്പിൽ ദേശം ഏതു തോട്ടംപോലെ ആകുന്നു?"},"a":{"en":"The garden of Eden","ta":"ஏதேன் தோட்டம்","ml":"ഏദെൻ തോട്ടം"},"ref":[28,2,3]},{"q":{"en":"What is the land behind the invaders like?","ta":"அவைகளுக்குப் பின்னாக தேசம் எப்படி இருக்கும்?","ml":"അവരുടെ പിറകിൽ ദേശം എങ്ങനെയാകും?"},"a":{"en":"A desolate wilderness","ta":"பாழான வனாந்தரம்","ml":"ശൂന്യമായുള്ള മരുഭൂമി"},"ref":[28,2,3]},{"q":{"en":"The appearance of the invaders is as the appearance of what?","ta":"படையின் சாயல் எவற்றின் சாயலை ஒத்தது?","ml":"അവരുടെ രൂപം എന്തിന്റെ രൂപംപോലെ?"},"a":{"en":"Horses","ta":"குதிரைகள்","ml":"കുതിരകൾ"},"ref":[28,2,4]},{"q":{"en":"They leap like the noise of what on the tops of mountains?","ta":"பர்வதங்களின் சிகரங்களில் எவற்றின் இரைச்சல்போல் குதிக்கும்?","ml":"പർവ്വതശിഖരങ്ങളിൽ എന്തിന്റെ മുഴക്കംപോലെ അവർ കുതിക്കുന്നു?"},"a":{"en":"Chariots","ta":"இரதங்கள்","ml":"രഥങ്ങൾ"},"ref":[28,2,5]},{"q":{"en":"What devours the stubble with a noise like the invaders?","ta":"செத்தைகளை எரிக்கிறது எது?","ml":"താളടിയെ ദഹിപ്പിക്കുന്നതു എന്തു?"},"a":{"en":"A flame of fire","ta":"அக்கினிஜுவாலை","ml":"അഗ്നിജ്വാല"},"ref":[28,2,5]},{"q":{"en":"What shall all faces gather before the invaders?","ta":"எல்லா முகங்களும் எப்படியாகும்?","ml":"സകലമുഖങ്ങളും എങ്ങനെയാകും?"},"a":{"en":"Blackness","ta":"கருகிப்போகும்","ml":"വിളറിപ്പോകും"},"ref":[28,2,6]},{"q":{"en":"Like whom do the invaders run and climb the wall?","ta":"அவைகள் யாரைப்போல ஓடி மதிலேறும்?","ml":"അവർ ആരെപ്പോലെ ഓടി മതിൽ കയറുന്നു?"},"a":{"en":"Mighty men and men of war","ta":"பராக்கிரமசாலிகளும் யுத்தவீரரும்","ml":"വീരന്മാരും യോദ്ധാക്കളും"},"ref":[28,2,7]},{"q":{"en":"What shall the invaders not break as they march?","ta":"அவைகள் செல்லும்போது எதைப் பிசகாது?","ml":"അവർ നടക്കുമ്പോൾ എന്തു വിട്ടുമാറുകയില്ല?"},"a":{"en":"Their ranks","ta":"வரிசைகள்","ml":"പാത"},"ref":[28,2,7]},{"q":{"en":"What happens when they fall upon the sword?","ta":"ஆயுதங்களுக்குள் விழுந்தாலும் அவைகளுக்கு என்ன நேரும்?","ml":"ആയുധങ്ങളുടെ ഇടയിൽകൂടി ചാടുമ്പോൾ അവർക്കു എന്തു സംഭവിക്കും?"},"a":{"en":"They shall not be wounded","ta":"காயம்படாமற்போகும்","ml":"മുറിവേൽക്കാതിരിക്കും"},"ref":[28,2,8]},{"q":{"en":"Like whom do the invaders enter in at the windows?","ta":"பலகணிவழியாய் உள்ளே நுழைவது யாரைப்போல?","ml":"കിളിവാതിലുകളിൽകൂടി കടക്കുന്നതു ആരെപ്പോലെ?"},"a":{"en":"A thief","ta":"திருடன்","ml":"കള്ളൻ"},"ref":[28,2,9]},{"q":{"en":"Which heavenly bodies shall be dark before the invaders?","ta":"இருண்டுபோகும் வானத்தின் ஒளிகள் எவை?","ml":"ഇരുണ്ടുപോകുന്നവ ഏതൊക്കെ?"},"a":{"en":"The sun and the moon","ta":"சூரியனும் சந்திரனும்","ml":"സൂര്യനും ചന്ദ്രനും"},"ref":[28,2,10]},{"q":{"en":"What shall the earth do before them?","ta":"அவைகளுக்கு முன்பாகப் பூமி என்ன செய்யும்?","ml":"അവരുടെ മുമ്പിൽ ഭൂമി എന്തു ചെയ്യും?"},"a":{"en":"Quake","ta":"அதிரும்","ml":"കുലുങ്ങും"},"ref":[28,2,10]},{"q":{"en":"Before whose army shall the LORD utter his voice?","ta":"கர்த்தர் யாருடைய சேனைக்குமுன் சத்தமிடுவார்?","ml":"യഹോവ ആരുടെ സൈന്യത്തിൻ മുമ്പിൽ നാദം കേൾപ്പിക്കുന്നു?"},"a":{"en":"His army","ta":"தமது சேனை","ml":"തന്റെ സൈന്യം"},"ref":[28,2,11]},{"q":{"en":"How is the day of the LORD described?","ta":"கர்த்தருடைய நாள் எப்படிப்பட்டது?","ml":"യഹോവയുടെ ദിവസം എങ്ങനെയുള്ളതു?"},"a":{"en":"Great and very terrible","ta":"பெரிதும் மகா பயங்கரமுமானது","ml":"വലുതും അതിഭയങ്കരവും"},"ref":[28,2,11]},{"q":{"en":"With what four things did the LORD say to turn to Him?","ta":"கர்த்தரிடம் திரும்ப எவற்றோடு வர வேண்டும்?","ml":"യഹോവയിലേക്കു എന്തോടുകൂടെ തിരിയണം?"},"a":{"en":"All your heart, fasting, weeping, mourning","ta":"உபவாசம், அழுகை, புலம்பல்","ml":"ഉപവാസം, കരച്ചൽ, വിലാപം"},"ref":[28,2,12]},{"q":{"en":"With how much of your heart should you turn to the LORD?","ta":"கர்த்தரிடம் எவ்வளவு இருதயத்தோடு திரும்ப வேண்டும்?","ml":"യഹോവയിലേക്കു ഹൃദയത്തിൽ എത്രയോടെ തിരിയണം?"},"a":{"en":"All your heart","ta":"முழு இருதயம்","ml":"പൂർണ്ണഹൃദയം"},"ref":[28,2,12]},{"q":{"en":"What should you rend, and not your garments?","ta":"வஸ்திரங்களையல்ல, எதைக் கிழிக்க வேண்டும்?","ml":"വിസ്ത്രങ്ങളെയല്ല, എന്തു കീറണം?"},"a":{"en":"Your heart","ta":"இருதயங்கள்","ml":"ഹൃദയങ്ങൾ"},"ref":[28,2,13]},{"q":{"en":"How is the LORD described: slow to what?","ta":"கர்த்தர் எதில் நீடிய சாந்தமுள்ளவர்?","ml":"യഹോവ എന്തിൽ ദീർഘക്ഷമയുള്ളവൻ?"},"a":{"en":"Slow to anger","ta":"நீடிய சாந்தம்","ml":"ദീർഘക്ഷമ"},"ref":[28,2,13]},{"q":{"en":"The LORD is gracious and what else, according to Joel?","ta":"கர்த்தர் மனஉருக்கமும் வேறு என்ன குணமும் உள்ளவர்?","ml":"യഹോവ കൃപയും വേറെ എന്തുമുള്ളവൻ?"},"a":{"en":"Merciful","ta":"இரக்கம்","ml":"കരുണ"},"ref":[28,2,13]},{"q":{"en":"What offerings might the LORD leave behind as a blessing?","ta":"கர்த்தர் ஆசீர்வாதமாக எந்தப் பலிகளைத் தரலாம்?","ml":"യഹോവ അനുഗ്രഹമായി എന്തു വെച്ചേക്കാം?"},"a":{"en":"A meat offering and a drink offering","ta":"போஜனபலிகளும் பானபலிகளும்","ml":"ഭോജനയാഗവും പാനീയയാഗവും"},"ref":[28,2,14]},{"q":{"en":"What was to be called besides sanctifying a fast?","ta":"உபவாசத்தோடு எதைக் கூற வேண்டும்?","ml":"ഉപവാസം കൂടാതെ എന്തു വിളിക്കണം?"},"a":{"en":"A solemn assembly","ta":"விசேஷித்த ஆசரிப்பு","ml":"സഭായോഗം"},"ref":[28,2,15]},{"q":{"en":"Besides the people, whom else should be gathered?","ta":"ஜனத்தைத் தவிர யாரைக் கூட்ட வேண்டும்?","ml":"ജനത്തെ കൂടാതെ ആരെ കൂട്ടണം?"},"a":{"en":"Elders, children and sucklings","ta":"முதியோர், பிள்ளைகள், பாலுண்கிற குழந்தைகள்","ml":"മൂപ്പന്മാർ, പൈതങ്ങൾ, മുലകുടിക്കുന്നവർ"},"ref":[28,2,16]},{"q":{"en":"Who should go forth from his chamber?","ta":"தன் அறையைவிட்டுப் புறப்பட வேண்டியவன் யார்?","ml":"മണവറ വിട്ടു പുറത്തു വരേണ്ടവൻ ആർ?"},"a":{"en":"The bridegroom","ta":"மணவாளன்","ml":"മണവാളൻ"},"ref":[28,2,16]},{"q":{"en":"Who should come out of her closet?","ta":"தன் மறைவைவிட்டுப் புறப்பட வேண்டியவள் யார்?","ml":"ഉള്ളറ വിട്ടു പുറത്തു വരേണ്ടവൾ ആർ?"},"a":{"en":"The bride","ta":"மணவாட்டி","ml":"മണവാട്ടി"},"ref":[28,2,16]},{"q":{"en":"Who should weep between the porch and the altar?","ta":"மண்டபத்துக்கும் பலிபீடத்துக்கும் நடுவே அழ வேண்டியவர்கள் யார்?","ml":"പൂമുഖത്തിന്റെയും യാഗപീഠത്തിന്റെയും മദ്ധ്യേ കരയേണ്ടവർ ആർ?"},"a":{"en":"The priests, the ministers of the LORD","ta":"ஆசாரியர்கள்","ml":"പുരോഹിതന്മാർ"},"ref":[28,2,17]},{"q":{"en":"What question might the heathen ask that the priests pray against?","ta":"புறஜாதிகள் என்ன சொல்லக்கூடாது என்று ஜெபிக்க வேண்டும்?","ml":"ജാതികൾ ഇടയിൽ പറയരുതെന്നു പ്രാർത്ഥിക്കേണ്ട ചോദ്യം എന്തു?"},"a":{"en":"Where is their God?","ta":"உங்கள் தேவன் எங்கே","ml":"അവരുടെ ദൈവം എവിടെ"},"ref":[28,2,17]},{"q":{"en":"For what will the LORD be jealous and pity his people?","ta":"கர்த்தர் எதற்காக வைராக்கியங்கொள்வார்?","ml":"യഹോവ എന്തിനുവേണ്ടി തീക്ഷ്ണത കാണിക്കും?"},"a":{"en":"His land","ta":"தமது தேசம்","ml":"തന്റെ ദേശത്തിന്നു"},"ref":[28,2,18]},{"q":{"en":"What three things will the LORD send to satisfy his people?","ta":"கர்த்தர் தமது ஜனத்துக்கு எவற்றைக் கொடுப்பார்?","ml":"യഹോവ തന്റെ ജനത്തിനു എന്തെല്ലാം നല്കും?"},"a":{"en":"Corn, wine and oil","ta":"தானியம், திராட்சரசம், எண்ணெய்","ml":"ധാന്യം, വീഞ്ഞ്, എണ്ണ"},"ref":[28,2,19]},{"q":{"en":"Among whom will the LORD no more make his people a reproach?","ta":"கர்த்தர் தமது ஜனத்தை யாருக்குள்ளே இனி நிந்தையாக வைக்கமாட்டார்?","ml":"യഹോവ തന്റെ ജനത്തെ ആരുടെ ഇടയിൽ ഇനി നിന്ദയാക്കുകയില്ല?"},"a":{"en":"The heathen","ta":"புறஜாதிகள்","ml":"ജാതികൾ"},"ref":[28,2,19]},{"q":{"en":"Which army will the LORD remove far off?","ta":"கர்த்தர் தூரமாக விலக்குவது எந்தச் சேனையை?","ml":"യഹോവ ദൂരത്താക്കുന്നതു ആരെ?"},"a":{"en":"The northern army","ta":"வடதிசைச்சேனை","ml":"വടക്കുനിന്നുള്ള ശത്രു"},"ref":[28,2,20]},{"q":{"en":"Who is told to fear not, be glad and rejoice?","ta":"பயப்படாதே என்று யாருக்குச் சொல்லப்பட்டது?","ml":"ഭയപ്പെടേണ്ടാ എന്നു ആരോടു പറഞ്ഞു?"},"a":{"en":"O land","ta":"தேசமே","ml":"ദേശമേ"},"ref":[28,2,21]},{"q":{"en":"What will the LORD do?","ta":"கர்த்தர் என்ன செய்வார்?","ml":"യഹോവ എന്തു ചെയ്യും?"},"a":{"en":"Great things","ta":"பெரிய காரியங்கள்","ml":"വൻകാര്യങ്ങൾ"},"ref":[28,2,21]},{"q":{"en":"Which creatures are told not to be afraid because the pastures spring?","ta":"பயப்படாதேயுங்கள் என்று யாருக்குச் சொல்லப்பட்டது?","ml":"ഭയപ്പെടേണ്ടാ എന്നു ആരോടു പറഞ്ഞു?"},"a":{"en":"The beasts of the field","ta":"வெளியின் மிருகங்கள்","ml":"വയലിലേ മൃഗങ്ങളേ"},"ref":[28,2,22]},{"q":{"en":"Which two plants yield their strength?","ta":"பலனைத்தருபவை எவை?","ml":"അനുഭവപുഷ്ടി നല്കുന്നവ ഏതു?"},"a":{"en":"The fig tree and the vine","ta":"அத்திமரமும் திராட்சச்செடியும்","ml":"അത്തിവൃക്ഷവും മുന്തിരിവള്ളിയും"},"ref":[28,2,22]},{"q":{"en":"Who are told to be glad and rejoice in the LORD their God?","ta":"கர்த்தருக்குள் மகிழ்ந்து களிகூர வேண்டியவர்கள் யார்?","ml":"യഹോവയിൽ സന്തോഷിക്കേണ്ടവർ ആർ?"},"a":{"en":"The children of Zion","ta":"சீயோன் குமாரர்","ml":"സീയോൻ മക്കൾ"},"ref":[28,2,23]},{"q":{"en":"Which two rains will the LORD cause to come down?","ta":"கர்த்தர் வருஷிக்கப்பண்ணும் இரண்டு மாரிகள் எவை?","ml":"യഹോവ പെയ്യിക്കുന്ന രണ്ടു മഴ ഏതു?"},"a":{"en":"The former rain and the latter rain","ta":"முன்மாரியும் பின்மாரியும்","ml":"മുൻമഴയും പിൻമഴയും"},"ref":[28,2,23]},{"q":{"en":"What shall the floors be full of?","ta":"களங்கள் எதினால் நிறையும்?","ml":"കളപ്പുരകൾ എന്തുകൊണ്ടു നിറയും?"},"a":{"en":"Wheat","ta":"தானியம்","ml":"ധാന്യം"},"ref":[28,2,24]},{"q":{"en":"What shall the vats overflow with?","ta":"ஆலைகளில் என்ன வழிந்தோடும்?","ml":"ചക്കുകൾ എന്തുകൊണ്ടു കവിയും?"},"a":{"en":"Wine and oil","ta":"திராட்சரசமும் எண்ணெயும்","ml":"വീഞ്ഞും എണ്ണയും"},"ref":[28,2,24]},{"q":{"en":"What will the LORD restore to the people?","ta":"கர்த்தர் திரும்ப அளிப்பதாகச் சொன்னது என்ன?","ml":"യഹോവ പകരം നല്കുമെന്നു പറഞ്ഞതു എന്തിനു?"},"a":{"en":"The years that the locust hath eaten","ta":"பட்சித்த வருஷங்களின் விளைவு","ml":"തിന്നുകളഞ്ഞ സംവത്സരങ്ങൾ"},"ref":[28,2,25]},{"q":{"en":"What did the LORD call the locust, cankerworm, caterpiller and palmerworm?","ta":"வெட்டுக்கிளி முதலியவற்றை கர்த்தர் என்ன என்றார்?","ml":"വെട്ടുക്കിളി മുതലായവയെ യഹോവ എന്തെന്നു വിളിച്ചു?"},"a":{"en":"My great army","ta":"என் பெரிய சேனை","ml":"എന്റെ മഹാസൈന്യം"},"ref":[28,2,25]},{"q":{"en":"Whose name shall the people praise after being satisfied?","ta":"திருப்தியடைந்தபின் யாருடைய நாமத்தைத் துதிப்பார்கள்?","ml":"തൃപ്തരായ ശേഷം ആരുടെ നാമത്തെ സ്തുതിക്കും?"},"a":{"en":"The LORD your God","ta":"உங்கள் தேவனாகிய கர்த்தர்","ml":"നിങ്ങളുടെ ദൈവമായ യഹോവ"},"ref":[28,2,26]},{"q":{"en":"What shall God's people never be?","ta":"கர்த்தருடைய ஜனங்கள் ஒருபோதும் எப்படி ஆவதில்லை?","ml":"യഹോവയുടെ ജനം ഒരുനാളും എന്താകയില്ല?"},"a":{"en":"Ashamed","ta":"வெட்கப்பட்டுப்போவதில்லை","ml":"ലജ്ജിച്ചുപോകയില്ല"},"ref":[28,2,26]},{"q":{"en":"In the midst of whom is the LORD?","ta":"கர்த்தர் யாருடைய நடுவில் இருக்கிறார்?","ml":"യഹോവ ആരുടെ നടുവിൽ ഉണ്ടു?"},"a":{"en":"Israel","ta":"இஸ்ரவேல்","ml":"യിസ്രായേൽ"},"ref":[28,2,27]},{"q":{"en":"What will the LORD pour out upon all flesh?","ta":"கர்த்தர் மாம்சமான யாவர்மேலும் எதை ஊற்றுவார்?","ml":"യഹോവ സകലജഡത്തിന്മേലും എന്തു പകരും?"},"a":{"en":"My spirit","ta":"என் ஆவி","ml":"എന്റെ ആത്മാവു"},"ref":[28,2,28]},{"q":{"en":"Who shall prophesy when the spirit is poured out?","ta":"ஆவி ஊற்றப்படும்போது தீர்க்கதரிசனஞ் சொல்பவர்கள் யார்?","ml":"ആത്മാവു പകരുമ്പോൾ പ്രവചിക്കുന്നവർ ആർ?"},"a":{"en":"Your sons and your daughters","ta":"குமாரரும் குமாரத்திகளும்","ml":"പുത്രന്മാരും പുത്രിമാരും"},"ref":[28,2,28]},{"q":{"en":"What shall the old men dream?","ta":"மூப்பர் எதைக் காண்பார்கள்?","ml":"വൃദ്ധന്മാർ എന്തു കാണും?"},"a":{"en":"Dreams","ta":"சொப்பனங்கள்","ml":"സ്വപ്നങ്ങൾ"},"ref":[28,2,28]},{"q":{"en":"What shall the young men see?","ta":"வாலிபர் எதைக் காண்பார்கள்?","ml":"യൌവനക്കാർ എന്തു ദർശിക്കും?"},"a":{"en":"Visions","ta":"தரிசனங்கள்","ml":"ദർശനങ്ങൾ"},"ref":[28,2,28]},{"q":{"en":"Upon whom else will the LORD pour his spirit in those days?","ta":"அந்நாட்களில் ஆவி ஊற்றப்படும் வேறு யார்மேல்?","ml":"ആ നാളുകളിൽ ആത്മാവു പകരുന്ന വേറെ ആരുടെമേൽ?"},"a":{"en":"The servants and the handmaids","ta":"ஊழியக்காரரும் ஊழியக்காரிகளும்","ml":"ദാസന്മാരും ദാസിമാരും"},"ref":[28,2,29]},{"q":{"en":"Where will the LORD shew wonders?","ta":"கர்த்தர் அதிசயங்களை எங்கே காட்டுவார்?","ml":"യഹോവ അത്ഭുതങ്ങളെ എവിടെ കാണിക്കും?"},"a":{"en":"In the heavens and in the earth","ta":"வானத்திலும் பூமியிலும்","ml":"ആകാശത്തിലും ഭൂമിയിലും"},"ref":[28,2,30]},{"q":{"en":"What wonders will be shown in the heavens and earth?","ta":"என்ன அதிசயங்கள் காட்டப்படும்?","ml":"എന്തെല്ലാം അത്ഭുതങ്ങൾ കാണിക്കും?"},"a":{"en":"Blood, and fire, and pillars of smoke","ta":"இரத்தம், அக்கினி, புகைஸ்தம்பங்கள்","ml":"രക്തവും തീയും പുകത്തൂണും"},"ref":[28,2,30]},{"q":{"en":"Into what shall the sun be turned?","ta":"சூரியன் எவ்வாறு மாறும்?","ml":"സൂര്യൻ എങ്ങനെ മാറും?"},"a":{"en":"Darkness","ta":"இருள்","ml":"ഇരുൾ"},"ref":[28,2,31]},{"q":{"en":"Into what shall the moon be turned?","ta":"சந்திரன் எவ்வாறு மாறும்?","ml":"ചന്ദ്രൻ എങ്ങനെ മാറും?"},"a":{"en":"Blood","ta":"இரத்தம்","ml":"രക്തം"},"ref":[28,2,31]},{"q":{"en":"Who shall be delivered?","ta":"யார் இரட்சிக்கப்படுவான்?","ml":"ആർ രക്ഷിക്കപ്പെടും?"},"a":{"en":"Whosoever calls on the name of the LORD","ta":"கர்த்தருடைய நாமத்தைத் தொழுதுகொள்ளுகிறவன்","ml":"യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിക്കുന്നവൻ"},"ref":[28,2,32]},{"q":{"en":"Where shall deliverance be found, as the LORD hath said?","ta":"கர்த்தர் சொன்னபடி இரட்சிப்பு எங்கே உண்டாயிருக்கும்?","ml":"യഹോവ അരുളിച്ചെയ്തതുപോലെ രക്ഷ എവിടെ ഉണ്ടാകും?"},"a":{"en":"Mount Zion and Jerusalem","ta":"சீயோன் பர்வதத்திலும் எருசலேமிலும்","ml":"സിയോൻ പർവ്വതത്തിലും യെരൂശലേമിലും"},"ref":[28,2,32]},{"q":{"en":"Whose captivity will the LORD bring again?","ta":"கர்த்தர் யாருடைய சிறையிருப்பைத் திருப்புவார்?","ml":"യഹോവ ആരുടെ സ്ഥിതി മാറ്റും?"},"a":{"en":"Judah and Jerusalem","ta":"யூதா, எருசலேம்","ml":"യെഹൂദയും യെരൂശലേമും"},"ref":[28,3,1]},{"q":{"en":"Whom will the LORD gather together?","ta":"கர்த்தர் யாரைக் கூட்டுவார்?","ml":"യഹോവ ആരെ കൂട്ടും?"},"a":{"en":"All nations","ta":"சகல ஜாதியார்","ml":"സകലജാതികൾ"},"ref":[28,3,2]},{"q":{"en":"Into which valley will the LORD bring all nations down?","ta":"கர்த்தர் ஜாதிகளை எந்தப் பள்ளத்தாக்கில் இறங்கப்பண்ணுவார்?","ml":"യഹോവ ജാതികളെ ഏതു താഴ്വരയിൽ ചെല്ലുമാറാക്കും?"},"a":{"en":"The valley of Jehoshaphat","ta":"யோசபாத்தின் பள்ளத்தாக்கு","ml":"യഹോശാഫാത്ത് താഴ്വര"},"ref":[28,3,2]},{"q":{"en":"Why will the LORD plead with the nations?","ta":"கர்த்தர் ஜாதிகளோடு ஏன் வழக்காடுவார்?","ml":"യഹോവ ജാതികളോടു എന്തുകൊണ്ടു വ്യവഹരിക്കും?"},"a":{"en":"They scattered Israel and parted his land","ta":"என் தேசத்தைப் பங்கிட்டுக்கொண்டதினிமித்தம்","ml":"എന്റെ ദേശത്തെ വിഭാഗിച്ചതുകൊണ്ടു"},"ref":[28,3,2]},{"q":{"en":"What did the nations cast for the LORD's people?","ta":"கர்த்தருடைய ஜனத்தின்பேரில் அவர்கள் எதைப் போட்டார்கள்?","ml":"യഹോവയുടെ ജനത്തിന്നു അവർ എന്തിട്ടു?"},"a":{"en":"Lots","ta":"சீட்டு","ml":"ചീട്ടു"},"ref":[28,3,3]},{"q":{"en":"What did they give a boy for?","ta":"ஆண்குழந்தையை எதற்காகக் கொடுத்தார்கள்?","ml":"ഒരു ബാലനെ ആർക്കുവേണ്ടി കൊടുത്തു?"},"a":{"en":"An harlot","ta":"வேசிப்பணையம்","ml":"ഒരു വേശ്യ"},"ref":[28,3,3]},{"q":{"en":"What did they sell a girl for, that they might drink?","ta":"பெண்குழந்தையை எதற்குக் கிரையமாகக் கொடுத்தார்கள்?","ml":"ഒരു ബാലയെ വിറ്റു എന്തു കുടിച്ചു?"},"a":{"en":"Wine","ta":"திராட்சரசம்","ml":"വീഞ്ഞു"},"ref":[28,3,3]},{"q":{"en":"Which cities and coasts did the LORD ask what they had to do with him?","ta":"கர்த்தர் \"உங்களுக்கும் எனக்கும் என்ன\" என்று யாரிடம் கேட்டார்?","ml":"\"നിങ്ങൾക്കു എന്നോടു എന്തു കാര്യം\" എന്നു യഹോവ ആരോടു ചോദിച്ചു?"},"a":{"en":"Tyre, Zidon and all the coasts of Palestine","ta":"தீரு, சீதோன், பெலிஸ்தியாவின் எல்லைகள்","ml":"സോർ, സീദോൻ, ഫെലിസ്ത്യപ്രദേശങ്ങൾ"},"ref":[28,3,4]},{"q":{"en":"Upon whose head will the LORD return their recompence?","ta":"கர்த்தர் சரிக்கட்டுகிறதை யாருடைய தலையின்மேல் திரும்பச்செய்வார்?","ml":"യഹോവ പ്രവൃത്തി ആരുടെ തലമേൽ വരുത്തും?"},"a":{"en":"Their own head","ta":"உங்கள் தலையின்மேல்","ml":"നിങ്ങളുടെ തലമേൽ"},"ref":[28,3,4]},{"q":{"en":"What did Tyre and Zidon take from the LORD?","ta":"தீருவும் சீதோனும் கர்த்தருடையதில் எவற்றை எடுத்தார்கள்?","ml":"സോരും സീദോനും യഹോവയുടേതിൽ എന്തെടുത്തു?"},"a":{"en":"My silver and my gold","ta":"வெள்ளியும் பொன்னும்","ml":"വെള്ളിയും പൊന്