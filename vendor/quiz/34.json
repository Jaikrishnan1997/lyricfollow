[{"q":{"en":"Whose burden is described at the beginning of the book of Nahum?","ta":"நாகூமின் புஸ்தகத்தின் தொடக்கத்தில் எந்த நகரத்தின் பாரம் சொல்லப்படுகிறது?","ml":"നഹൂമിന്റെ പുസ്തകത്തിന്റെ തുടക്കത്തിൽ ഏതു നഗരത്തെക്കുറിച്ചുള്ള പ്രവാചകം പറയുന്നു?"},"a":{"en":"Nineveh","ta":"நினிவே","ml":"നീനെവേ"},"ref":[33,1,1]},{"q":{"en":"Who saw the vision recorded in this book?","ta":"இந்தப் புஸ்தகத்தில் எழுதப்பட்ட தரிசனத்தைக் கண்டவர் யார்?","ml":"ഈ പുസ്തകത്തിലെ ദർശനം കണ്ടതാർ?"},"a":{"en":"Nahum","ta":"நாகூம்","ml":"നഹൂം"},"ref":[33,1,1]},{"q":{"en":"What was Nahum called, according to his hometown?","ta":"நாகூம் எந்த ஊரைச் சேர்ந்தவராகச் சொல்லப்படுகிறார்?","ml":"നഹൂമിനെ ഏതു ദേശക്കാരനായി വിളിക്കുന്നു?"},"a":{"en":"The Elkoshite","ta":"எல்கோசானாகிய","ml":"എൽക്കോശ്യനായ"},"ref":[33,1,1]},{"q":{"en":"What kind of God is the LORD, who takes vengeance?","ta":"கர்த்தர் எப்படிப்பட்ட தேவன் என்று நாகூம் சொல்கிறார்?","ml":"പ്രതികാരം ചെയ്യുന്ന ദൈവം എങ്ങനെയുള്ളവൻ എന്നു നഹൂം പറയുന്നു?"},"a":{"en":"Jealous","ta":"எரிச்சலுள்ளவர்","ml":"തീക്ഷ്ണതയുള്ളവൻ"},"ref":[33,1,2]},{"q":{"en":"On whom does the LORD take vengeance?","ta":"கர்த்தர் யாருக்குப் பிரதிபலன் அளிக்கிறார்?","ml":"യഹോവ ആരോടാണു പ്രതികാരം ചെയ്യുന്നത്?"},"a":{"en":"His adversaries","ta":"சத்துருக்களுக்கு","ml":"വൈരികളോടു"},"ref":[33,1,2]},{"q":{"en":"What does the LORD reserve for his enemies?","ta":"கர்த்தர் தம்முடைய பகைஞருக்காக எதை வைத்துவைக்கிறார்?","ml":"യഹോവ തന്റെ ശത്രുക്കൾക്കായി എന്തു സംഗ്രഹിക്കുന്നു?"},"a":{"en":"Wrath","ta":"கோபத்தை","ml":"കോപം"},"ref":[33,1,2]},{"q":{"en":"How is the LORD described regarding anger?","ta":"கர்த்தர் கோபத்தில் எப்படிப்பட்டவர்?","ml":"യഹോവ കോപത്തിൽ എങ്ങനെയുള്ളവനാണ്?"},"a":{"en":"Slow to anger","ta":"நீடிய சாந்தமுள்ளவர்","ml":"ദീർഘക്ഷമയുള്ളവൻ"},"ref":[33,1,3]},{"q":{"en":"In what is the LORD great, according to Nahum?","ta":"கர்த்தர் எதில் மிகுந்தவர் என்று நாகூம் சொல்கிறார்?","ml":"യഹോവ എന്തിൽ മഹാനാണെന്നു നഹൂം പറയുന്നു?"},"a":{"en":"Power","ta":"வல்லமை","ml":"ശക്തി"},"ref":[33,1,3]},{"q":{"en":"Where is the way of the LORD?","ta":"கர்த்தருடைய வழி எங்கே இருக்கிறது?","ml":"യഹോവയുടെ വഴി എവിടെ ഉണ്ടു?"},"a":{"en":"In the whirlwind and in the storm","ta":"சுழல்காற்றிலும் பெருங்காற்றிலும்","ml":"ചുഴലിക്കാറ്റിലും കൊടുങ്കാറ്റിലും"},"ref":[33,1,3]},{"q":{"en":"What are the clouds to the LORD?","ta":"மேகங்கள் கர்த்தருக்கு எப்படி இருக்கின்றன?","ml":"മേഘം യഹോവയ്ക്കു എന്താകുന്നു?"},"a":{"en":"The dust of his feet","ta":"அவருடைய பாதத்துக்குள்","ml":"കാൽക്കീഴിലെ പൊടി"},"ref":[33,1,3]},{"q":{"en":"What does the LORD rebuke and make dry?","ta":"கர்த்தர் எதை அதட்டி வற்றிப்போகப்பண்ணுகிறார்?","ml":"യഹോവ ഏതിനെ ഭർത്സിച്ചു വറ്റിക്കുന്നു?"},"a":{"en":"The sea","ta":"சமுத்திரத்தை","ml":"സമുദ്രത്തെ"},"ref":[33,1,4]},{"q":{"en":"Which places languish before the LORD, along with the flower of Lebanon?","ta":"லீபனோனின் செழிப்போடு சோர்ந்துபோகும் இடங்கள் எவை?","ml":"ലെബാനോന്റെ പുഷ്പത്തോടുകൂടെ വരളുന്ന സ്ഥലങ്ങൾ ഏവ?"},"a":{"en":"Bashan and Carmel","ta":"பாசனும் கர்மேலும்","ml":"ബാശാനും കർമ്മേലും"},"ref":[33,1,4]},{"q":{"en":"What quake at the presence of the LORD?","ta":"கர்த்தருடைய சமுகத்தில் எவை அதிர்கின்றன?","ml":"യഹോവയുടെ മുമ്പിൽ എന്തു കുലുങ്ങുന്നു?"},"a":{"en":"The mountains","ta":"பர்வதங்கள்","ml":"പർവ്വതങ്ങൾ"},"ref":[33,1,5]},{"q":{"en":"What melt at his presence?","ta":"அவர் சமுகத்தில் கரைந்துபோவது எது?","ml":"അവന്റെ മുമ്പിൽ ഉരുകിപ്പോകുന്നതു എന്താണ്?"},"a":{"en":"The hills","ta":"மலைகள்","ml":"കുന്നുകൾ"},"ref":[33,1,5]},{"q":{"en":"What is poured out like fire?","ta":"அக்கினியைப்போல இறைக்கப்படுவது எது?","ml":"തീപോലെ ചൊരിയുന്നതു എന്താണ്?"},"a":{"en":"His fury","ta":"எரிச்சல்","ml":"ക്രോധം"},"ref":[33,1,6]},{"q":{"en":"What are thrown down by the LORD?","ta":"கர்த்தரால் பேர்க்கப்படுபவை எவை?","ml":"യഹോവയാൽ പിളർന്നുപോകുന്നതു എന്താണ്?"},"a":{"en":"The rocks","ta":"கன்மலைகள்","ml":"പാറകൾ"},"ref":[33,1,6]},{"q":{"en":"How is the LORD described, in the day of trouble?","ta":"இக்கட்டு நாளிலே கர்த்தர் எப்படிப்பட்டவர்?","ml":"കഷ്ടദിവസത്തിൽ യഹോവ എങ്ങനെയുള്ളവനാണ്?"},"a":{"en":"Good, a strong hold","ta":"நல்லவர், அரணான கோட்டை","ml":"നല്ലവനും ശരണവും"},"ref":[33,1,7]},{"q":{"en":"Whom does the LORD know?","ta":"கர்த்தர் யாரை அறிந்திருக்கிறார்?","ml":"യഹോവ ആരെ അറിയുന്നു?"},"a":{"en":"Them that trust in him","ta":"தம்மை நம்புகிறவர்களை","ml":"തങ്കൽ ആശ്രയിക്കുന്നവരെ"},"ref":[33,1,7]},{"q":{"en":"With what will the LORD make an utter end of Nineveh's place?","ta":"நினிவேயின் ஸ்தானத்தை கர்த்தர் எதினால் சர்வசங்காரம்பண்ணுவார்?","ml":"നീനെവേയുടെ സ്ഥലത്തിനു യഹോവ എന്തുകൊണ്ടു മുടിവു വരുത്തും?"},"a":{"en":"An overrunning flood","ta":"புரண்டுவருகிற வெள்ளத்தினால்","ml":"കവിഞ്ഞൊഴുകുന്ന പ്രവാഹംകൊണ്ടു"},"ref":[33,1,8]},{"q":{"en":"What shall pursue the LORD's enemies?","ta":"கர்த்தருடைய சத்துருக்களைப் பின்தொடர்வது எது?","ml":"യഹോവയുടെ ശത്രുക്കളെ പിന്തുടരുന്നതു എന്താണ്?"},"a":{"en":"Darkness","ta":"இருள்","ml":"അന്ധകാരം"},"ref":[33,1,8]},{"q":{"en":"How many times will affliction rise up, according to the LORD?","ta":"இடுக்கம் எத்தனை முறை உண்டாகும் என்று கர்த்தர் சொல்கிறார்?","ml":"കഷ്ടത എത്ര പ്രാവശ്യം പൊങ്ങിവരും എന്നു യഹോവ പറയുന്നു?"},"a":{"en":"Not the second time","ta":"மறுபடியும் உண்டாகாது","ml":"രണ്ടുപ്രാവശ്യം പൊങ്ങിവരികയില്ല"},"ref":[33,1,9]},{"q":{"en":"To what are the enemies compared as they are folden together?","ta":"ஒன்றாகப் பின்னியிருக்கிற அவர்கள் எதற்கு ஒப்பாயிருக்கிறார்கள்?","ml":"കൂടിപ്പിണഞ്ഞിരിക്കുന്ന അവരെ എന്തിനോട് ഉപമിക്കുന്നു?"},"a":{"en":"Thorns","ta":"முட்செடிகளுக்கு","ml":"മുള്ളുപോലെ"},"ref":[33,1,10]},{"q":{"en":"What will they be devoured as?","ta":"அவர்கள் எதைப்போல எரிந்துபோவார்கள்?","ml":"അവർ എന്തുപോലെ തീക്കിരയായിത്തീരും?"},"a":{"en":"Stubble fully dry","ta":"காய்ந்துபோன செத்தையைப்போல","ml":"ഉണങ്ങിയ താളടിപോലെ"},"ref":[33,1,10]},{"q":{"en":"What kind of counsellor came out of Nineveh?","ta":"நினிவேயிலிருந்து புறப்பட்டவன் எப்படிப்பட்ட ஆலோசனைக்காரன்?","ml":"നീനെവേയിൽനിന്നു പുറപ്പെട്ടവൻ എന്തു ചെയ്യുന്നവൻ?"},"a":{"en":"A wicked counsellor","ta":"துராலோசனைக்காரன்","ml":"ദോഷം നിരൂപിക്കുന്നവൻ"},"ref":[33,1,11]},{"q":{"en":"What did the LORD say he would do no more to them?","ta":"கர்த்தர் இனி என்ன செய்யமாட்டேன் என்று சொன்னார்?","ml":"യഹോവ ഇനി എന്തു ചെയ്യുകയില്ല എന്നു പറഞ്ഞു?"},"a":{"en":"Afflict them","ta":"சிறுமைப்படுத்தாதிருப்பேன்","ml":"താഴ്ത്തുകയില്ല"},"ref":[33,1,12]},{"q":{"en":"What will the LORD break from off Judah?","ta":"கர்த்தர் யூதாவின்மேலிருந்து எதை முறிப்பார்?","ml":"യഹോവ യെഹൂദയുടെമേൽനിന്നു എന്തു ഒടിച്ചുകളയും?"},"a":{"en":"His yoke","ta":"நுகத்தை","ml":"നുകം"},"ref":[33,1,13]},{"q":{"en":"What will the LORD burst in sunder?","ta":"கர்த்தர் எதை அறுப்பேன் என்று சொன்னார்?","ml":"യഹോവ എന്തു അറുത്തുകളയും എന്നു പറഞ്ഞു?"},"a":{"en":"Thy bonds","ta":"கட்டுகளை","ml":"ബന്ധനങ്ങൾ"},"ref":[33,1,13]},{"q":{"en":"What did the LORD command concerning Nineveh's name?","ta":"நினிவேயின் பேரைக்குறித்துக் கர்த்தர் என்ன கட்டளையிட்டார்?","ml":"നീനെവേയുടെ പേരിനെക്കുറിച്ചു യഹോവ എന്തു കല്പിച്ചു?"},"a":{"en":"No more be sown","ta":"வித்துவிதைக்கப்படுவதில்லை","ml":"സന്തതി ഇനി ഉണ്ടാകയില്ല"},"ref":[33,1,14]},{"q":{"en":"Which two kinds of image will the LORD cut off from the house of their gods?","ta":"அவர்கள் தேவர்களின் கோவிலிலிருந்து கர்த்தர் நிர்மூலமாக்கும் இரண்டு விக்கிரகங்கள் எவை?","ml":"ദേവന്മാരുടെ ക്ഷേത്രത്തിൽനിന്നു യഹോവ ഛേദിച്ചുകളയുന്ന രണ്ടു വിഗ്രഹങ്ങൾ ഏവ?"},"a":{"en":"Graven image and molten image","ta":"வெட்டப்பட்ட விக்கிரகம், வார்க்கப்பட்ட விக்கிரகம்","ml":"കൊത്തിയുണ്ടാക്കിയ വിഗ്രഹം, വാർത്തുണ്ടാക്കിയ ബിംബം"},"ref":[33,1,14]},{"q":{"en":"Where are the feet of him that brings good tidings?","ta":"சமாதானத்தைக் கூறுகிறவனுடைய கால்கள் எங்கே வருகிறது?","ml":"സുവാർത്ത ഘോഷിക്കുന്നവന്റെ കാൽ എവിടെ കാണുന്നു?"},"a":{"en":"Upon the mountains","ta":"மலைகளின்மேல்","ml":"പർവ്വതങ്ങളിന്മേൽ"},"ref":[33,1,15]},{"q":{"en":"Which nation is told to keep its solemn feasts and perform its vows?","ta":"பண்டிகைகளை ஆசரித்துப் பொருத்தனைகளைச் செலுத்தும்படி சொல்லப்பட்டவர் யார்?","ml":"ഉത്സവങ്ങളെ ആചരിച്ചു നേർച്ചകളെ കഴിപ്പാൻ പറഞ്ഞതു ഏതു ദേശത്തോടാണ്?"},"a":{"en":"Judah","ta":"யூதா","ml":"യെഹൂദ"},"ref":[33,1,15]},{"q":{"en":"What did Nahum say comes up before the face of Nineveh?","ta":"நினிவேயின் முகத்துக்கு முன்பாக வருகிறவன் எப்படிப்பட்டவன்?","ml":"നീനെവേയ്ക്കെതിരേ കയറിവരുന്നവൻ ആര്?"},"a":{"en":"He that dasheth in pieces","ta":"சிதறடிக்கிறவன்","ml":"സംഹാരകൻ"},"ref":[33,2,1]},{"q":{"en":"What was Nineveh told to keep and watch?","ta":"நினிவே எதைக் காத்துக்கொண்டு எதைக் காவல்பண்ணவேண்டும்?","ml":"നീനെവേ എന്തു കാക്കുകയും എന്തു സൂക്ഷിച്ചുനോക്കുകയും വേണം?"},"a":{"en":"The munition and the way","ta":"அரணையும் வழியையும்","ml":"കോട്ടയും വഴിയും"},"ref":[33,2,1]},{"q":{"en":"Whose excellency did the LORD restore like the excellency of Israel?","ta":"இஸ்ரவேலின் மகிமையைப்போல கர்த்தர் யாருடைய மகிமையைத் திரும்பிவரப்பண்ணுவார்?","ml":"യിസ്രായേലിന്റെ മഹിമപോലെ യഹോവ ആരുടെ മഹിമയെ യഥാസ്ഥാനത്താക്കും?"},"a":{"en":"Jacob","ta":"யாக்கோபின்","ml":"യാക്കോബിന്റെ"},"ref":[33,2,2]},{"q":{"en":"What did the emptiers mar?","ta":"வெறுமையாக்குகிறவர்கள் எதைக் கெடுத்துப்போட்டார்கள்?","ml":"പിടിച്ചുപറിക്കാർ എന്തു നശിപ്പിച്ചുകളഞ്ഞു?"},"a":{"en":"Their vine branches","ta":"திராட்சக்கொடிகளை","ml":"മുന്തിരിവള്ളികളെ"},"ref":[33,2,2]},{"q":{"en":"What color is the shield of his mighty men made?","ta":"பராக்கிரமசாலிகளின் கேடகம் எப்படியாகும்?","ml":"വീരന്മാരുടെ പരിച എന്തു നിറമാക്കിയിരിക്കുന്നു?"},"a":{"en":"Red","ta":"இரத்தமயமாகும்","ml":"ചുവപ്പ്"},"ref":[33,2,3]},{"q":{"en":"What are the valiant men clothed in?","ta":"யுத்தவீரர் எதைத் தரித்துக்கொண்டிருக்கிறார்கள்?","ml":"പരാക്രമശാലികൾ എന്തു ധരിച്ചു നില്ക്കുന്നു?"},"a":{"en":"Scarlet","ta":"இரத்தாம்பரம்","ml":"ധൂമ്രവസ്ത്രം"},"ref":[33,2,3]},{"q":{"en":"Where shall the chariots rage?","ta":"இரதங்கள் எங்கே கடகடவென்றோடும்?","ml":"രഥങ്ങൾ എവിടെ ചടുചട ചാടുന്നു?"},"a":{"en":"In the streets","ta":"தெருக்களில்","ml":"തെരുക്കളിൽ"},"ref":[33,2,4]},{"q":{"en":"What shall the chariots seem like?","ta":"இரதங்கள் எவைகளைப்போல விளங்கும்?","ml":"രഥങ്ങളെ എന്തുപോലെ കാണുന്നു?"},"a":{"en":"Torches","ta":"தீவட்டிகளைப்போல","ml":"തീപ്പന്തങ്ങളെപ്പോലെ"},"ref":[33,2,4]},{"q":{"en":"What shall the chariots run like?","ta":"இரதங்கள் எவைகளைப்போல வேகமா