[{"q":{"en":"Who wrote the letter to Titus?","ta":"தீத்துவுக்கு எழுதின நிருபத்தை எழுதியவர் யார்?","ml":"തീത്തൊസിന്നു ലേഖനം എഴുതിയതു ആര്?"},"a":{"en":"Paul","ta":"பவுல்","ml":"പൌലൊസ്"},"ref":[55,1,1]},{"q":{"en":"What did Paul call himself in relation to God?","ta":"பவுல் தன்னை தேவனுக்கு என்னவென்று சொல்லிக்கொண்டான்?","ml":"പൌലൊസ് തന്നെത്താൻ ദൈവത്തിന്റെ എന്തു എന്നു പറഞ്ഞു?"},"a":{"en":"A servant of God","ta":"தேவனுடைய ஊழியக்காரன்","ml":"ദൈവത്തിന്റെ ദാസൻ"},"ref":[55,1,1]},{"q":{"en":"Whose apostle was Paul?","ta":"பவுல் யாருடைய அப்போஸ்தலன்?","ml":"പൌലൊസ് ആരുടെ അപ്പൊസ്തലനായിരുന്നു?"},"a":{"en":"Jesus Christ","ta":"இயேசுகிறிஸ்து","ml":"യേശുക്രിസ്തു"},"ref":[55,1,1]},{"q":{"en":"What hope did Paul speak of in Titus 1:2?","ta":"பவுல் குறிப்பிட்ட நம்பிக்கை என்ன?","ml":"പൌലൊസ് പറഞ്ഞ പ്രത്യാശ എന്തു?"},"a":{"en":"Eternal life","ta":"நித்திய ஜீவன்","ml":"നിത്യജീവൻ"},"ref":[55,1,2]},{"q":{"en":"What kind of God promised eternal life before the world began?","ta":"உலகம் உண்டாகுமுன் நித்திய ஜீவனை வாக்குத்தத்தம்பண்ணின தேவன் எப்படிப்பட்டவர்?","ml":"ലോകത്തിന്നു മുമ്പെ നിത്യജീവൻ വാഗ്ദത്തം ചെയ്ത ദൈവം എങ്ങനെയുള്ളവൻ?"},"a":{"en":"God that cannot lie","ta":"பொய்யுரையாத தேவன்","ml":"ഭോഷ്കില്ലാത്ത ദൈവം"},"ref":[55,1,2]},{"q":{"en":"Through what did God manifest his word in due times?","ta":"ஏற்றகாலங்களிலே தேவன் தமது வார்த்தையை எதினாலே வெளிப்படுத்தினார்?","ml":"തക്കസമയത്തു ദൈവം തന്റെ വചനം എന്തിനാൽ വെളിപ്പെടുത്തി?"},"a":{"en":"Preaching","ta":"பிரசங்கத்தினாலே","ml":"പ്രസംഗത്താൽ"},"ref":[55,1,3]},{"q":{"en":"By whose commandment was the preaching committed to Paul?","ta":"பிரசங்கம் யாருடைய கட்டளையின்படி பவுலுக்கு ஒப்பவிக்கப்பட்டது?","ml":"പ്രസംഗം ആരുടെ കല്പനപ്രകാരം പൌലൊസിനെ ഭരമേല്പിച്ചു?"},"a":{"en":"God our Saviour","ta":"நம்முடைய இரட்சகராகிய தேவன்","ml":"നമ്മുടെ രക്ഷിതാവായ ദൈവം"},"ref":[55,1,3]},{"q":{"en":"To whom did Paul write this letter?","ta":"பவுல் இந்த நிருபத்தை யாருக்கு எழுதினான்?","ml":"പൌലൊസ് ഈ ലേഖനം ആർക്കു എഴുതി?"},"a":{"en":"Titus","ta":"தீத்து","ml":"തീത്തൊസ്"},"ref":[55,1,4]},{"q":{"en":"What did Paul call Titus?","ta":"தீத்துவை பவுல் என்னவென்று அழைத்தான்?","ml":"തീത്തൊസിനെ പൌലൊസ് എന്തു എന്നു വിളിച്ചു?"},"a":{"en":"His own son after the common faith","ta":"உத்தம குமாரன்","ml":"പൊതുവിശ്വാസത്തിൽ നിജപുത്രൻ"},"ref":[55,1,4]},{"q":{"en":"What three things did Paul wish for Titus from God the Father?","ta":"பவுல் தீத்துவுக்கு எவைகள் உண்டாவதாக என்று வாழ்த்தினான்?","ml":"പൌലൊസ് തീത്തൊസിന്നു എന്തെല്ലാം ഉണ്ടാകട്ടെ എന്നു ആശംസിച്ചു?"},"a":{"en":"Grace, mercy and peace","ta":"கிருபையும் இரக்கமும் சமாதானமும்","ml":"കൃപയും സമാധാനവും"},"ref":[55,1,4]},{"q":{"en":"In which island did Paul leave Titus?","ta":"பவுல் தீத்துவை எந்தத் தீவிலே விட்டுவந்தான்?","ml":"പൌലൊസ് തീത്തൊസിനെ എവിടെ വിട്ടേച്ചുപോന്നു?"},"a":{"en":"Crete","ta":"கிரேத்தாதீவு","ml":"ക്രേത്ത"},"ref":[55,1,5]},{"q":{"en":"Why did Paul leave Titus in Crete?","ta":"பவுல் தீத்துவை கிரேத்தாதீவிலே ஏன் விட்டுவந்தான்?","ml":"പൌലൊസ് തീത്തൊസിനെ ക്രേത്തയിൽ എന്തിനു വിട്ടേച്ചുപോന്നു?"},"a":{"en":"To set things in order","ta":"குறைவாயிருக்கிறவைகளை ஒழுங்குபடுத்த","ml":"ശേഷിച്ച കാര്യങ്ങളെ ക്രമത്തിലാക്കേണ്ടതിന്നു"},"ref":[55,1,5]},{"q":{"en":"Whom was Titus to ordain in every city?","ta":"தீத்து பட்டணங்கள்தோறும் யாரை ஏற்படுத்த வேண்டும்?","ml":"തീത്തൊസ് പട്ടണംതോറും ആരെ ആക്കി വെക്കേണം?"},"a":{"en":"Elders","ta":"மூப்பரை","ml":"മൂപ്പന്മാരെ"},"ref":[55,1,5]},{"q":{"en":"How many wives should an elder have?","ta":"மூப்பன் எத்தனை மனைவிகளை உடையவனாயிருக்க வேண்டும்?","ml":"മൂപ്പൻ എത്ര ഭാര്യയുള്ളവനായിരിക്കേണം?"},"a":{"en":"One","ta":"ஒரே மனைவி","ml":"ഏകഭാര്യ"},"ref":[55,1,6]},{"q":{"en":"What kind of children should an elder have?","ta":"மூப்பனுக்கு எப்படிப்பட்ட பிள்ளைகள் இருக்க வேண்டும்?","ml":"മൂപ്പന്നു എങ്ങനെയുള്ള മക്കൾ ഉണ്ടായിരിക്കേണം?"},"a":{"en":"Faithful children","ta":"விசுவாசமுள்ள பிள்ளைகள்","ml":"വിശ്വാസികളായ മക്കൾ"},"ref":[55,1,6]},{"q":{"en":"Whose steward is a bishop?","ta":"கண்காணி யாருடைய உக்கிராணக்காரன்?","ml":"അദ്ധ്യക്ഷൻ ആരുടെ ഗൃഹവിചാരകൻ?"},"a":{"en":"God's","ta":"தேவனுடைய","ml":"ദൈവത്തിന്റെ"},"ref":[55,1,7]},{"q":{"en":"Which drink must a bishop not be given to?","ta":"கண்காணி எதற்கு அடிமையாயிருக்கக்கூடாது?","ml":"അദ്ധ്യക്ഷൻ ഏതിൽ പ്രിയമുള്ളവൻ ആയിരിക്കരുതു?"},"a":{"en":"Wine","ta":"மதுபானம்","ml":"മദ്യം"},"ref":[55,1,7]},{"q":{"en":"What must a bishop be as the steward of God?","ta":"தேவனுடைய உக்கிராணக்காரனாகிய கண்காணி எப்படிப்பட்டவனாயிருக்க வேண்டும்?","ml":"ദൈവത്തിന്റെ ഗൃഹവിചാരകനായ അദ്ധ്യക്ഷൻ എങ്ങനെയുള്ളവനായിരിക്കേണം?"},"a":{"en":"Blameless","ta":"குற்றஞ்சாட்டப்படாதவன்","ml":"അനിന്ദ്യൻ"},"ref":[55,1,7]},{"q":{"en":"What should a bishop be a lover of, towards strangers?","ta":"கண்காணி அந்நியரிடத்தில் எதில் பிரியமுள்ளவனாயிருக்க வேண்டும்?","ml":"അദ്ധ്യക്ഷൻ എന്തിൽ പ്രിയമുള്ളവനായിരിക്കേണം?"},"a":{"en":"Hospitality","ta":"உபசரிப்பு","ml":"അതിഥിപ്രിയം"},"ref":[55,1,8]},{"q":{"en":"What must a bishop hold fast?","ta":"கண்காணி எதைப் பற்றிக்கொண்டிருக்க வேண்டும்?","ml":"അദ്ധ്യക്ഷൻ എന്തു മുറുകെപ്പിടിക്കേണം?"},"a":{"en":"The faithful word","ta":"உண்மையுள்ள வார்த்தை","ml":"വിശ്വാസ്യവചനം"},"ref":[55,1,9]},{"q":{"en":"By what can he exhort and convince the gainsayers?","ta":"எதினால் புத்திசொல்லவும் எதிர்பேசுகிறவர்களைக் கண்டனம் பண்ணவும் வல்லவனாயிருக்க வேண்டும்?","ml":"ഏതിനാൽ പ്രബോധിപ്പിപ്പാനും വിരോധികൾക്കു ബോധം വരുത്തുവാനും ശക്തനാകേണം?"},"a":{"en":"Sound doctrine","ta":"ஆரோக்கியமான உபதேசம்","ml":"പത്ഥ്യോപദേശം"},"ref":[55,1,9]},{"q":{"en":"Which people were specially unruly and vain talkers?","ta":"விசேஷமாய் அடங்காதவர்களும் வீண்பேச்சுக்காரருமாயிருந்தவர்கள் யார்?","ml":"വിശേഷിച്ചു വൃഥാവാചാലന്മാരായിരുന്നതു ആർ?"},"a":{"en":"They of the circumcision","ta":"விருத்தசேதனமுள்ளவர்கள்","ml":"പരിച്ഛേദനക്കാർ"},"ref":[55,1,10]},{"q":{"en":"What must be done to the mouths of the deceivers?","ta":"வஞ்சகருடைய வாயை என்ன செய்ய வேண்டும்?","ml":"വഞ്ചകരുടെ വായ് എന്തു ചെയ്യേണം?"},"a":{"en":"Stopped","ta":"அடக்க வேண்டும்","ml":"അടെക്കേണം"},"ref":[55,1,11]},{"q":{"en":"For what sake did they teach things they ought not?","ta":"அவர்கள் எதற்காகத் தகாதவைகளை உபதேசித்தார்கள்?","ml":"അവർ എന്തിനു വേണ്ടി അരുതാത്തതു ഉപദേശിച്ചു?"},"a":{"en":"Filthy lucre","ta":"இழிவான ஆதாயம்","ml":"ദുരാദായം"},"ref":[55,1,11]},{"q":{"en":"Who said the Cretians are always liars?","ta":"கிரேத்தர் ஓயாப்பொய்யர் என்று சொன்னவன் யார்?","ml":"ക്രേത്തർ അസത്യവാദികൾ എന്നു പറഞ്ഞതു ആർ?"},"a":{"en":"A prophet of their own","ta":"அவர்களுடைய தீர்க்கதரிசி","ml":"അവരുടെ ഒരു വിദ്വാൻ"},"ref":[55,1,12]},{"q":{"en":"What did the prophet call the Cretians besides liars?","ta":"கிரேத்தரை பொய்யர் என்பதோடு வேறு எப்படிச் சொன்னான்?","ml":"ക്രേത്തരെ അസത്യവാദികൾ എന്നതിനു പുറമെ എന്തു പറഞ്ഞു?"},"a":{"en":"Evil beasts, slow bellies","ta":"துஷ்டமிருகங்கள், பெருவயிற்றுச் சோம்பேறிகள்","ml":"ദുഷ്ടജന്തുക്കൾ, മടിയന്മാരായ പെരുവയറന്മാർ"},"ref":[55,1,12]},{"q":{"en":"How did Paul tell Titus to rebuke them?","ta":"தீத்து அவர்களை எப்படிக் கடிந்துகொள்ள வேண்டும்?","ml":"തീത്തൊസ് അവരെ എങ്ങനെ ശാസിക്കേണം?"},"a":{"en":"Sharply","ta":"கண்டிப்பாய்","ml":"കഠിനമായി"},"ref":[55,1,13]},{"q":{"en":"Why should Titus rebuke them sharply?","ta":"தீத்து அவர்களை ஏன் கடிந்துகொள்ள வேண்டும்?","ml":"തീത്തൊസ് അവരെ എന്തിനു ശാസിക്കേണം?"},"a":{"en":"That they may be sound in the faith","ta":"விசுவாசத்திலே ஆரோக்கியமுள்ளவர்களாயிருக்கும்படி","ml":"വിശ്വാസത്തിൽ ആരോഗ്യമുള്ളവരായിത്തീരേണ്ടതിന്നു"},"ref":[55,1,13]},{"q":{"en":"To what fables were they not to give heed?","ta":"அவர்கள் எவைகளுக்குச் செவிகொடுக்கக்கூடாது?","ml":"അവർ ഏതു കഥകളെ ശ്രദ്ധിക്കരുതു?"},"a":{"en":"Jewish fables","ta":"யூதருடைய கட்டுக்கதைகள்","ml":"യെഹൂദകഥകൾ"},"ref":[55,1,14]},{"q":{"en":"To whom are all things pure?","ta":"யாருக்குச் சகலமும் சுத்தமாயிருக்கும்?","ml":"ആർക്കു എല്ലാം ശുദ്ധമാകുന്നു?"},"a":{"en":"The pure","ta":"சுத்தமுள்ளவர்களுக்கு","ml":"ശുദ്ധിയുള്ളവർക്കു"},"ref":[55,1,15]},{"q":{"en":"What is defiled in the unbelieving?","ta":"அவிசுவாசமுள்ளவர்களிடத்தில் அசுத்தமாயிருப்பவை எவை?","ml":"അവിശ്വാസികളിൽ മലിനമായിരിക്കുന്നതു എന്തു?"},"a":{"en":"Their mind and conscience","ta":"புத்தியும் மனச்சாட்சியும்","ml":"ചിത്തവും മനസ്സാക്ഷിയും"},"ref":[55,1,15]},{"q":{"en":"How do they deny God, though they profess to know him?","ta":"தேவனை அறிந்திருக்கிறோமென்று சொல்லுகிறவர்கள் எதினால் அவரை மறுதலிக்கிறார்கள்?","ml":"ദൈവത്തെ അറിയുന്നു എന്നു പറയുന്നവർ എന്തിനാൽ അവനെ നിഷേധിക്കുന്നു?"},"a":{"en":"By works","ta":"கிரியைகளினால்","ml":"പ്രവൃത്തികളാൽ"},"ref":[55,1,16]},{"q":{"en":"What did Paul tell Titus to speak?","ta":"தீத்து எவைகளைப் பேச வேண்டும் என்று பவுல் சொன்னான்?","ml":"തീത്തൊസ് എന്തു പ്രസ്താവിക്കേണം എന്നു പൌലൊസ് പറഞ്ഞു?"},"a":{"en":"The things which become sound doctrine","ta":"ஆரோக்கியமான உபதேசத்துக்கேற்றவைகளை","ml":"പത്ഥ്യോപദേശത്തിന്നു ചേരുന്നതു"},"ref":[55,2,1]},{"q":{"en":"In what three things should aged men be sound?","ta":"முதிர்வயதுள்ள புருஷர்கள் எவைகளில் ஆரோக்கியமுள்ளவர்களாயிருக்க வேண்டும்?","ml":"വൃദ്ധന്മാർ ഏതു മൂന്നിൽ ആരോഗ്യമുള്ളവരായിരിക്കേണം?"},"a":{"en":"Faith, charity and patience","ta":"விசுவாசம், அன்பு, பொறுமை","ml":"വിശ്വാസം, സ്നേഹം, സഹിഷ്ണത"},"ref":[55,2,2]},{"q":{"en":"What should aged women be, instead of false accusers?","ta":"முதிர்வயதுள்ள ஸ்திரீகள் அவதூறுபண்ணாமல் எப்படியிருக்க வேண்டும்?","ml":"വൃദ്ധമാർ ഏഷണി പറയാതെ എങ്ങനെയുള്ളവരായിരിക്കേണം?"},"a":{"en":"Teachers of good things","ta":"நல்லவைகளைப் போதிக்கிறவர்கள்","ml":"നല്ലതു ഉപദേശിക്കുന്നവർ"},"ref":[55,2,3]},{"q":{"en":"What should aged women not be given to?","ta":"முதிர்வயதுள்ள ஸ்திரீகள் எதற்கு அடிமைப்படக்கூடாது?","ml":"വൃദ്ധമാർ ഏതിന്നു അടിമപ്പെടരുതു?"},"a":{"en":"Much wine","ta":"மதுபானம்","ml":"വീഞ്ഞു"},"ref":[55,2,3]},{"q":{"en":"Whom should the aged women teach?","ta":"முதிர்வயதுள்ள ஸ்திரீகள் யாருக்குப் போதிக்க வேண்டும்?","ml":"വൃദ്ധമാർ ആരെ പഠിപ്പിക്കേണം?"},"a":{"en":"The young women","ta":"பாலிய ஸ்திரீகள்","ml":"യൌവനക്കാരത്തികളെ"},"ref":[55,2,4]},{"q":{"en":"Whom should young women love?","ta":"பாலிய ஸ்திரீகள் யாரிடத்தில் அன்புள்ளவர்களாயிருக்க வேண்டும்?","ml":"യൌവനക്കാരത്തികൾ ആരെ സ്നേഹിക്കേണം?"},"a":{"en":"Their husbands and their children","ta":"தங்கள் புருஷரிடத்திலும் பிள்ளைகளிடத்திலும்","ml":"ഭർത്താക്കന്മാരെയും മക്കളെയും"},"ref":[55,2,4]},{"q":{"en":"Where should young women be keepers?","ta":"பாலிய ஸ்திரீகள் எங்கே தரித்திருக்க வேண்டும்?","ml":"യൌവനക്കാരത്തികൾ എവിടെ കാര്യം നോക്കേണം?"},"a":{"en":"At home","ta":"வீட்டில்","ml":"വീട്ടിൽ"},"ref":[55,2,5]},{"q":{"en":"To whom should young women be obedient?","ta":"பாலிய ஸ்திரீகள் யாருக்குக் கீழ்ப்படிய வேண்டும்?","ml":"യൌവനക്കാരത്തികൾ ആർക്കു കീഴ്പെടേണം?"},"a":{"en":"Their own husbands","ta":"தங்கள் புருஷருக்கு","ml":"ഭർത്താക്കന്മാർക്കു"},"ref":[55,2,5]},{"q":{"en":"Why should young women live this way?","ta":"பாலிய ஸ்திரீகள் இப்படி நடக்க வேண்டியது ஏன்?","ml":"യൌവനക്കാരത്തികൾ ഇങ്ങനെ ആയിരിക്കേണ്ടതു എന്തുകൊണ്ട്?"},"a":{"en":"That the word of God be not blasphemed","ta":"தேவவசனம் தூஷிக்கப்படாதபடிக்கு","ml":"ദൈവവചനം ദുഷിക്കപ്പെടാതിരിക്കേണ്ടതിന്നു"},"ref":[55,2,5]},{"q":{"en":"What did Paul tell Titus to exhort the young men to be?","ta":"வாலிப புருஷரை எப்படியிருக்கும்படி தீத்து புத்திசொல்ல வேண்டும்?","ml":"യൌവനക്കാരെ എങ്ങനെയുള്ളവരായിരിപ്പാൻ തീത്തൊസ് പ്രബോധിപ്പിക്കേണം?"},"a":{"en":"Sober minded","ta":"தெளிந்த புத்தியுள்ளவர்கள்","ml":"സുബോധമുള്ളവർ"},"ref":[55,2,6]},{"q":{"en":"What was Titus to show himself a pattern of?","ta":"தீத்து தன்னை எவைகளுக்கு மாதிரியாகக் காண்பிக்க வேண்டும்?","ml":"തീത്തൊസ് തന്നെത്തന്നേ എന്തിന്നു മാതൃകയാക്കേണം?"},"a":{"en":"Good works","ta":"நற்கிரியைகள்","ml":"സൽപ്രവൃത്തികൾ"},"ref":[55,2,7]},{"q":{"en":"In all things, what was Titus to show himself?","ta":"தீத்து எல்லாவற்றிலும் தன்னை எப்படிக் காண்பிக்க வேண்டும்?","ml":"തീത്തൊസ് സകലത്തിലും തന്നെത്തന്നേ എങ്ങനെ കാണിക്കേണം?"},"a":{"en":"A pattern of good works","ta":"நற்கிரியைகளுக்கு மாதிரி","ml":"സൽപ്രവൃത്തികൾക്കു മാതൃക"},"ref":[55,2,7]},{"q":{"en":"What kind of speech should Titus use that cannot be condemned?","ta":"குற்றம்பிடிக்கப்படாத எப்படிப்பட்ட வசனத்தைத் தீத்து பேச வேண்டும்?","ml":"ആക്ഷേപിച്ചുകൂടാത്ത ഏതു വചനം തീത്തൊസ് പറയേണം?"},"a":{"en":"Sound speech","ta":"ஆரோக்கியமான வசனம்","ml":"പത്ഥ്യവചനം"},"ref":[55,2,8]},{"q":{"en":"Why should Titus's speech be sound?","ta":"தீத்துவின் வசனம் ஆரோக்கியமாயிருக்க வேண்டியது ஏன்?","ml":"തീത്തൊസ