[{"q":{"en":"Who was the prophet to whom the word of the LORD came?","ta":"கர்த்தருடைய வார்த்தை யாருக்கு உண்டானது?","ml":"യഹോവയുടെ അരുളപ്പാടു ആർക്കു ഉണ്ടായി?"},"a":{"en":"Micah","ta":"மீகாவுக்கு","ml":"മീഖെക്കു"},"ref":[32,1,1]},{"q":{"en":"Micah was from which town?","ta":"மீகா எந்த ஊரைச் சேர்ந்தவன்?","ml":"മീഖാ ഏതു ദേശക്കാരനായിരുന്നു?"},"a":{"en":"Morasthite","ta":"மொரேசா","ml":"മോരസ്ത്യൻ"},"ref":[32,1,1]},{"q":{"en":"In the days of which kings of Judah did Micah prophesy?","ta":"மீகா யாருடைய நாட்களில் தரிசனம் பெற்றான்?","ml":"മീഖാ ഏതു രാജാക്കന്മാരുടെ കാലത്തു ദർശനം പ്രാപിച്ചു?"},"a":{"en":"Jotham, Ahaz, and Hezekiah","ta":"யோதாம், ஆகாஸ், எசேக்கியா","ml":"യോഥാം, ആഹാസ്, യെഹിസ്കീയാവു"},"ref":[32,1,1]},{"q":{"en":"How many kings of Judah are named in Micah's days?","ta":"மீகாவின் நாட்களில் எத்தனை யூதா ராஜாக்கள் சொல்லப்பட்டுள்ளனர்?","ml":"മീഖായുടെ കാലത്തു എത്ര യെഹൂദാരാജാക്കന്മാരെ പറഞ്ഞിരിക്കുന്നു?"},"a":{"en":"Three","ta":"மூன்று","ml":"മൂന്നു"},"ref":[32,1,1]},{"q":{"en":"Concerning which two cities did Micah see the vision?","ta":"மீகா எந்த இரண்டு பட்டணங்களுக்கு விரோதமாய்த் தரிசித்தான்?","ml":"മീഖാ ഏതു രണ്ടു നഗരങ്ങളെക്കുറിച്ചു ദർശിച്ചു?"},"a":{"en":"Samaria and Jerusalem","ta":"சமாரியா, எருசலேம்","ml":"ശമർയ്യ, യെരൂശലേം"},"ref":[32,1,1]},{"q":{"en":"Whom does Micah call to hear his message?","ta":"மீகா யாரைக் கேட்கச் சொன்னான்?","ml":"മീഖാ ആരോടു കേൾപ്പാൻ പറഞ്ഞു?"},"a":{"en":"All the people","ta":"சகல ஜனங்களே","ml":"സകലജാതികളും"},"ref":[32,1,2]},{"q":{"en":"Who will be a witness against the people?","ta":"ஜனங்களுக்கு விரோதமாகச் சாட்சியாயிருப்பவர் யார்?","ml":"ജനത്തിനു വിരോധമായി സാക്ഷിയായിരിക്കുന്നവൻ ആർ?"},"a":{"en":"The Lord GOD","ta":"கர்த்தராகிய ஆண்டவர்","ml":"യഹോവയായ കർത്താവു"},"ref":[32,1,2]},{"q":{"en":"From where will the Lord be witness against them?","ta":"கர்த்தர் எங்கிருந்து சாட்சியாயிருப்பார்?","ml":"കർത്താവു എവിടെനിന്നു സാക്ഷിയായിരിക്കും?"},"a":{"en":"His holy temple","ta":"பரிசுத்த ஆலயம்","ml":"വിശുദ്ധമന്ദിരം"},"ref":[32,1,2]},{"q":{"en":"What will the LORD do from his place?","ta":"கர்த்தர் தமது ஸ்தானத்திலிருந்து என்ன செய்வார்?","ml":"യഹോവ തന്റെ സ്ഥലത്തുനിന്നു എന്തു ചെയ്യും?"},"a":{"en":"Come down","ta":"இறங்கி வருவார்","ml":"ഇറങ്ങും"},"ref":[32,1,3]},{"q":{"en":"Upon what will the LORD tread?","ta":"கர்த்தர் எவைகளை மிதிப்பார்?","ml":"യഹോവ ഏതിന്മേൽ നടകൊള്ളും?"},"a":{"en":"The high places of the earth","ta":"பூமியின் உயர்ந்த இடங்கள்","ml":"ഭൂമിയുടെ ഉന്നതികൾ"},"ref":[32,1,3]},{"q":{"en":"What will melt under the LORD?","ta":"கர்த்தர் கீழே எவை உருகும்?","ml":"യഹോവയുടെ കീഴിൽ എന്തു ഉരുകും?"},"a":{"en":"The mountains","ta":"பர்வதங்கள்","ml":"പർവ്വതങ്ങൾ"},"ref":[32,1,4]},{"q":{"en":"What will happen to the valleys before the LORD?","ta":"பள்ளத்தாக்குகளுக்கு என்ன நேரிடும்?","ml":"താഴ്വരകൾക്കു എന്തു സംഭവിക്കും?"},"a":{"en":"They shall be cleft","ta":"பிளந்துபோகும்","ml":"പിളർന്നുപോകും"},"ref":[32,1,4]},{"q":{"en":"The mountains melt like what before the fire?","ta":"அக்கினிக்கு முன்பாக உருகுவது எது?","ml":"തീയുടെ മുമ്പിൽ ഉരുകുന്നതു എന്തുപോലെ?"},"a":{"en":"Wax","ta":"மெழுகு","ml":"മെഴുകുപോലെ"},"ref":[32,1,4]},{"q":{"en":"For whose transgression is all this happening?","ta":"இது எல்லாம் யாருடைய மீறுதலினிமித்தம் சம்பவிக்கும்?","ml":"ഇതൊക്കെയും ആരുടെ അതിക്രമം നിമിത്തമാകുന്നു?"},"a":{"en":"Jacob","ta":"யாக்கோபு","ml":"യാക്കോബിന്റെ"},"ref":[32,1,5]},{"q":{"en":"What is the transgression of Jacob according to Micah?","ta":"யாக்கோபின் மீறுதலுக்குக் காரணம் எது?","ml":"യാക്കോബിന്റെ അതിക്രമം എന്തു?"},"a":{"en":"Samaria","ta":"சமாரியா","ml":"ശമർയ്യ"},"ref":[32,1,5]},{"q":{"en":"What are the high places of Judah?","ta":"யூதாவின் மேடைகளுக்குக் காரணம் எது?","ml":"യെഹൂദയുടെ പൂജാഗിരികൾ ഏവ?"},"a":{"en":"Jerusalem","ta":"எருசலேம்","ml":"യെരൂശലേം"},"ref":[32,1,5]},{"q":{"en":"What will the LORD make Samaria like?","ta":"கர்த்தர் சமாரியாவை எப்படி ஆக்குவார்?","ml":"യഹോവ ശമർയ്യയെ എന്തുപോലെ ആക്കും?"},"a":{"en":"A heap of the field","ta":"வெளியான மண்மேடு","ml":"വയലിലെ കല്ക്കുന്നുപോലെ"},"ref":[32,1,6]},{"q":{"en":"Samaria will be made like the plantings of what?","ta":"சமாரியா எதன் நிலமாகும்?","ml":"ശമർയ്യ എന്തിന്റെ നടുതലപോലെ ആകും?"},"a":{"en":"A vineyard","ta":"திராட்சச்செடி நடுகிற நிலம்","ml":"മുന്തിരിത്തോട്ടം"},"ref":[32,1,6]},{"q":{"en":"Into where will the LORD pour down the stones of Samaria?","ta":"சமாரியாவின் கற்களை கர்த்தர் எங்கே புரண்டுவிழப்பண்ணுவார்?","ml":"ശമർയ്യയുടെ കല്ലു എവിടേക്കു തള്ളിയിടും?"},"a":{"en":"The valley","ta":"பள்ளத்தாக்கு","ml":"താഴ്വര"},"ref":[32,1,6]},{"q":{"en":"What will be beaten to pieces in Samaria?","ta":"சமாரியாவில் நொறுக்கப்படுவது எது?","ml":"ശമർയ്യയിൽ തകർന്നുപോകുന്നതു എന്തു?"},"a":{"en":"All the graven images","ta":"சுபாவங்கள்","ml":"സകല വിഗ്രഹങ്ങൾ"},"ref":[32,1,7]},{"q":{"en":"With what will the hires of Samaria be burned?","ta":"சமாரியாவின் பணையங்கள் எதினால் எரிக்கப்படும்?","ml":"ശമർയ്യയുടെ സമ്മാനങ്ങൾ എന്തിനാൽ വെന്തുപോകും?"},"a":{"en":"Fire","ta":"அக்கினி","ml":"തീ"},"ref":[32,1,7]},{"q":{"en":"Samaria gathered her wealth from the hire of whom?","ta":"சமாரியா யாருடைய பணையத்தினால் சேர்க்கப்பட்டது?","ml":"ശമർയ്യ ആരുടെ സമ്മാനംകൊണ്ടു സ്വരൂപിച്ചു?"},"a":{"en":"An harlot","ta":"வேசி","ml":"വേശ്യ"},"ref":[32,1,7]},{"q":{"en":"How will Micah go because of this?","ta":"மீகா எப்படி நடப்பான்?","ml":"മീഖാ എങ്ങനെ നടക്കും?"},"a":{"en":"Stripped and naked","ta":"அம்மணமாக","ml":"നഗ്നനായി"},"ref":[32,1,8]},{"q":{"en":"Micah will wail like what animals?","ta":"மீகா எவைகளைப்போல ஊளையிடுவான்?","ml":"മീഖാ ഏതു മൃഗങ്ങളെപ്പോലെ വിലപിക്കും?"},"a":{"en":"The dragons","ta":"ஓரிகள்","ml":"കുറുനരികൾ"},"ref":[32,1,8]},{"q":{"en":"Micah will mourn like what birds?","ta":"மீகா எந்தப் பறவைகளைப்போல அலறுவான்?","ml":"മീഖാ ഏതു പക്ഷികളെപ്പോലെ കരയും?"},"a":{"en":"The owls","ta":"ஆந்தைகள்","ml":"ഒട്ടകപ്പക്ഷികൾ"},"ref":[32,1,8]},{"q":{"en":"What is incurable?","ta":"ஆறாதது எது?","ml":"പൊറുക്കാത്തതു എന്തു?"},"a":{"en":"Her wound","ta":"அதின் காயம்","ml":"അവളുടെ മുറിവു"},"ref":[32,1,9]},{"q":{"en":"The wound has come as far as which city?","ta":"காயம் எந்த நகரம்மட்டும் வந்தெட்டினது?","ml":"മുറിവു ഏതു നഗരത്തോളം എത്തിയിരിക്കുന്നു?"},"a":{"en":"Jerusalem","ta":"எருசலேம்","ml":"യെരൂശലേം"},"ref":[32,1,9]},{"q":{"en":"At which city should they not declare it?","ta":"எந்தப் பட்டணத்திலே அதை அறிவியாதிருக்க வேண்டும்?","ml":"ഏതു പട്ടണത്തിൽ അതു പ്രസ്താവിക്കരുതു?"},"a":{"en":"Gath","ta":"காத்","ml":"ഗത്ത്"},"ref":[32,1,10]},{"q":{"en":"In which house were they to roll in the dust?","ta":"புழுதியில் புரள வேண்டிய இடம் எது?","ml":"പൊടിയിൽ ഉരുളേണ്ട സ്ഥലം ഏതു?"},"a":{"en":"The house of Aphrah","ta":"பெத்அப்ரா","ml":"ബേത്ത്-അഫ്ര"},"ref":[32,1,10]},{"q":{"en":"Who is told to pass away with shame naked?","ta":"வெட்கத்துடன் அப்பாலே போகச் சொல்லப்பட்டவள் எந்த ஊரில் குடியிருக்கிறவள்?","ml":"ലജ്ജയോടെ കടന്നുപോകാൻ പറഞ്ഞതു ഏതു നഗരനിവാസികളോടു?"},"a":{"en":"The inhabitant of Saphir","ta":"சாப்பீர்","ml":"ശാഫീർ"},"ref":[32,1,11]},{"q":{"en":"Whose mourning is mentioned along with the inhabitant of Zaanan?","ta":"சாயனானில் குடியிருக்கிறவனோடு எந்த இடத்தின் புலம்பல் சொல்லப்பட்டது?","ml":"സയനാൻ നിവാസികളോടൊപ്പം ഏതു സ്ഥലത്തിന്റെ വിലാപം പറഞ്ഞിരിക്കുന്നു?"},"a":{"en":"Beth-ezel","ta":"பெத்ஏசேல்","ml":"ബേത്ത്--ഏസെൽ"},"ref":[32,1,11]},{"q":{"en":"Who waited carefully for good?","ta":"நன்மை வருமென்று எதிர்பார்த்திருந்தவள் எந்த ஊரில் குடியிருக்கிறவள்?","ml":"നന്മെക്കായി കാത്തിരുന്നതു ഏതു നിവാസികൾ?"},"a":{"en":"The inhabitant of Maroth","ta":"மாரோத்","ml":"മാരോത്ത്"},"ref":[32,1,12]},{"q":{"en":"What came down from the LORD to the gate of Jerusalem?","ta":"கர்த்தரிடத்திலிருந்து எருசலேமின் வாசல்வரைக்கும் வந்தது என்ன?","ml":"യഹോവയുടെ പക്കൽനിന്നു യെരൂശലേംഗോപുരത്തിങ്കൽ ഇറങ്ങിയതു എന്തു?"},"a":{"en":"Evil","ta":"தீமை","ml":"തിന്മ"},"ref":[32,1,12]},{"q":{"en":"Which inhabitants were told to bind the chariot to the swift beast?","ta":"வேகமான குதிரைகளை இரதத்திலே பூட்டச் சொல்லப்பட்டவள் எங்கே குடியிருக்கிறவள்?","ml":"രഥത്തിന്നു തുരഗങ്ങളെ കെട്ടാൻ പറഞ്ഞതു ഏതു നഗരനിവാസികളോടു?"},"a":{"en":"The inhabitant of Lachish","ta":"லாகீசு","ml":"ലാക്കീശ്"},"ref":[32,1,13]},{"q":{"en":"Lachish was the beginning of sin to whom?","ta":"லாகீசு யாருடைய பாவத்துக்குக் காரணி?","ml":"ലാക്കീശ് ആർക്കു പാപകാരണമായി?"},"a":{"en":"The daughter of Zion","ta":"சீயோன் குமாரத்தி","ml":"സീയോൻ പുത്രി"},"ref":[32,1,13]},{"q":{"en":"To which place shall Lachish give presents?","ta":"யாரிடத்தில் உனக்கு இருக்கிறதைக் கொடுத்துவிடுவாய்?","ml":"നീ ഏതു സ്ഥലത്തിനു സമ്മാനം കൊടുക്കേണ്ടിവരും?"},"a":{"en":"Moresheth-gath","ta":"மோர்ஷேக்காத்","ml":"മോരേശെത്ത്-ഗത്ത്"},"ref":[32,1,14]},{"q":{"en":"The houses of which place shall be a lie to the kings of Israel?","ta":"இஸ்ரவேலின் ராஜாக்களுக்கு அபத்தமாய்ப்போகும் வீடுகள் எந்த ஊரினுடையவை?","ml":"യിസ്രായേൽരാജാക്കന്മാർക്കു ആശാഭംഗമാകുന്ന വീടുകൾ ഏതു സ്ഥലത്തേതു?"},"a":{"en":"Achzib","ta":"அக்சீப்","ml":"ബേത്ത്-അക്സീബ്"},"ref":[32,1,14]},{"q":{"en":"To which inhabitant will the LORD bring an heir?","ta":"யாருக்கு சுதந்தரவாளியை வரப்பண்ணுவேன் என்றார்?","ml":"ഏതു നിവാസികളുടെ നേരെ കൈവശമാക്കുന്നവനെ വരുത്തും?"},"a":{"en":"The inhabitant of Mareshah","ta":"மரேஷாவில் குடியிருக்கிறவள்","ml":"മാരേശാ"},"ref":[32,1,15]},{"q":{"en":"The glory of Israel shall come unto which place?","ta":"இஸ்ரவேலின் மகிமை எந்த இடம்மட்டும் வருவான்?","ml":"യിസ്രായേലിന്റെ മഹത്തുക്കൾ ഏതു സ്ഥലത്തോളം ചെല്ലേണ്ടിവരും?"},"a":{"en":"Adullam","ta":"அதுல்லாம்","ml":"അദുല്ലാം"},"ref":[32,1,15]},{"q":{"en":"What were they told to do for their delicate children?","ta":"அருமையான பிள்ளைகளினிமித்தம் என்ன செய்யச் சொல்லப்பட்டது?","ml":"ഓമനക്കുഞ്ഞുങ്ങൾനിമിത്തം എന്തു ചെയ്യാൻ പറഞ്ഞു?"},"a":{"en":"Make thee bald","ta":"தலையைச் சிரைத்து மொட்டையிடு","ml":"മൊട്ടയാക്കുക"},"ref":[32,1,16]},{"q":{"en":"Their baldness should be enlarged like what bird?","ta":"எந்தப் பறவையைப்போல முழுமொட்டையாயிருக்க வேண்டும்?","ml":"ഏതു പക്ഷിയെപ്പോലെ കഷണ്ടിയെ വിസ്താരമാക്കണം?"},"a":{"en":"The eagle","ta":"கழுகு","ml":"കഴുകൻ"},"ref":[32,1,16]},{"q":{"en":"Woe to those who devise what upon their beds?","ta":"படுக்கைகளின்மேல் எதை யோசிக்கிறவர்களுக்கு ஐயோ?","ml":"കിടക്കമേൽ എന്തു നിരൂപിക്കുന്നവർക്കു അയ്യോ കഷ്ടം?"},"a":{"en":"Iniquity","ta":"அக்கிரமம்","ml":"നീതികേടു"},"ref":[32,2,1]},{"q":{"en":"When do the wicked practise their evil?","ta":"அவர்கள் எப்போது தீமையை நடப்பிக்கிறார்கள்?","ml":"അവർ എപ്പോൾ തിന്മ നടത്തുന്നു?"},"a":{"en":"When the morning is light","ta":"விடியற்காலமாகிறபோது","ml":"പുലരുമ്പോൾ"},"ref":[32,2,1]},{"q":{"en":"Why do they practise evil in the morning?","ta":"அவர்கள் ஏன் அதை நடப்பிக்கிறார்கள்?","ml":"അവർ എന്തുകൊണ്ടു അതു നടത്തുന്നു?"},"a":{"en":"It is in the power of their hand","ta":"கையில் வல்லமை இருக்கிறபடியினால்","ml":"അവർക്കു പ്രാപ്തിയുള്ളതുകൊണ്ടു"},"ref":[32,2,1]},{"q":{"en":"What do they covet and take by violence?","ta":"அவர்கள் இச்சித்துப் பறித்துக்கொள்வது எது?","ml":"അവർ മോഹിച്ചു പിടിച്ചുപറിക്കുന്നതു എന്തു?"},"a":{"en":"Fields","ta":"வயல்கள்","ml":"വയലുകൾ"},"ref":[32,2,2]},{"q":{"en":"What else do they covet and take away besides fields?","ta":"வயல்களோடு இச்சித்து எடுத்துக்கொள்வது எது?","ml":"വയലുകളെ കൂടാതെ അവർ മോഹിച്ചു കൈക്കലാക്കുന്നതു എന്തു?"},"a":{"en":"Houses","ta":"வீடுகள்","ml":"വീടുകൾ"},"ref":[32,2,2]},{"q":{"en":"Whose heritage do they oppress?","ta":"அவர்கள் யாருடைய சுதந்தரத்தை ஒடுக்குகிறார்கள்?","ml":"അവർ ആരുടെ അവകാശത്തെ പീഡിപ്പിക്കുന്നു?"},"a":{"en":"A man's","ta":"மனுஷன்","ml":"മനുഷ്യന്റെ"},"ref":[32,2,2]},{"q":{"en":"What does the LORD devise against this family?","ta":"கர்த்தர் இந்த வம்சத்துக்கு விரோதமாய் என்ன நினைக்கிறார்?","ml":"യഹോവ ഈ വംശത്തിന്റെ നേരെ എന്തു നിരൂപിക്കുന്നു?"},"a":{"en":"An evil","ta":"தீமை","ml":"അനർത്ഥം"},"ref":[32,2,3]},{"q":{"en":"What shall they not remove from the evil?","ta":"அவர்கள் எதை நீக்கமாட்டார்கள்?","ml":"അവർ എന്തിനെ വിടുവിക്കയില്ല?"},"a":{"en":"Their necks","ta":"கழுத்து","ml":"കഴുത്തുകൾ"},"ref":[32,2,3]},{"q":{"en":"How shall they not walk, because the time is evil?","ta":"அவர்கள் எப்படி நடப்பதில்லை?","ml":"ദുഷ്കാലം ആകയാൽ അവർ എങ്ങനെ നടക്കയില്ല?"},"a":{"en":"Haughtily","ta":"மேட்டிமையாய்","ml":"നിവിർന്നു"},"ref":[32,2,3]},{"q":{"en":"In that day what shall one take up against them?","ta":"அந்நாளில் அவர்கள்பேரில் என்ன சொல்லுவார்கள்?","ml":"അന്നാളിൽ അവരെക്കുറിച്ചു എന്തു ചൊല്ലും?"},"a":{"en":"A parable","ta":"ஒப்பு","ml":"പരിഹാസവാക്യം"},"ref":[32,2,4]},{"q":{"en":"What shall they say they are in that day?","ta":"அவர்கள் அந்நாளில் தாங்கள் எப்படி ஆனோம் என்று சொல்வார்கள்?","ml":"അവർ അന്നാളിൽ തങ്ങൾക്കു എന്തു ഭവിച്ചു എന്നു പറയും?"},"a":{"en":"Utterly spoiled","ta":"முற்றிலும் பாழானோம்","ml":"പൂർണ്ണ സംഹാരം"},"ref":[32,2,4]},{"q":{"en":"What has the LORD changed, as they lament?","ta":"கர்த்தர் எதை மாற்றிப்போட்டார் என்று புலம்புவார்கள்?","ml":"യഹോവ എന്തു മാറ്റിക്കളഞ്ഞു എന്നു വിലപിക്കും?"},"a":{"en":"The portion of my people","ta":"ஜனத்தின் சுதந்தரம்","ml":"ജനത്തിന്റെ ഓഹരി"},"ref":[32,2,4]},{"q":{"en":"In whose congregation will there be none to cast a cord by lot?","ta":"யாருடைய சபையில் சுதந்தரவீதங்களை அளந்துகொடுக்க ஆளில்லை?","ml":"ആരുടെ സഭയിൽ അളവുനൂൽ പിടിപ്പാൻ ആരും ഉണ്ടാകയില്ല?"},"a":{"en":"The LORD's","ta":"கர்த்தருடைய","ml":"യഹോവയുടെ"},"ref":[32,2,5]},{"q":{"en":"What did they tell the prophets not to do?","ta":"தீர்க்கதரிசிகளிடம் அவர்கள் எதைச் செய்யவேண்டாம் என்றார்கள்?","ml":"പ്രവാചകന്മാരോടു അവർ എന്തു ചെയ്യരുതെന്നു പറഞ്ഞു?"},"a":{"en":"Prophesy","ta":"தீர்க்கதரிசனஞ் சொல்லாதிருங்கள்","ml":"പ്രസംഗിക്കരുതെന്നു"},"ref":[32,2,6]},{"q":{"en":"Whose words do good to him that walketh uprightly?","ta":"செம்மையாய் நடக்கிறவனுக்கு யாருடைய வார்த்தைகள் நன்மை செய்யும்?","ml":"നേരായി നടക്കുന്നവന്നു ആരുടെ വചനങ്ങൾ ഗുണകരം?"},"a":{"en":"The LORD's words","ta":"கர்த்தருடைய வார்த்தைகள்","ml":"യഹോവയുടെ വചനങ്ങൾ"},"ref":[32,2,7]},{"q":{"en":"To whom do the LORD's words do good?","ta":"கர்த்தருடைய வார்த்தைகள் யாருக்கு நன்மை செய்யும்?","ml":"യഹോവയുടെ വചനങ്ങൾ ആർക്കു ഗുണകരം?"},"a":{"en":"Him that walketh uprightly","ta":"செம்மையாய் நடக்கிறவனுக்கு","ml":"നേരായി നടക്കുന്നവന്നു"},"ref":[32,2,7]},{"q":{"en":"Whom did God's people rise up against as an enemy?","ta":"தேவனுடைய ஜனங்கள் யாரிடத்தில் சத்துருவைப்போல் எழும்பினார்கள்?","ml":"ദൈവജനം ആരുടെനേരെ ശത്രുവായി എഴുന്നേറ്റു?"},"a":{"en":"Those passing by securely","ta":"வழியில் அஞ்சாமல் கடந்துபோகிறவர்கள்","ml":"നിർഭയന്മാരായി കടന്നു പോകുന്നവർ"},"ref":[32,2,8]},{"q":{"en":"What did they pull off from those passing by?","ta":"கடந்துபோகிறவர்களிடமிருந்து எதை உரிந்துகொண்டார்கள்?","ml":"കടന്നുപോകുന്നവരുടെ എന്തു വലിച്ചെടുത്തു?"},"a":{"en":"The robe with the garment","ta":"மேலங்கியையும் வஸ்திரத்தையும்","ml":"വസ്ത്രത്തിന്മേൽനിന്നു പുതെപ്പു"},"ref":[32,2,8]},{"q":{"en":"Whom did they cast out from their pleasant houses?","ta":"யாரை அவர்களுடைய செளக்கியமான வீடுகளிலிருந்து துரத்திவிட்டார்கள்?","ml":"ആരെ അവരുടെ സുഖകരമായ വീടുകളിൽനിന്നു ഇറക്കിക്കളഞ്ഞു?"},"a":{"en":"The women of my people","ta":"என் ஜனத்தின் ஸ்திரீகள்","ml":"എന്റെ ജനത്തിന്റെ സ്ത്രീകൾ"},"ref":[32,2,9]},{"q":{"en":"What did they take away from the children forever?","ta":"குழந்தைகளுக்கு இருந்த எதை என்றைக்கும் பறித்துக்கொண்டார்கள்?","ml":"പൈതങ്ങളോടു സദാകാലത്തേക്കും എന്തു അപഹരിച്ചു?"},"a":{"en":"My glory","ta":"என் அலங்காரம்","ml":"എന്റെ മഹത്വം"},"ref":[32,2,9]},{"q":{"en":"What were the people told to do?","ta":"ஜனங்களுக்கு என்ன சொல்லப்பட்டது?","ml":"ജനത്തോടു എന്തു ചെയ്യാൻ പറഞ്ഞു?"},"a":{"en":"Arise and depart","ta":"எழுந்திருந்து போங்கள்","ml":"പുറപ്പെട്ടു പോകുവിൻ"},"ref":[32,2,10]},{"q":{"en":"Why is the land not their rest?","ta":"இது ஏன் இளைப்பாறும் இடம் அல்ல?","ml":"ഇതു എന്തുകൊണ്ടു വിശ്രാമസ്ഥലമല്ല?"},"a":{"en":"Because it is polluted","ta":"தீட்டுப்பட்டது","ml":"മാലിന്യംനിമിത്തം"},"ref":[32,2,10]},{"q":{"en":"About what did the false prophet say he would prophesy?","ta":"பொய்யான பிரசங்கி எதைக்குறித்துப் பிரசங்கிப்பேன் என்றான்?","ml":"വ്യാജം പറയുന്നവൻ എന്തിനെക്കുറിച്ചു പ്രസംഗിക്കും എന്നു പറഞ്ഞു?"},"a":{"en":"Wine and strong drink","ta":"திராட்சரசமும் மதுபானமும்","ml":"വീഞ്ഞും മദ്യപാനവും"},"ref":[32,2,11]},{"q":{"en":"Whom will the LORD surely gather?","ta":"கர்த்தர் நிச்சயமாய்ச் சேர்ப்பவர்கள் யார்?","ml":"യഹോവ ആരെ ശേഖരിക്കും?"},"a":{"en":"The remnant of Israel","ta":"இஸ்ரவேலில் மீதியானவர்கள்","ml":"യിസ്രായേലിൽ ശേഷിപ്പുള്ളവർ"},"ref":[32,2,12]},{"q":{"en":"The LORD will put them together like the sheep of where?","ta":"கர்த்தர் அவர்களை எந்த ஊரின் ஆடுகளைப்போல் கூட்டுவார்?","ml":"യഹോവ അവരെ ഏതു സ്ഥലത്തെ ആടുകളെപ്പോലെ കൂട്ടും?"},"a":{"en":"Bozrah","ta":"போஸ்றா","ml":"ബൊസ്രയിലെ"},"ref":[32,2,12]},{"q":{"en":"Who goes up before them?","ta":"அவர்களுக்கு முன்பாக நடந்துபோகிறவர் யார்?","ml":"അവർക്കു മുമ്പായി പുറപ്പെടുന്നവൻ ആർ?"},"a":{"en":"The breaker","ta":"தடைகளை நீக்கிப்போடுகிறவர்","ml":"തകർക്കുന്നവൻ"},"ref":[32,2,13]},{"q":{"en":"Who will pass before the people at their head?","ta":"ജനங்களுக்கு முன்னணியில் நடந்துபோகிறவர் யார்?","ml":"ജനത്തിന്റെ തലെക്കൽ നടക്കുന്നവൻ ആർ?"},"a":{"en":"The LORD","ta":"கர்த்தர்","ml":"യഹോവ"},"ref":[32,2,13]},{"q":{"en":"To whom did Micah say, \"Hear, I pray you,\" in the first verse?","ta":"மீகா யாரிடம் கேளுங்கள் என்று சொன்னான்?","ml":"മീഖാ ആരോടു കേൾപ്പിൻ എന്നു പറഞ്ഞു?"},"a":{"en":"The heads of Jacob and the princes of Israel","ta":"யாக்கோபின் தலைவர்கள், இஸ்ரவேல் அதிபதிகள்","ml":"യാക്കോബിന്റെ തലവന്മാർ, യിസ്രായേലിന്റെ അധിപന്മാർ"},"ref":[32,3,1]},{"q":{"en":"What are the heads of Jacob supposed to know?","ta":"யாக்கோபின் தலைவர்கள் எதை அறிய வேண்டும்?","ml":"യാക്കോബിന്റെ തലവന്മാർ എന്തു അറിയേണ്ടതാണ്?"},"a":{"en":"Judgment","ta":"நியாயம்","ml":"ന്യായം"},"ref":[32,3,1]},{"q":{"en":"What do the leaders hate?","ta":"தலைவர்கள் எதை வெறுக்கிறார்கள்?","ml":"നേതാക്കൾ എന്തിനെ ദ്വേഷിക്കുന്നു?"},"a":{"en":"The good","ta":"நன்மை","ml":"നന്മ"},"ref":[32,3,2]},{"q":{"en":"What do the leaders love?","ta":"தலைவர்கள் எதை விரும்புகிறார்கள்?","ml":"നേതാക്കൾ എന്തിനെ ഇച്ഛിക്കുന്നു?"},"a":{"en":"The evil","ta":"தீமை","ml":"തിന്മ"},"ref":[32,3,2]},{"q":{"en":"What do they pluck from the people's bones?","ta":"அவர்கள் எலும்புகள்மேல் இருக்கிற எதைப் பிடுங்குகிறார்கள்?","ml":"അവർ അസ്ഥികളിൽനിന്നു എന്തു പറിച്ചുകളയുന്നു?"},"a":{"en":"Their flesh","ta":"சதை","ml":"മാംസം"},"ref":[32,3,2]},{"q":{"en":"Whose flesh do the leaders eat?","ta":"தலைவர்கள் யாருடைய சதையைத் தின்கிறார்கள்?","ml":"നേതാക്കൾ ആരുടെ മാംസം തിന്നുന്നു?"},"a":{"en":"My people's","ta":"என் ஜனத்தின்","ml":"എന്റെ ജനത്തിന്റെ"},"ref":[32,3,3]},{"q":{"en":"What do they break of the people?","ta":"அவர்கள் எவைகளை முறிக்கிறார்கள்?","ml":"അവർ എന്തിനെ ഒടിക്കുന്നു?"},"a":{"en":"Their bones","ta":"எலும்புகள்","ml":"അസ്ഥികളെ"},"ref":[32,3,3]},{"q":{"en":"Into what do they chop the people like flesh?","ta":"எதிலே போடும்வண்ணமாகத் துண்டிக்கிறார்கள்?","ml":"ഏതിൽ ഇടുവാൻ എന്നപോലെ മുറിച്ചുകളയുന്നു?"},"a":{"en":"The pot","ta":"பானை","ml":"കലം"},"ref":[32,3,3]},{"q":{"en":"To whom will they cry?","ta":"அவர்கள் யாரை நோக்கிக் கூப்பிடுவார்கள்?","ml":"അവർ ആരോടു നിലവിളിക്കും?"},"a":{"en":"The LORD","ta":"கர்த்தர்","ml":"യഹോവ"},"ref":[32,3,4]},{"q":{"en":"What will the LORD hide from them at that time?","ta":"கர்த்தர் அக்காலத்தில் எதை மறைத்துக்கொள்வார்?","ml":"യഹോവ ആ കാലത്തു എന്തു മറെക്കും?"},"a":{"en":"His face","ta":"தமது முகம்","ml":"തന്റെ മുഖം"},"ref":[32,3,4]},{"q":{"en":"Why will the LORD hide his face from them?","ta":"கர்த்தர் ஏன் முகத்தை மறைத்துக்கொள்வார்?","ml":"യഹോവ എന്തുകൊണ്ടു മുഖം മറെക്കും?"},"a":{"en":"They behaved themselves ill in their doings","ta":"கிரியைகளில் பொல்லாதவர்களானபடியினால்","ml":"ദുഷ്‌പ്രവൃത്തികളെ ചെയ്തതിനാൽ"},"ref":[32,3,4]},{"q":{"en":"Concerning whom does the LORD speak in verse five?","ta":"கர்த்தர் யாருக்கு விரோதமாகப் பேசுகிறார்?","ml":"യഹോവ ആരെക്കുറിച്ചു അരുളിച്ചെയ്യുന്നു?"},"a":{"en":"The prophets that make my people err","ta":"என் ஜனத்தை மோசம்போக்குகிற தீர்க்கதரிசிகள்","ml":"ജനത്തെ തെറ്റിക്കുന്ന പ്രവാചകന്മാർ"},"ref":[32,3,5]},{"q":{"en":"What do the false prophets cry when they have food to bite?","ta":"பொய் தீர்க்கதரிசிகள் என்ன சொல்லுகிறார்கள்?","ml":"വ്യാജപ്രവാചകന്മാർ എന്തു പ്രസംഗിക്കുന്നു?"},"a":{"en":"Peace","ta":"சமாதானம்","ml":"സമാധാനം"},"ref":[32,3,5]},{"q":{"en":"Against whom do they prepare war?","ta":"யாருக்கு விரோதமாகச் சண்டைக்கு ஆயத்தம்பண்ணுகிறார்கள்?","ml":"ആരുടെ നേരെ യുദ്ധം ഘോഷിക്കുന്നു?"},"a":{"en":"He that putteth not into their mouths","ta":"வாய்க்கு உணவைக்கொடாதவனுக்கு","ml":"വായിൽ ഒന്നും ഇട്ടുകൊടുക്കാത്തവന്റെ"},"ref":[32,3,5]},{"q":{"en":"What shall come to the prophets so they shall not have a vision?","ta":"தரிசனங்காணக் கூடாதபடி எது வரும்?","ml":"ദർശനമില്ലാത്ത എന്തു വരും?"},"a":{"en":"Night","ta":"இராத்திரி","ml":"രാത്രി"},"ref":[32,3,6]},{"q":{"en":"What shall go down over the prophets?","ta":"தீர்க்கதரிசிகளின்மேல் எது அஸ்தமிக்கும்?","ml":"പ്രവാചകന്മാർക്കു എന്തു അസ്തമിക്കും?"},"a":{"en":"The sun","ta":"சூரியன்","ml":"സൂര്യൻ"},"ref":[32,3,6]},{"q":{"en":"What shall be dark over the prophets?","ta":"தீர்க்கதரிசிகளின்மேல் எது காரிருளாய்ப் போகும்?","ml":"പ്രവാചകന്മാർക്കു എന്തു ഇരുണ്ടുപോകും?"},"a":{"en":"The day","ta":"பகல்","ml":"പകൽ"},"ref":[32,3,6]},{"q":{"en":"Who shall be ashamed?","ta":"யார் வெட்கப்படுவார்கள்?","ml":"ആർ ലജ്ജിക്കും?"},"a":{"en":"The seers","ta":"தரிசனம் பார்க்கிறவர்கள்","ml":"ദർശകന്മാർ"},"ref":[32,3,7]},{"q":{"en":"Who shall be confounded?","ta":"யார் நாணுவார்கள்?","ml":"ആർ നാണിക്കും?"},"a":{"en":"The diviners","ta":"குறிசொல்லுகிறவர்கள்","ml":"ലക്ഷണം പറയുന്നവർ"},"ref":[32,3,7]},{"q":{"en":"What will they all cover?","ta":"அவர்கள் எல்லாரும் எதை மூடுவார்கள்?","ml":"അവർ ഒക്കെയും എന്തു പൊത്തും?"},"a":{"en":"Their lips","ta":"தங்கள் வாயை","ml":"വായ്"},"ref":[32,3,7]},{"q":{"en":"Why will the seers cover their lips?","ta":"அவர்கள் ஏன் வாயை மூடுவார்கள்?","ml":"അവർ എന്തുകൊണ്ടു വായ് പൊത്തും?"},"a":{"en":"There is no answer of God","ta":"உத்தரவுகொடுக்கிற தேவன் இல்லாததினால்","ml":"ദൈവത്തിന്റെ ഉത്തരം ഇല്ലായ്കകൊണ്ടു"},"ref":[32,3,7]},{"q":{"en":"By what is Micah full of power?","ta":"மீகா எதினால் பலத்தினால் நிரப்பப்பட்டிருக்கிறான்?","ml":"മീഖാ എന്തിനാൽ ശക്തിയാൽ നിറഞ്ഞിരിക്കുന്നു?"},"a":{"en":"The spirit of the LORD","ta":"கர்த்தருடைய ஆவி","ml":"യഹോവയുടെ ആത്മാവു"},"ref":[32,3,8]},{"q":{"en":"What is Micah full of besides power?","ta":"பலத்தோடு மீகா வேறு எதினால் நிரப்பப்பட்டிருக்கிறான்?","ml":"ശക്തിയോടൊപ്പം മീഖാ എന്തിനാൽ നിറഞ്ഞിരിക്കുന്നു?"},"a":{"en":"Judgment and might","ta":"நியாயம், பராக்கிரமம்","ml":"ന്യായവും വീര്യവും"},"ref":[32,3,8]},{"q":{"en":"What did Micah declare to Jacob?","ta":"மீகா யாக்கோபுக்கு எதை அறிவிப்பான்?","ml":"മീഖാ യാക്കോബ