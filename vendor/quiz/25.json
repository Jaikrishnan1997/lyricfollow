[{"q":{"en":"How does the city that was full of people sit now?","ta":"ஜனம்பெருத்த நகரி இப்போது எப்படி உட்கார்ந்திருக்கிறாள்?","ml":"ജനപൂർണ്ണയായിരുന്ന നഗരം ഇപ്പോൾ എങ്ങനെ ഇരിക്കുന്നു?"},"a":{"en":"Solitary","ta":"தனிமையாக","ml":"ഏകാന്തയായി"},"ref":[24,1,1]},{"q":{"en":"To whom is the city that was full of people compared in Lamentations 1?","ta":"ஜனம்பெருத்த நகரி யாருக்கு ஒப்பானாள்?","ml":"ജനപൂർണ്ണയായിരുന്ന നഗരം ആരെപ്പോലെ ആയി?"},"a":{"en":"A widow","ta":"விதவைக்கு","ml":"വിധവയെപ്പോലെ"},"ref":[24,1,1]},{"q":{"en":"What did the princess among the provinces become?","ta":"சீமைகளில் நாயகியாயிருந்தவள் என்னவானாள்?","ml":"സംസ്ഥാനങ്ങളുടെ നായകിയായിരുന്നവൾ എന്തായി?"},"a":{"en":"Tributary","ta":"கப்பங்கட்டுகிறவள்","ml":"ഊഴിയവേലക്കാരത്തി"},"ref":[24,1,1]},{"q":{"en":"When does the city weep sore?","ta":"நகரி எப்போது அழுதுகொண்டிருக்கிறாள்?","ml":"നഗരം എപ്പോൾ കരഞ്ഞുകൊണ്ടിരിക്കുന്നു?"},"a":{"en":"In the night","ta":"இராக்காலத்திலே","ml":"രാത്രിയിൽ"},"ref":[24,1,2]},{"q":{"en":"Where do her tears run?","ta":"அவளுடைய கண்ணீர் எங்கே வடிகிறது?","ml":"അവളുടെ കണ്ണുനീർ എവിടെ കാണുന്നു?"},"a":{"en":"On her cheeks","ta":"கன்னங்களில்","ml":"കവിൾത്തടങ്ങളിൽ"},"ref":[24,1,2]},{"q":{"en":"What did all her friends become to her?","ta":"அவளுடைய சிநேகிதர் அவளுக்கு என்னவானார்கள்?","ml":"അവളുടെ സ്നേഹിതന്മാർ അവൾക്കു എന്തായി?"},"a":{"en":"Enemies","ta":"சத்துருக்கள்","ml":"ശത്രുക്കൾ"},"ref":[24,1,2]},{"q":{"en":"Who has gone into captivity because of affliction and great servitude?","ta":"உபத்திரவத்தினாலும் அடிமைவேலையினாலும் சிறைப்பட்டுப்போனது யார்?","ml":"കഷ്ടതയും കഠിനദാസ്യവും നിമിത്തം പ്രവാസത്തിലേക്കു പോയത് ആര്?"},"a":{"en":"Judah","ta":"யூதா","ml":"യെഹൂദാ"},"ref":[24,1,3]},{"q":{"en":"Among whom does Judah dwell, finding no rest?","ta":"யூதா யாருக்குள்ளே தங்குகிறாள்?","ml":"യെഹൂദാ ആരുടെ ഇടയിൽ പാർക്കുന്നു?"},"a":{"en":"Among the heathen","ta":"புறஜாதிகளுக்குள்ளே","ml":"ജാതികളുടെ"},"ref":[24,1,3]},{"q":{"en":"Where did all her persecutors overtake her?","ta":"அவளைத் துன்பப்படுத்துகிறவர்கள் எங்கே தொடர்ந்துபிடித்தார்கள்?","ml":"അവളെ പിന്തുടരുന്നവർ അവളെ എവിടെവെച്ചു പിടിച്ചു?"},"a":{"en":"Between the straits","ta":"இடுக்கமான இடங்களிலே","ml":"ഇടുക്കിടങ്ങളിൽ"},"ref":[24,1,3]},{"q":{"en":"Why do the ways of Zion mourn?","ta":"சீயோனுக்குப் போகிற வழிகள் ஏன் புலம்புகிறது?","ml":"സീയോനിലേക്കുള്ള വഴികൾ എന്തുകൊണ്ട് ദുഃഖിക്കുന്നു?"},"a":{"en":"None come to the solemn feasts","ta":"பண்டிகைக்கு வருவார் இல்லாததினால்","ml":"ഉത്സവത്തിന്നു ആരും വരായ്കകൊണ്ടു"},"ref":[24,1,4]},{"q":{"en":"Who sigh in Zion in Lamentations 1:4?","ta":"சீயோனில் தவிக்கிறவர்கள் யார்?","ml":"സീയോനിൽ നെടുവീർപ്പിടുന്നവർ ആര്?"},"a":{"en":"Her priests","ta":"ஆசாரியர்கள்","ml":"പുരോഹിതന്മാർ"},"ref":[24,1,4]},{"q":{"en":"Who are afflicted in Zion besides the priests?","ta":"ஆசாரியர்களோடு சஞ்சலப்படுகிறவர்கள் யார்?","ml":"പുരോഹിതന്മാരെ കൂടാതെ ഖേദിക്കുന്നവർ ആര്?"},"a":{"en":"Her virgins","ta":"கன்னிகைகள்","ml":"കന്യകമാർ"},"ref":[24,1,4]},{"q":{"en":"Who became the chief while her enemies prospered?","ta":"சீயோனில் தலைமையானவர்கள் யார்?","ml":"അവളുടെ കാര്യത്തിൽ പ്രാധാന്യം ലഭിച്ചവർ ആര്?"},"a":{"en":"Her adversaries","ta":"சத்துருக்கள்","ml":"വൈരികൾ"},"ref":[24,1,5]},{"q":{"en":"Who afflicted Jerusalem for the multitude of her transgressions?","ta":"திரளான பாதகங்களினிமித்தம் அவளைச் சஞ்சலப்படுத்தியவர் யார்?","ml":"അതിക്രമബാഹുല്യംനിമിത്തം അവൾക്കു സങ്കടം വരുത്തിയവൻ ആര്?"},"a":{"en":"The LORD","ta":"கர்த்தர்","ml":"യഹോവ"},"ref":[24,1,5]},{"q":{"en":"Where did her children go before the enemy?","ta":"அவள் பிள்ளைகள் சத்துருவுக்கு முன்பாக எங்கே போனார்கள்?","ml":"അവളുടെ കുഞ്ഞുങ്ങൾ വൈരിയുടെ മുമ്പായി എവിടേക്കു പോയി?"},"a":{"en":"Into captivity","ta":"சிறைப்பட்டுப்போனார்கள்","ml":"പ്രവാസത്തിലേക്കു"},"ref":[24,1,5]},{"q":{"en":"What has departed from the daughter of Zion?","ta":"சீயோன் குமாரத்தியை விட்டுப்போனது என்ன?","ml":"സീയോൻ പുത്രിയെ വിട്ടുപോയത് എന്ത്?"},"a":{"en":"All her beauty","ta":"அழகெல்லாம்","ml":"മഹത്വമൊക്കെയും"},"ref":[24,1,6]},{"q":{"en":"To what are her princes compared in Lamentations 1:6?","ta":"சீயோனின் பிரபுக்கள் எதற்கு ஒப்பாகினார்கள்?","ml":"സീയോന്റെ പ്രഭുക്കന്മാർ എന്തിനെപ്പോലെ ആയി?"},"a":{"en":"Harts that find no pasture","ta":"மேய்ச்சலைக் காணாத மான்களுக்கு","ml":"മേച്ചൽ കാണാത്ത മാനുകളെപ്പോലെ"},"ref":[24,1,6]},{"q":{"en":"What did Jerusalem remember in the days of her affliction?","ta":"துன்ப நாட்களிலே எருசலேம் எதை நினைக்கிறாள்?","ml":"കഷ്ടകാലത്തു യെരൂശലേം എന്തിനെ ഓർക്കുന്നു?"},"a":{"en":"Her pleasant things of old","ta":"இன்பமானவைகளையெல்லாம்","ml":"മനോഹരവസ്തുക്കളെ"},"ref":[24,1,7]},{"q":{"en":"At what did the adversaries mock Jerusalem?","ta":"பகைஞர் எருசலேமின் எதைக்குறித்துப் பரியாசம்பண்ணினார்கள்?","ml":"വൈരികൾ യെരൂശലേമിന്റെ എന്തിനെക്കുറിച്ചു ചിരിച്ചു?"},"a":{"en":"Her sabbaths","ta":"ஓய்வுநாட்களை","ml":"നാശത്തെ"},"ref":[24,1,7]},{"q":{"en":"What has Jerusalem done, therefore she is removed?","ta":"எருசலேம் மிகுதியாய் என்ன செய்தாள்?","ml":"യെരൂശലേം കഠിനമായി എന്തു ചെയ്തു?"},"a":{"en":"Grievously sinned","ta":"பாவஞ்செய்தாள்","ml":"പാപം"},"ref":[24,1,8]},{"q":{"en":"Why do all that honoured Jerusalem despise her?","ta":"எருசலேமைக் கனம்பண்ணினவர்கள் ஏன் அவளை அசட்டைப்பண்ணுகிறார்கள்?","ml":"യെരൂശലേമിനെ ബഹുമാനിച്ചവർ എന്തുകൊണ്ട് അവളെ നിന്ദിക്കുന്നു?"},"a":{"en":"They have seen her nakedness","ta":"அவளுடைய மானத்தைக் கண்டார்கள்","ml":"അവളുടെ നഗ്നത കണ്ടിട്ടു"},"ref":[24,1,8]},{"q":{"en":"Where is her filthiness?","ta":"அவளுடைய அசூசம் எங்கே இருந்தது?","ml":"അവളുടെ മലിനത എവിടെ കാണുന്നു?"},"a":{"en":"In her skirts","ta":"வஸ்திர ஓரங்களில்","ml":"ഉടുപ്പിന്റെ വിളുമ്പിൽ"},"ref":[24,1,9]},{"q":{"en":"What did she not remember, so she came down wonderfully?","ta":"அவள் எதை நினையாதிருந்தாள்?","ml":"അവൾ എന്തു ഓർത്തില്ല?"},"a":{"en":"Her last end","ta":"வரப்போகிற முடிவை","ml":"ഭാവികാലം"},"ref":[24,1,9]},{"q":{"en":"To whom does the writer say, behold my affliction?","ta":"என் சிறுமையைப் பாரும் என்று யாரிடம் கூப்பிடப்படுகிறது?","ml":"എന്റെ സങ്കടം നോക്കേണമേ എന്നു ആരോടു പറയുന്നു?"},"a":{"en":"The LORD","ta":"கர்த்தாவே","ml":"യഹോവേ"},"ref":[24,1,9]},{"q":{"en":"Who has spread out his hand upon all her pleasant things?","ta":"அவளுடைய இன்பமான எல்லாவற்றின்மேலும் கையை நீட்டியவன் யார்?","ml":"അവളുടെ മനോഹരവസ്തുക്കളിന്മേൽ കൈവെച്ചവൻ ആര്?"},"a":{"en":"The adversary","ta":"சத்துரு","ml":"വൈരി"},"ref":[24,1,10]},{"q":{"en":"Who entered her sanctuary, though God commanded they should not enter His congregation?","ta":"தேவன் விலக்கியும் பரிசுத்த ஸ்தலத்துக்குள் பிரவேசித்தவர்கள் யார்?","ml":"സഭയിൽ പ്രവേശിക്കരുതെന്നു കല്പിച്ചിട്ടും വിശുദ്ധമന്ദിരത്തിൽ കടന്നവർ ആര്?"},"a":{"en":"The heathen","ta":"புறஜாதியார்","ml":"ജാതികൾ"},"ref":[24,1,10]},{"q":{"en":"What do all her people seek as they sigh?","ta":"ஜனங்களெல்லாரும் தவித்து எதைத் தேடுகிறார்கள்?","ml":"ജനമെല്ലാം നെടുവീർപ്പിട്ടു എന്തു തിരയുന്നു?"},"a":{"en":"Bread","ta":"அப்பம்","ml":"ആഹാരം"},"ref":[24,1,11]},{"q":{"en":"What did the people give for food to relieve the soul?","ta":"உயிரைக் காப்பாற்ற ஆகாரத்துக்கென்று அவர்கள் எதைக் கொடுத்தார்கள்?","ml":"വിശപ്പടക്കുവാൻ ആഹാരത്തിന്നു വേണ്ടി അവർ എന്തു കൊടുത്തുകളഞ്ഞു?"},"a":{"en":"Their pleasant things","ta":"இன்பமானவைகளை","ml":"മനോഹര വസ്തുക്കളെ"},"ref":[24,1,11]},{"q":{"en":"Whom does the writer ask whether it is nothing to them?","ta":"இதைக்குறித்து உங்களுக்குக் கவலையில்லையா என்று யாரிடம் கேட்கப்படுகிறது?","ml":"ഇതു നിങ്ങൾക്കു ഏതുമില്ലയോ എന്നു ആരോടു ചോദിക്കുന്നു?"},"a":{"en":"All ye that pass by","ta":"நடந்துபோகிற சகல ஜனங்களே","ml":"കടന്നുപോകുന്ന ഏവരുമായുള്ളോരേ"},"ref":[24,1,12]},{"q":{"en":"In which day did the LORD afflict her?","ta":"கர்த்தர் எந்த நாளிலே அவளைச் சஞ்சலப்படுத்தினார்?","ml":"യഹോവ ഏതു ദിവസത്തിൽ അവളെ ദുഃഖിപ്പിച്ചു?"},"a":{"en":"The day of his fierce anger","ta":"உக்கிரமான கோபமூண்ட நாளிலே","ml":"ഉഗ്രകോപദിവസത്തിൽ"},"ref":[24,1,12]},{"q":{"en":"What did he send from above into my bones?","ta":"உயரத்திலிருந்து என் எலும்புகளில் அவர் எதை அனுப்பினார்?","ml":"ഉയരത്തിൽനിന്നു എന്റെ അസ്ഥികളിൽ അവൻ എന്തു അയച്ചു?"},"a":{"en":"Fire","ta":"அக்கினியை","ml":"തീ"},"ref":[24,1,13]},{"q":{"en":"What did he spread for my feet?","ta":"என் கால்களுக்கு அவர் எதை வீசினார்?","ml":"എന്റെ കാലിന്നു അവൻ എന്തു വിരിച്ചു?"},"a":{"en":"A net","ta":"வலையை","ml":"വല"},"ref":[24,1,13]},{"q":{"en":"What is bound by his hand and wreathed upon my neck?","ta":"அவருடைய கையால் பூட்டப்பட்டு என் கழுத்தைச் சுற்றிக்கொண்டது எது?","ml":"അവൻ പിണെച്ചു എന്റെ കഴുത്തിൽ പിണെഞ്ഞിരിക്കുന്നത് എന്ത്?"},"a":{"en":"The yoke of my transgressions","ta":"பாதகங்களின் நுகம்","ml":"അതിക്രമങ്ങളുടെ നുകം"},"ref":[24,1,14]},{"q":{"en":"What did the Lord tread under foot in the midst of her?","ta":"ஆண்டவர் மிதித்துப்போட்டவர்கள் யார்?","ml":"കർത്താവു തന്റെ നടുവിൽ നിരസിച്ചുകളഞ്ഞവർ ആര്?"},"a":{"en":"All her mighty men","ta":"பராக்கிரமசாலிகளை","ml":"ബലവാന്മാരെ"},"ref":[24,1,15]},{"q":{"en":"Whom has the Lord trodden as in a winepress?","ta":"ஆண்டவர் திராட்சப்பழத்தை ஆலையில் மிதிக்கிறதுபோல யாரை மிதித்தார்?","ml":"കർത്താവു ചക്കിൽ ഇട്ടു ചവിട്ടിക്കളഞ്ഞതാരെ?"},"a":{"en":"The virgin, the daughter of Judah","ta":"யூதா குமாரத்தியாகிய கன்னிகையை","ml":"യെഹൂദാപുത്രിയായ കന്യകയെ"},"ref":[24,1,15]},{"q":{"en":"What runs down with water because the comforter is far away?","ta":"ஆறுதல் செய்பவர் தூரமானதால் நீராய்ச் சொரிவது எது?","ml":"ആശ്വാസപ്രദൻ അകന്നിരിക്കയാൽ കണ്ണുനീരൊഴുക്കുന്നത് എന്ത്?"},"a":{"en":"Mine eye","ta":"என் கண்","ml":"എന്റെ കണ്ണു"},"ref":[24,1,16]},{"q":{"en":"Why are my children desolate?","ta":"என் பிள்ளைகள் ஏன் பாழாய்ப்போனார்கள்?","ml":"എന്റെ മക്കൾ എന്തുകൊണ്ട് നശിച്ചിരിക്കുന്നു?"},"a":{"en":"Because the enemy prevailed","ta":"பகைஞன் மேற்கொண்டதினால்","ml":"ശത്രു പ്രബലനായിരിക്കയാൽ"},"ref":[24,1,16]},{"q":{"en":"What does Zion spread forth with none to comfort her?","ta":"ஆறுதல் செய்வார் இல்லாத சீயோன் எதை விரிக்கிறாள்?","ml":"ആശ്വസിപ്പിപ്പാൻ ആരുമില്ലാത്ത സീയോൻ എന്തു മലർത്തുന്നു?"},"a":{"en":"Her hands","ta":"கைகளை","ml":"കൈ"},"ref":[24,1,17]},{"q":{"en":"Concerning whom has the LORD commanded that his adversaries be round about him?","ta":"கர்த்தர் யாருக்கு விரோதமாக சுற்றுப்புறத்தாரைக் கட்டளையிட்டார்?","ml":"യഹോവ ആർക്കു ചുറ്റും വൈരികളെ കല്പിച്ചാക്കി?"},"a":{"en":"Jacob","ta":"யாக்கோபு","ml":"യാക്കോബിന്നു"},"ref":[24,1,17]},{"q":{"en":"How does the writer describe the LORD?","ta":"கர்த்தர் எப்படிப்பட்டவர் என்று சொல்லப்படுகிறது?","ml":"യഹോവ എങ്ങനെയുള്ളവൻ എന്നു പറയുന്നു?"},"a":{"en":"Righteous","ta":"நீதிபரர்","ml":"നീതിമാൻ"},"ref":[24,1,18]},{"q":{"en":"Against what did the writer rebel?","ta":"எவருடைய வாக்குக்கு விரோதமாய் எழும்பினேன்?","ml":"ഞാൻ എന്തിനോടു മത്സരിച്ചു?"},"a":{"en":"His commandment","ta":"அவருடைய வாக்குக்கு","ml":"കല്പനയോടു"},"ref":[24,1,18]},{"q":{"en":"Whom did I call for, but they deceived me?","ta":"நான் கூப்பிட்டும் மோசம் போக்கியவர்கள் யார்?","ml":"ഞാൻ വിളിച്ചിട്ടും ചതിച്ചവർ ആര്?"},"a":{"en":"My lovers","ta":"சிநேகித்தவர்கள்","ml":"പ്രിയന്മാർ"},"ref":[24,1,19]},{"q":{"en":"Who gave up the ghost in the city while seeking food?","ta":"நகரத்தில் அப்பந்தேடுகையில் மாண்டவர்கள் யார்?","ml":"നഗരത്തിൽ ആഹാരം തിരഞ്ഞുനടക്കുമ്പോൾ പ്രാണനെ വിട്ടവർ ആര്?"},"a":{"en":"Priests and elders","ta":"ஆசாரியர்களும் மூப்பர்களும்","ml":"പുരോഹിതന്മാരും മൂപ്പന്മാരും"},"ref":[24,1,19]},{"q":{"en":"What is troubled and what is turned within me because of rebellion?","ta":"கொதிக்கிறது எது, வியாகுலப்படுகிறது எது?","ml":"കലങ്ങിയിരിക്കുന്നതും മറിഞ്ഞിരിക്കുന്നതും എന്ത്?"},"a":{"en":"My bowels and my heart","ta":"குடல், இருதயம்","ml":"ഉള്ളം, ഹൃദയം"},"ref":[24,1,20]},{"q":{"en":"What bereaves abroad while at home there is as death?","ta":"வெளியிலே பிள்ளையற்றவளாக்குவது எது?","ml":"പുറമേ സന്തതിനാശം വരുത്തുന്നത് എന്ത്?"},"a":{"en":"The sword","ta":"பட்டயம்","ml":"വാൾ"},"ref":[24,1,20]},{"q":{"en":"What are all the enemies glad about?","ta":"பகைஞர் எல்லாரும் எதினால் சந்தோஷமாயிருக்கிறார்கள்?","ml":"ശത്രുക്കളൊക്കെയും എന്തുകൊണ്ട് സന്തോഷിക്കുന്നു?"},"a":{"en":"That thou hast done it","ta":"தேவரீர் அதைச் செய்தபடியால்","ml":"നീ അതു വരുത്തിയതുകൊണ്ടു"},"ref":[24,1,21]},{"q":{"en":"What does the writer ask to come before God?","ta":"கர்த்தர் முன்பாக வரக்கடவது என்று கேட்கப்படுவது என்ன?","ml":"തിരുമുമ്പിൽ വരട്ടെ എന്നു പറയുന്നത് എന്ത്?"},"a":{"en":"All their wickedness","ta":"பொல்லாப்பெல்லாம்","ml":"ദുഷ്ടതയൊക്കെയും"},"ref":[24,1,22]},{"q":{"en":"What is faint, according to the writer?","ta":"பலட்சயமாயிருப்பது எது?","ml":"രോഗാർത്തമായിരിക്കുന്നത് എന്ത്?"},"a":{"en":"My heart","ta":"என் இருதயம்","ml":"എന്റെ ഹൃദയം"},"ref":[24,1,22]},{"q":{"en":"What has the Lord covered the daughter of Zion with in his anger?","ta":"ஆண்டவர் தமது கோபத்தில் சீயோன் குமாரத்தியை எதினால் மூடினார்?","ml":"യഹോവ കോപത്തിൽ സീയോൻ പുത്രിയെ എന്തുകൊണ്ടു മറെച്ചു?"},"a":{"en":"A cloud","ta":"மந்தாரத்தினால்","ml":"മേഘംകൊണ്ടു"},"ref":[24,2,1]},{"q":{"en":"What did the Lord cast down from heaven to the earth?","ta":"ஆண்டவர் வானத்திலிருந்து தரையிலே விழத்தள்ளியது எது?","ml":"യഹോവ ആകാശത്തുനിന്നു ഭൂമിയിൽ ഇട്ടുകളഞ്ഞത് എന്ത്?"},"a":{"en":"The beauty of Israel","ta":"இஸ்ரவேலின் மகிமையை","ml":"യിസ്രായേലിന്റെ മഹത്വം"},"ref":[24,2,1]},{"q":{"en":"What did the Lord not remember in the day of his anger?","ta":"கோபத்தின் நாளிலே ஆண்டவர் எதை நினையாமல்போனார்?","ml":"കോപദിവസത്തിൽ അവൻ എന്തിനെ ഓർത്തില്ല?"},"a":{"en":"His footstool","ta":"பாதபீடத்தை","ml":"പാദപീഠത്തെ"},"ref":[24,2,1]},{"q":{"en":"Whose habitations has the Lord swallowed up without pity?","ta":"ஆண்டவர் யாருடைய வாசஸ்தலங்களை விழுங்கினார்?","ml":"കർത്താവു ആരുടെ മേച്ചൽപുറങ്ങളെ നശിപ്പിച്ചു?"},"a":{"en":"Jacob's","ta":"யாக்கோபின்","ml":"യാക്കോബിന്റെ"},"ref":[24,2,2]},{"q":{"en":"What did he throw down in his wrath, belonging to the daughter of Judah?","ta":"யூதா குமாரத்தியின் எதைத் தமது சினத்திலே இடித்துப்போட்டார்?","ml":"യെഹൂദാപുത്രിയുടെ എന്തിനെ അവൻ ഇടിച്ചുകളഞ്ഞു?"},"a":{"en":"Her strong holds","ta":"அரண்களை","ml":"കോട്ടകളെ"},"ref":[24,2,2]},{"q":{"en":"What did he cut off in his fierce anger?","ta":"உக்கிரகோபத்திலே அவர் எதை வெட்டிப்போட்டார்?","ml":"ഉഗ്രകോപത്തിൽ അവൻ എന്തു വെട്ടിക്കളഞ്ഞു?"},"a":{"en":"All the horn of Israel","ta":"இஸ்ரவேலின் கொம்பு முழுவதையும்","ml":"യിസ്രായേലിന്റെ കൊമ്പു"},"ref":[24,2,3]},{"q":{"en":"Against whom did he burn like a flaming fire?","ta":"அக்கினிஜுவாலையைப்போல் யாருக்கு விரோதமாக எரித்தார்?","ml":"ജ്വാലപോലെ അവൻ ആരെ ദഹിപ്പിച്ചു?"},"a":{"en":"Jacob","ta":"யாக்கோபுக்கு","ml":"യാക്കോബിനെ"},"ref":[24,2,3]},{"q":{"en":"What did he bend like an enemy?","ta":"பகைஞனைப்போல் அவர் எதை நாணேற்றினார்?","ml":"ശത്രു എന്നപോലെ അവൻ എന്തു കുലെച്ചു?"},"a":{"en":"His bow","ta":"வில்லை","ml":"വില്ലു"},"ref":[24,2,4]},{"q":{"en":"In whose tabernacle did he pour out his fury like fire?","ta":"யாருடைய கூடாரத்திலே தம்முடைய உக்கிரத்தைச் சொரியப்பண்ணினார்?","ml":"ആരുടെ കൂടാരത്തിൽ അവൻ ക്രോധം ചൊരിഞ്ഞു?"},"a":{"en":"The daughter of Zion","ta":"சீயோன் குமாரத்தியின்","ml":"സീയോൻ പുത്രിയുടെ"},"ref":[24,2,4]},{"q":{"en":"Who was as an enemy and swallowed up Israel?","ta":"பகைஞன்போலாகி இஸ்ரவேலை விழுங்கியவர் யார்?","ml":"ശത്രുവിനെപ്പോലെ ആയി യിസ്രായേലിനെ മുടിച്ചവൻ ആര്?"},"a":{"en":"The Lord","ta":"ஆண்டவர்","ml":"കർത്താവു"},"ref":[24,2,5]},{"q":{"en":"What did he increase in the daughter of Judah?","ta":"யூதா குமாரத்திக்கு அவர் எதை மிகுதியாக்கினார்?","ml":"യെഹൂദാപുത്രിക്കു അവൻ എന്തു വർദ്ധിപ്പിച്ചു?"},"a":{"en":"Mourning and lamentation","ta":"துக்கிப்பையும் சலிப்பையும்","ml":"ദുഃഖവും വിലാപവും"},"ref":[24,2,5]},{"q":{"en":"What did the LORD cause to be forgotten in Zion?","ta":"கர்த்தர் சீயோனிலே எவைகளை மறக்கப்பண்ணினார்?","ml":"യഹോവ സീയോനിൽ എന്തു മറക്കുമാറാക്കി?"},"a":{"en":"The solemn feasts and sabbaths","ta":"பண்டிகையையும் ஓய்வுநாளையும்","ml":"ഉത്സവവും ശബ്ബത്തും"},"ref":[24,2,6]},{"q":{"en":"Whom did the LORD despise in the indignation of his anger?","ta":"கர்த்தர் உக்கிரமான கோபத்தில் யாரைப் புறக்கணித்துவிட்டார்?","ml":"യഹോവ ഉഗ്രകോപത്തിൽ ആരെ നിരസിച്ചുകളഞ്ഞു?"},"a":{"en":"The king and the priest","ta":"ராஜாவையும் ஆசாரியனையும்","ml":"രാജാവിനെയും പുരോഹിതനെയും"},"ref":[24,2,6]},{"q":{"en":"What did the Lord cast off and what did he abhor?","ta":"ஆண்டவர் ஒழித்துவிட்டதும் வெறுத்துவிட்டதும் எவை?","ml":"കർത്താവു തള്ളിക്കളഞ്ഞതും വെറുത്തതും എന്തു?"},"a":{"en":"His altar and his sanctuary","ta":"பலிபீடம், பரிசுத்த ஸ்தலம்","ml":"യാഗപീഠം, വിശുദ്ധമന്ദിരം"},"ref":[24,2,7]},{"q":{"en":"Where did the enemies make a noise as in the day of a solemn feast?","ta":"பண்டிகை நாளில் ஆரவாரம்பண்ணுகிறதுபோல் சத்துருக்கள் எங்கே ஆரவாரம்பண்ணினார்கள்?","ml":"ശത്രുക്കൾ ഉത്സവത്തിൽ എന്നപോലെ എവിടെ ആരവം ഉണ്ടാക്കി?"},"a":{"en":"In the house of the LORD","ta":"கர்த்தரின் ஆலயத்தில்","ml":"യഹോവയുടെ ആലയത്തിൽ"},"ref":[24,2,7]},{"q":{"en":"What did the LORD purpose to destroy?","ta":"கர்த்தர் எதை நிர்மூலமாக்க நினைத்தார்?","ml":"യഹോവ എന്തു നശിപ്പിപ്പാൻ നിർണ്ണയിച്ചു?"},"a":{"en":"The wall of the daughter of Zion","ta":"சீயோன் குமாரத்தியின் அலங்கத்தை","ml":"സീയോൻ പുത്രിയുടെ മതിൽ"},"ref":[24,2,8]},{"q":{"en":"What did the LORD not withdraw from destroying?","ta":"அழிக்காதபடி கர்த்தர் எதை முடக்கிக்கொண்டதில்லை?","ml":"നശിപ്പിക്കുന്നതിൽനിന്നു യഹോവ എന്തു പിൻവലിച്ചില്ല?"},"a":{"en":"His hand","ta":"கையை","ml":"കൈ"},"ref":[24,2,8]},{"q":{"en":"What are sunk into the ground?","ta":"தரையில் அமிழ்ந்திக்கிடப்பவை எவை?","ml":"മണ്ണിൽ പൂണ്ടുപോയിരിക്കുന്നത് എന്ത്?"},"a":{"en":"Her gates","ta":"வாசல்கள்","ml":"വാതിലുകൾ"},"ref":[24,2,9]},{"q":{"en":"Where are her king and her princes?","ta":"அவள் ராஜாவும் பிரபுக்களும் எங்கே இருக்கிறார்கள்?","ml":"അവളുടെ രാജാവും പ്രഭുക്കന്മാരും എവിടെ ഇരിക്കുന്നു?"},"a":{"en":"Among the Gentiles","ta":"புறஜாதியாருக்குள்","ml":"ജാതികളുടെ ഇടയിൽ"},"ref":[24,2,9]},{"q":{"en":"What do her prophets not find from the LORD?","ta":"தீர்க்கதரிசிகளுக்குக் கர்த்தரால் கிடைக்காதது என்ன?","ml":"പ്രവാചകന്മാർക്കു യഹോവയിങ്കൽനിന്നു ഉണ്ടാകാത്തത് എന്ത്?"},"a":{"en":"A vision","ta":"தரிசனம்","ml":"ദർശനം"},"ref":[24,2,9]},{"q":{"en":"Who sit upon the ground and keep silence?","ta":"தரையில் உட்கார்ந்து மெளனமாய் இருப்பவர்கள் யார்?","ml":"നിലത്തിരുന്നു മിണ്ടാതിരിക്കുന്നവർ ആര്?"},"a":{"en":"The elders of the daughter of Zion","ta":"சீயோன் குமாரத்தியின் மூப்பர்கள்","ml":"സീയോൻ പുത്രിയുടെ മൂപ്പന്മാർ"},"ref":[24,2,10]},{"q":{"en":"What have the elders cast upon their heads?","ta":"மூப்பர்கள் தங்கள் தலைகளின்மேல் எதைப் போட்டுக்கொள்ளுகிறார்கள்?","ml":"മൂപ്പന്മാർ തലയിൽ എന്തു വാരിയിട്ടു?"},"a":{"en":"Dust","ta":"புழுதியை","ml":"പൊടി"},"ref":[24,2,10]},{"q":{"en":"What have the elders girded themselves with?","ta":"மூப்பர்கள் எதை உடுத்தியிருக்கிறார்கள்?","ml":"മൂപ്പന്മാർ എന്തു ഉടുത്തിരിക്കുന്നു?"},"a":{"en":"Sackcloth","ta":"இரட்டு","ml":"രട്ടു"},"ref":[24,2,10]},{"q":{"en":"Whose destruction makes the writer's eyes fail with tears?","ta":"யாருடைய நொறுங்குதலினிமித்தம் என் கண்கள் பூத்துப்போகிறது?","ml":"ആരുടെ നാശം നിമിത്തം എന്റെ കണ്ണു മങ്ങിപ്പോകുന്നു?"},"a":{"en":"The daughter of my people","ta":"என் ஜனமாகிய குமாரத்தியின்","ml":"എന്റെ ജനത്തിൻ പുത്രിയുടെ"},"ref":[24,2,11]},{"q":{"en":"Who swoon in the streets of the city?","ta":"நகரத்தின் வீதிகளிலே மூர்ச்சித்துக்கிடப்பவர்கள் யார்?","ml":"നഗരവീഥികളിൽ തളർന്നുകിടക്കുന്നവർ ആര്?"},"a":{"en":"The children and the sucklings","ta":"குழந்தைகளும் பாலகரும்","ml":"പൈതങ്ങളും ശിശുക്കളും"},"ref":[24,2,11]},{"q":{"en":"What do the children ask their mothers?","ta":"பிள்ளைகள் தங்கள் தாய்களிடம் என்ன கேட்கிறார்கள்?","ml":"കുഞ്ഞുങ്ങൾ അമ്മമാരോടു എന്തു ചോദിക്കുന്നു?"},"a":{"en":"Where is corn and wine","ta":"தானியமும் திராட்சரசமும் எங்கே","ml":"ആഹാരവും വീഞ്ഞും എവിടെ"},"ref":[24,2,12]},{"q":{"en":"Where was their soul poured out?","ta":"அவர்கள் பிராணனை எங்கே விடுகிறார்கள்?","ml":"അവർ പ്രാണൻ എവിടെവെച്ചു വിടുന്നു?"},"a":{"en":"Into their mothers' bosom","ta":"தாய்களின் மடியிலே","ml":"അമ്മമാരുടെ മാർവ്വിൽ"},"ref":[24,2,12]},{"q":{"en":"To what is the breach of the daughter of Zion likened?","ta":"சீயோனின் காயம் எதைப்போல் பெரிதாயிருக்கிறது?","ml":"സീയോന്റെ മുറിവു എന്തുപോലെ വലുതായിരിക്കുന്നു?"},"a":{"en":"The sea","ta":"சமுத்திரத்தைப்போல்","ml":"സമുദ്രംപോലെ"},"ref":[24,2,13]},{"q":{"en":"What did the prophets see for Zion that were vain and foolish?","ta":"தீர்க்கதரிசிகள் எவைகளைத் தரிசித்தார்கள்?","ml":"പ്രവാചകന്മാർ നിനക്കു എന്തു ദർശിച്ചു?"},"a":{"en":"False burdens and causes of banishment","ta":"அபத்தமும் வியர்த்தமுமான தரிசனங்களை","ml":"ഭോഷത്വവും വ്യാജവും"},"ref":[24,2,14]},{"q":{"en":"What do all that pass by do at the daughter of Jerusalem?","ta":"வழிப்போக்கர் யாவரும் என்ன செய்கிறார்கள்?","ml":"കടന്നുപോകുന്നവർ എന്തു ചെയ്യുന്നു?"},"a":{"en":"Clap their hands","ta":"கை கொட்டுகிறார்கள்","ml":"കൈ കൊട്ടുന്നു"},"ref":[24,2,15]},{"q":{"en":"What do the passers-by call the city of Jerusalem?","ta":"வழிப்போக்கர் எருசலேமை எப்படிப்பட்ட நகரம் என்கிறார்கள்?","ml":"വഴിപോക്കർ ഈ നഗരത്തെ എന്തു എന്നു വിളിച്ചുവന്നു?"},"a":{"en":"The perfection of beauty","ta":"பூரணவடிவும் மகிழ்ச்சியுமான","ml":"സൌന്ദര്യപൂർത്തി"},"ref":[24,2,15]},{"q":{"en":"What do the enemies do with their teeth?","ta":"பகைஞர் பற்களை என்ன செய்கிறார்கள்?","ml":"ശത്രുക്കൾ പല്ലുകൊണ്ടു എന്തു ചെയ്യുന്നു?"},"a":{"en":"Gnash","ta":"பற்கடிக்கிறார்கள்","ml":"പല്ലുകടിച്ചു"},"ref":[24,2,16]},{"q":{"en":"What do the enemies say they have done to her?","ta":"பகைஞர் எதைச் செய்தோம் என்கிறார்கள்?","ml":"ശത്രുക്കൾ അവളെ എന്തു ചെയ്തു എന്നു പറയുന്നു?"},"a":{"en":"Swallowed her up","ta":"விழுங்கினோம்","ml":"വിഴുങ്ങിക്കളഞ്ഞു"},"ref":[24,2,16]},{"q":{"en":"What did the LORD fulfil that he commanded in the days of old?","ta":"பூர்வநாட்கள் முதற்கொண்டு கர்த்தர் கட்டளையிட்டு நிறைவேற்றியது எது?","ml":"പുരാതനകാലത്തു അരുളിച്ചെയ്തതു കർത്താവു എന്തു ചെയ്തു?"},"a":{"en":"His word","ta":"வார்த்தையை","ml":"നിവർത്തിച്ചു"},"ref":[24,2,17]},{"q":{"en":"What did the LORD set up of thine adversaries?","ta":"கர்த்தர் சத்துருக்களின் எதை உயர்த்தினார்?","ml":"കർത്താവു വൈരികളുടെ എന്തു ഉയർത്തിയിരിക്കുന്നു?"},"a":{"en":"The horn","ta":"கொம்பை","ml":"കൊമ്പു"},"ref":[24,2,17]},{"q":{"en":"To whom did their heart cry?","ta":"அவர்கள் இருதயம் யாரை நோக்கிக் கூப்பிடுகிறது?","ml":"അവരുടെ ഹൃദയം ആരോടു നിലവിളിച്ചു?"},"a":{"en":"The Lord","ta":"ஆண்டவரை","ml":"കർത്താവിനോടു"},"ref":[24,2,18]},{"q":{"en":"When should tears run down like a river?","ta":"கண்ணீர் எப்போது நதியைப்போல் விடப்படவேண்டும்?","ml":"കണ്ണുനീർ എപ്പോൾ ഒഴുക്കണം?"},"a":{"en":"Day and night","ta":"இரவும் பகலும்","ml":"രാവും പകലും"},"ref":[24,2,18]},{"q":{"en":"When should one arise and cry out?","ta":"எழுந்திருந்து எப்போது கூப்பிடவேண்டும்?","ml":"എഴുന്നേറ്റു എപ്പോൾ നിലവിളിക്കണം?"},"a":{"en":"In the night","ta":"இராத்திரியிலே","ml":"രാത്രിയിൽ"},"ref":[24,2,19]},{"q":{"en":"How should one pour out the heart before the Lord?","ta":"ஆண்டவரின் சமுகத்தில் இருதயத்தை எப்படி ஊற்றிவிடவேண்டும்?","ml":"കർത്തൃസന്നിധിയിൽ ഹൃദയത്തെ എങ്ങനെ പകരണം?"},"a":{"en":"Like water","ta":"தண்ணீரைப் போல","ml":"വെള്ളംപോലെ"},"ref":[24,2,19]},{"q":{"en":"For whom should hands be lifted up to the Lord?","ta":"யாருடைய பிராணனுக்காக கைகளை ஏறெடுக்கவேண்டும்?","ml":"ആരുടെ ജീവരക്ഷെക്കായി കൈ മലർത്തണം?"},"a":{"en":"Thy young children","ta":"உன் குழந்தைகளின்","ml":"നിന്റെ കുഞ്ഞുങ്ങളുടെ"},"ref":[24,2,19]},{"q":{"en":"Whom does the writer say shall be slain in the sanctuary of the Lord?","ta":"ஆண்டவருடைய பரிசுத்த ஸ்தலத்தில் கொலைசெய்யப்படுவார்களோ என்று கேட்கப்படுபவர்கள் யார்?","ml":"കർത്താവിന്റെ വിശുദ്ധമന്ദിരത്തിൽ കൊല്ലപ്പെടേണമോ എന്നു ചോദിക്കുന്നത് ആരെ?"},"a":{"en":"The priest and the prophet","ta":"ஆசாரியனும் தீர்க்கதரிசியும்","ml":"പുരോഹിതനും പ്രവാചകനും"},"ref":[24,2,20]},{"q":{"en":"What shall the women eat, according to the question?","ta":"ஸ்திரீகள் எதைத் தின்னவேண்டுமோ என்று கேட்கப்படுகிறது?","ml":"സ്ത്രീകൾ എന്തിനെ തിന്നേണമോ എന്നു ചോദിക്കുന്നു?"},"a":{"en":"Their fruit","ta":"கர்ப்பக்கனியை","ml":"ഗർഭഫലത്തെ"},"ref":[24,2,20]},{"q":{"en":"Who lie on the ground in the streets?","ta":"தெருக்களில் தரையிலே கிடப்பவர்கள் யார்?","ml":"വീഥികളിൽ നിലത്തു കിടക്കുന്നവർ ആര്?"},"a":{"en":"The young and the old","ta":"இளைஞனும் முதிர்வயதுள்ளவனும்","ml":"ബാലനും വൃദ്ധനും"},"ref":[24,2,21]},{"q":{"en":"By what have the virgins and young men fallen?","ta":"கன்னிகைகளும் வாலிபரும் எதினால் விழுந்தார்கள்?","ml":"കന്യകമാരും യൌവനക്കാരും എന്തുകൊണ്ടു വീണു?"},"a":{"en":"The sword","ta":"பட்டயத்தால்","ml":"വാൾകൊണ്ടു"},"ref":[24,2,21]},{"q":{"en":"Whom has the enemy consumed, whom the writer swaddled and brought up?","ta":"எதிரி நாசம்பண்ணியவர்கள் யார்?","ml":"ശത്രു ആരെ മുടിച്ചിരിക്കുന്നു?"},"a":{"en":"Those I have swaddled and brought up","ta":"கைகளில் ஏந்தி வளர்த்தவர்களை","ml":"കയ്യിൽ താലോലിച്ചു വളർത്തിയവരെ"},"ref":[24,2,22]},{"q":{"en":"In which day did none escape nor remain?","ta":"எந்த நாளிலே தப்பினவனும் மீதியானவனும் இல்லை?","ml":"ഏതു ദിവസത്തിൽ ആരും ചാടിപ്പോകയില്ല, ശേഷിച്ചതുമില്ല?"},"a":{"en":"The day of the LORD's anger","ta":"கர்த்தருடைய கோபத்தின் நாளிலே","ml":"യഹോവയുടെ കോപദിവസത്തിൽ"},"ref":[24,2,22]},{"q":{"en":"What did the man see by the rod of his wrath?","ta":"அவருடைய சினத்தின் மிலாற்றினால் மனுஷன் எதைக் கண்டான்?","ml":"അവന്റെ കോപത്തിന്റെ വടികൊണ്ടു പുരുഷൻ എന്തു കണ്ടു?"},"a":{"en":"Affliction","ta":"சிறுமையை","ml":"കഷ്ടം"},"ref":[24,3,1]},{"q":{"en":"Into what did he lead me and bring me, but not into light?","ta":"அவர் என்னை வெளிச்சத்திலே அல்ல, எதிலே நடத்திவந்தார்?","ml":"അവൻ എന്നെ വെളിച്ചത്തിലല്ല, എവിടെ നടത്തിക്കൊണ്ടു പോന്നു?"},"a":{"en":"Darkness","ta":"இருளிலே","ml":"ഇരുട്ടിൽ"},"ref":[24,3,2]},{"q":{"en":"What did he make old, and what did he break?","ta":"அவர் முற்றலாக்கியது எது, நொறுக்கியது எது?","ml":"അവൻ ജീർണ്ണമാക്കിയതും തകർത്തതും എന്ത്?"},"a":{"en":"My flesh and skin; my bones","ta":"சதையையும் தோலையும்; எலும்புகளை","ml":"മാംസത്തെയും ത്വക്കിനെയും; അസ്ഥികളെ"},"ref":[24,3,4]},{"q":{"en":"With what did he compass me?","ta":"அவர் என்னை எவைகளினால் வளைத்துகொண்டார்?","ml":"അവൻ എന്നെ എന്തു ചുറ്റുമാറാക്കി?"},"a":{"en":"Gall and travail","ta":"கசப்பினாலும் வருத்தத்தினாலும்","ml":"നഞ്ചും പ്രയാസവും"},"ref":[24,3,5]},{"q":{"en":"Like whom did he set me in dark places?","ta":"அவர் என்னை இருளான இடங்களில் யாரைப்போல கிடக்கப்பண்ணினார்?","ml":"അവൻ എന്നെ ഇരുട്ടിൽ ആരെപ്പോലെ പാർപ്പിച്ചു?"},"a":{"en":"They that be dead of old","ta":"செத்துக்கிடக்கிறவர்களைப்போல","ml":"ശാശ്വതമൃതന്മാരെപ്പോലെ"},"ref":[24,3,6]},{"q":{"en":"What did he make heavy?","ta":"அவர் எதைப் பாரமாக்கினார்?","ml":"അവൻ എന്തിനെ ഭാരമാക്കി?"},"a":{"en":"My chain","ta":"விலங்கை","ml":"ചങ്ങലയെ"},"ref":[24,3,7]},{"q":{"en":"What does he shut out when I cry and shout?","ta":"நான் கூப்பிட்டாலும் அவர் எதற்கு வழியை அடைத்துப்போட்டார்?","ml":"ഞാൻ നിലവിളിച്ചാലും അവൻ എന്തു തടുത്തുകളയുന്നു?"},"a":{"en":"My prayer","ta":"ஜெபத்துக்கு","ml":"പ്രാർത്ഥന"},"ref":[24,3,8]},{"q":{"en":"With what did he enclose my ways?","ta":"அவர் என் வழிகளை எதினால் அடைத்துப்போட்டார்?","ml":"അവൻ എന്റെ വഴി എന്തുകൊണ്ടു അടെച്ചു?"},"a":{"en":"Hewn stone","ta":"வெட்டின கற்களின் சுவரால்","ml":"വെട്ടുകല്ലുകൊണ്ടു"},"ref":[24,3,9]},{"q":{"en":"To what animals is he compared as lying in wait?","ta":"பதிவிருக்கிறவராக எந்த மிருகங்களுக்கு ஒப்பிடப்படுகிறார்?","ml":"പതിയിരിക്കുന്നവനായി അവനെ ഏതു മൃഗങ്ങളോടു ഉപമിക്കുന്നു?"},"a":{"en":"A bear and a lion","ta":"கரடியும் சிங்கமும்","ml":"കരടിയും സിംഹവും"},"ref":[24,3,10]},{"q":{"en":"What did he set me as a mark for?","ta":"அவர் என்னை எதற்கு இலக்காக வைத்தார்?","ml":"അവൻ എന്നെ എന്തിനു ലാക്കാക്കി?"},"a":{"en":"The arrow","ta":"அம்புக்கு","ml":"അമ്പിന്നു"},"ref":[24,3,12]},{"q":{"en":"Into what did he cause the arrows of his quiver to enter?","ta":"அவர் அம்புகளை எதில் படப்பண்ணினார்?","ml":"അവൻ പൂണിയിലെ അമ്പുകളെ എവിടെ തറെപ്പിച്ചു?"},"a":{"en":"My reins","ta":"உள்ளிந்திரியங்களில்","ml":"അന്തരംഗങ്ങളിൽ"},"ref":[24,3,13]},{"q":{"en":"What was I to all my people?","ta":"நான் என் ஜனத்தார் யாவருக்கும் எப்படி ஆனேன்?","ml":"ഞാൻ എന്റെ സർവ്വജനത്തിന്നും എന്തായി?"},"a":{"en":"A derision","ta":"பரியாசமும்","ml":"പരിഹാസം"},"ref":[24,3,14]},{"q":{"en":"With what did he make me drunken?","ta":"அவர் என்னை எதினால் வெறிக்கச்செய்தார்?","ml":"അവൻ എന്നെ എന്തുകൊണ്ടു മത്തുപിടിപ്പിച്ചു?"},"a":{"en":"Wormwood","ta":"எட்டியினால்","ml":"കാഞ്ഞിരംകൊണ്ടു"},"ref":[24,3,15]},{"q":{"en":"With what did he break my teeth?","ta":"அவர் என் பற்களை எதினால் நொறுக்கினார்?","ml":"അവൻ എന്റെ പല്ലു എന്തുകൊണ്ടു തകർത്തു?"},"a":{"en":"Gravel stones","ta":"பருக்கைக் கற்களால்","ml":"കല്ലുകൊണ്ടു"},"ref":[24,3,16]},{"q":{"en":"With what did he cover me?","ta":"அவர் என்னை எதில் புரளப்பண்ணினார்?","ml":"അവൻ എന്നെ എന്തിൽ ഇട്ടുരുട്ടി?"},"a":{"en":"Ashes","ta":"சாம்பலில்","ml":"വെണ്ണീരിൽ"},"ref":[24,3,16]},{"q":{"en":"What did I forget when my soul was far from peace?","ta":"சமாதானத்துக்குத் தூரமான நான் எதை மறந்தேன்?","ml":"സമാധാനത്തിൽനിന്നു അകന്ന ഞാൻ എന്തു മറന്നു?"},"a":{"en":"Prosperity","ta":"சுகத்தை","ml":"സുഖം"},"ref":[24,3,17]},{"q":{"en":"What did I say had perished from the LORD?","ta":"எனக்குக் கர்த்தரிடத்திலிருந்து அழிந்துபோயிற்று என்றது எது?","ml":"യഹോവയിങ്കൽനിന്നു പൊയ്പോയി എന്നു പറഞ്ഞത് എന്ത്?"},"a":{"en":"My strength and my hope","ta":"என் பெலனும் நம்பிக்கையும்","ml":"മഹത്വവും പ്രത്യാശയും"},"ref":[24,3,18]},{"q":{"en":"What does the writer ask God to remember?","ta":"எதை நினைத்தருளும் என்று கேட்கப்படுகிறது?","ml":"ഏതു ഓർക്കേണമേ എന്നു പറയുന്നു?"},"a":{"en":"My affliction and my misery","ta":"என் சிறுமையையும் தவிப்பையும்","ml":"കഷ്ടതയും അരിഷ്ടതയും"},"ref":[24,3,19]},{"q":{"en":"What does the writer recall to his mind, therefore has he hope?","ta":"நம்பிக்கைகொண்டிருக்க மனதிலே வைத்தது எது?","ml":"പ്രത്യാശിക്കേണ്ടതിന്നു ഓർക്കുന്നത് എന്ത്?"},"a":{"en":"This","ta":"இதை","ml":"ഇതു"},"ref":[24,3,21]},{"q":{"en":"Why are we not consumed?","ta":"நாம் ஏன் நிர்மூலமாகாதிருக்கிறோம்?","ml":"നാം എന്തുകൊണ്ടു മുടിഞ്ഞുപോകാതിരിക്കുന്നു?"},"a":{"en":"It is of the LORD's mercies","ta":"கர்த்தருடைய கிருபையே","ml":"യഹോവയുടെ ദയ"},"ref":[24,3,22]},{"q":{"en":"What fail not?","ta":"முடிவில்லாதவை எவை?","ml":"തീർന്നുപോകാത്തത് എന്ത്?"},"a":{"en":"His compassions","ta":"இரக்கங்களுக்கு","ml":"കരുണ"},"ref":[24,3,22]},{"q":{"en":"How often are the LORD's compassions new?","ta":"கர்த்தருடைய இரக்கங்கள் எப்போது புதியவைகள்?","ml":"യഹോവയുടെ ദയ എപ്പോൾ പുതിയതു?"},"a":{"en":"Every morning","ta":"காலைதோறும்","ml":"രാവിലെതോറും"},"ref":[24,3,23]},{"q":{"en":"What is great, according to Lamentations 3:23?","ta":"பெரிதாயிருப்பது எது?","ml":"വലിയതായിരിക്കുന്നത് എന്ത്?"},"a":{"en":"Thy faithfulness","ta":"உமது உண்மை","ml":"വിശ്വസ്ഥത"},"ref":[24,3,23]},{"q":{"en":"What does my soul say the LORD is?","ta":"கர்த்தர் என்ன என்று என் ஆத்துமா சொல்லும்?","ml":"യഹോവ എന്താണെന്നു എന്റെ ഉള്ളം പറയുന്നു?"},"a":{"en":"My portion","ta":"என் பங்கு","ml":"എന്റെ ഓഹരി"},"ref":[24,3,24]},{"q":{"en":"To whom is the LORD good?","ta":"கர்த்தர் யாருக்கு நல்லவர்?","ml":"യഹോവ ആർക്കു നല്ലവൻ?"},"a":{"en":"Them that wait for him","ta":"தமக்குக் காத்திருக்கிறவர்களுக்கும்","ml":"തന്നെ കാത്തിരിക്കുന്നവർക്കും"},"ref":[24,3,25]},{"q":{"en":"What is good for a man to hope and quietly wait for?","ta":"மனுஷன் நம்பிக்கையோடு காத்திருக்கிறது நல்லது எதற்கு?","ml":"മിണ്ടാതെ കാത്തിരിക്കുന്നതു നല്ലത് എന്തിന്നായി?"},"a":{"en":"The salvation of the LORD","ta":"கர்த்தருடைய இரட்சிப்புக்கு","ml":"യഹോവയുടെ രക്ഷെക്കായി"},"ref":[24,3,26]},{"q":{"en":"What is good for a man to bear in his youth?","ta":"மனுஷன் இளம்பிராயத்தில் சுமக்கிறது நல்லது எதை?","ml":"ബാല്യത്തിൽ ചുമക്കുന്നതു ഒരു പുരുഷന്നു നല്ലത് എന്ത്?"},"a":{"en":"The yoke","ta":"நுகத்தை","ml":"നുകം"},"ref":[24,3,27]},{"q":{"en":"Where does he put his mouth, if so be there may be hope?","ta":"நம்பிக்கைக்கு இடமுண்டோ என்று தன் வாயை எதில் நுழுந்துவானாக?","ml":"പ്രത്യാശ ശേഷിക്കേണ്ടതിന്നു അവൻ തന്റെ മുഖത്തെ എതിലോളം താഴ്ത്തട്ടെ?"},"a":{"en":"In the dust","ta":"தூளில்","ml":"പൊടിയോളം"},"ref":[24,3,29]},{"q":{"en":"What does he give to him that smites him?","ta":"தன்னை அடிக்கிறவனுக்கு அவன் எதைக் காட்டுவானாக?","ml":"തന്നെ അടിക്കുന്നവന്നു അവൻ എന്തു കാണിക്കട്ടെ?"},"a":{"en":"His cheek","ta":"கன்னத்தை","ml":"കവിൾ"},"ref":[24,3,30]},{"q":{"en":"What will the Lord not do for ever?","ta":"ஆண்டவர் என்றென்றைக்கும் என்ன செய்யமாட்டார்?","ml":"കർത്താവു എന്നേക്കും എന്തു ചെയ്കയില്ല?"},"a":{"en":"Cast off","ta":"கைவிடமாட்டார்","ml":"തള്ളിക്കളകയില്ല"},"ref":[24,3,31]},{"q":{"en":"According to what will he have compassion though he cause grief?","ta":"அவர் சஞ்சலப்படுத்தினாலும் எதின்படி இரங்குவார்?","ml":"ദുഃഖിപ്പിച്ചാലും അവന്നു എന്തിനൊത്തവണ്ണം കരുണതോന്നും?"},"a":{"en":"The multitude of his mercies","ta":"மிகுந்த கிருபையின்படி","ml":"മഹാദയെക്കു"},"ref":[24,3,32]},{"q":{"en":"Whom does he not afflict willingly?","ta":"அவர் மனப்பூர்வமாய் யாரைச் சஞ்சலப்படுத்துகிறதில்லை?","ml":"അവൻ മനസ്സോടെ ആരെ ദുഃഖിപ്പിക്കുന്നില്ല?"},"a":{"en":"The children of men","ta":"மனுபுத்திரரை","ml":"മനുഷ്യപുത്രന്മാരെ"},"ref":[24,3,33]},{"q":{"en":"Whom does a man crush under his feet?","ta":"ஒருவன் தன் கால்களின்கீழ் யாரை நசுக்குகிறான்?","ml":"ഭൂമിയിലെ ആരെ കാല്കീഴിട്ടു മെതിക്കുന്നു?"},"a":{"en":"All the prisoners of the earth","ta":"சிறைப்பட்டவர்கள் யாவரையும்","ml":"സകലബദ്ധന്മാരെയും"},"ref":[24,3,34]},{"q":{"en":"Before whose face is the right of a man turned aside?","ta":"யாருடைய சமுகத்தில் மனுஷருடைய நியாயம் புரட்டப்படுகிறது?","ml":"ആരുടെ സന്നിധിയിൽ മനുഷ്യന്റെ ന്യായം മറിച്ചുകളയുന്നു?"},"a":{"en":"The most High","ta":"உன்னதமானவரின்","ml":"അത്യുന്നതന്റെ"},"ref":[24,3,35]},{"q":{"en":"At whose command does anything spoken come to pass?","ta":"யாருடைய கட்டளையினால் சொன்ன காரியம் சம்பவிக்கும்?","ml":"ആരുടെ കല്പനയാൽ പറഞ്ഞതൊക്കെയും സംഭവിക്കുന്നു?"},"a":{"en":"The Lord","ta":"ஆண்டவர்","ml":"കർത്താവു"},"ref":[24,3,37]},{"q":{"en":"What proceeds out of the mouth of the most High?","ta":"உன்னதமானவருடைய வாயிலிருந்து எவை புறப்படுகின்றன?","ml":"അത്യുന്നതന്റെ വായിൽനിന്നു എന്തു പുറപ്പെടുന്നു?"},"a":{"en":"Evil and good","ta":"தீமையும் நன்மையும்","ml":"നന്മയും തിന്മയും"},"ref":[24,3,38]},{"q":{"en":"Why should a living man complain?","ta":"உயிருள்ள மனுஷன் எதைக்குறித்து முறையிடுகிறான்?","ml":"ജീവനുള്ള മനുഷ്യൻ എന്തിനെക്കുറിച്ചു നെടുവീർപ്പിടട്ടെ?"},"a":{"en":"For the punishment of his sins","ta":"பாவத்துக்கு வரும் தண்டனையை","ml":"പാപങ്ങളെക്കുറിച്ചു"},"ref":[24,3,39]},{"q":{"en":"To whom should we turn again after searching our ways?","ta":"நம்முடைய வழிகளை ஆராய்ந்து யாரிடத்தில் திரும்பவேண்டும்?","ml":"നമ്മുടെ നടപ്പു ശോധനചെയ്തു ആരുടെ അടുക്കലേക്കു തിരിയണം?"},"a":{"en":"The LORD","ta":"கர்த்தரிடத்தில்","ml":"യഹോവയുടെ"},"ref":[24,3,40]},{"q":{"en":"What should we lift up with our hands unto God in the heavens?","ta":"கைகளோடுங்கூட எதை தேவனிடத்திற்கு ஏறெடுக்கவேண்டும்?","ml":"കൈകളോടുകൂടെ ദൈവത്തിങ്കലേക്കു എന്തു ഉയർത്തണം?"},"a":{"en":"Our heart","ta":"இருதயத்தையும்","ml":"ഹൃദയത്തെയും"},"ref":[24,3,41]},{"q":{"en":"What did we do, so that God has not pardoned?","ta":"நாங்கள் என்ன செய்ததால் தேவரீர் மன்னியாதிருந்தீர்?","ml":"ഞങ്ങൾ എന്തു ചെയ്തു, നീ ക്ഷമിച്ചതുമില്ല?"},"a":{"en":"Transgressed and rebelled","ta":"துரோகஞ்செய்து, கலகம் பண்ணினோம்","ml":"അതിക്രമം ചെയ്തു മത്സരിച്ചു"},"ref":[24,3,42]},{"q":{"en":"With what has God covered himself so that our prayer should not pass through?","ta":"ஜெபம் உட்பிரவேசிக்காதபடி தேவரீர் எதினால் மூடிக்கொண்டீர்?","ml":"പ്രാർത്ഥന കടക്കാതവണ്ണം നീ എന്തുകൊണ്ടു നിന്നെത്തന്നേ മറെച്ചു?"},"a":{"en":"A cloud","ta":"மேகத்தால்","ml":"മേഘംകൊണ്ടു"},"ref":[24,3,44]},{"q":{"en":"What has God made us in the midst of the people?","ta":"ஜனங്களுக்குள்ளே எங்களை எப்படி ஆக்கினீர்?","ml":"നീ ഞങ്ങളെ ജാതികളുടെ ഇടയിൽ എന്താക്കി?"},"a":{"en":"The offscouring and refuse","ta":"குப்பையும் அருவருப்புமாக","ml":"ചവറും എച്ചിലും"},"ref":[24,3,45]},{"q":{"en":"What have all our enemies opened against us?","ta":"எங்கள் பகைஞர் எல்லாரும் எதைத் திறந்தார்கள்?","ml":"ഞങ്ങളുടെ ശത്രുക്കൾ എന്തു പിളർന്നിരിക്കുന്നു?"},"a":{"en":"Their mouths","ta":"வாயை","ml":"വായ്"},"ref":[24,3,46]},{"q":{"en":"What came upon us along with desolation and destruction?","ta":"பாழ்க்கடிப்பும் சங்காரமும் உடன் எங்களுக்கு நேரிட்டவை எவை?","ml":"ശൂന്യവും നാശവും ഒപ്പം ഞങ്ങൾക്കു ഭവിച്ചവ എന്ത്?"},"a":{"en":"Fear and a snare","ta":"திகிலும் படுகுழியும்","ml":"പേടിയും കണിയും"},"ref":[24,3,47]},{"q":{"en":"What runs down from my eye for the destruction of the daughter of my people?","ta":"என் ஜனமாகிய குமாரத்தியின் கேட்டினிமித்தம் கண்களிலிருந்து பாய்வது என்ன?","ml":"എന്റെ ജനത്തിൻ പുത്രിയുടെ നാശംനിമിത്തം കണ്ണിൽനിന്നൊഴുകുന്നത് എന്ത്?"},"a":{"en":"Rivers of water","ta":"நீர்க்கால்கள்","ml":"നീർത്തോടുകൾ"},"ref":[24,3,48]},{"q":{"en":"Until when will my eye trickle down without ceasing?","ta":"என் கண் எதுவரை சொரிகிறது?","ml":"എന്റെ കണ്ണു ഇടവിടാതെ പൊഴിക്കുന്നത് എതുവരെ?"},"a":{"en":"Till the LORD looks down from heaven","ta":"கர்த்தர் பரலோகத்திலிருந்து நோக்கிப்பார்க்குமட்டும்","ml":"യഹോവ സ്വർഗ്ഗത്തിൽനിന്നു നോക്കി കടാക്ഷിക്കുവോളം"},"ref":[24,3,49]},{"q":{"en":"Like what did my enemies chase me without cause?","ta":"காரணமில்லாமல் பகைக்கிறவர்கள் என்னை எதைப்போல வேட்டையாடினார்கள்?","ml":"കാരണംകൂടാതെ ശത്രുക്കൾ എന്നെ എന്തുപോലെ വേട്ടയാടി?"},"a":{"en":"A bird","ta":"பட்சியைப் போல","ml":"പക്ഷിയെപ്പോലെ"},"ref":[24,3,52]},{"q":{"en":"Where did they cut off my life?","ta":"அவர்கள் என் பிராணனை எங்கே ஒடுக்கினார்கள்?","ml":"അവർ എന്റെ ജീവനെ എവിടെ ഇട്ടു നശിപ്പിച്ചു?"},"a":{"en":"In the dungeon","ta":"காவற்கிடங்கிலே","ml":"കുണ്ടറയിൽ"},"ref":[24,3,53]},{"q":{"en":"What did they cast upon me?","ta":"அவர்கள் என்மீதில் எதை வைத்தார்கள்?","ml":"അവർ എന്റെ മേൽ എന്തു എറിഞ്ഞു?"},"a":{"en":"A stone","ta":"கல்லை","ml":"കല്ലു"},"ref":[24,3,53]},{"q":{"en":"What flowed over my head?","ta":"என் தலையின்மேல் புரண்டது எது?","ml":"എന്റെ തലെക്കുമീതെ കവിഞ്ഞൊഴുകിയത് എന്ത്?"},"a":{"en":"Waters","ta":"தண்ணீர்","ml":"വെള്ളം"},"ref":[24,3,54]},{"q":{"en":"From where did I call upon the name of the LORD?","ta":"நான் கர்த்தருடைய நாமத்தை எங்கிருந்து கூப்பிட்டேன்?","ml":"ഞാൻ യഹോവയുടെ നാമത്തെ എവിടെനിന്നു വിളിച്ചപേക്ഷിച്ചു?"},"a":{"en":"The low dungeon","ta":"மகா ஆழமான கிடங்கிலிருந்து","ml":"ആഴമുള്ള കുണ്ടറയിൽനിന്നു"},"ref":[24,3,55]},{"q":{"en":"What did the LORD say in the day that I called upon him?","ta":"நான் கூப்பிட்ட நாளிலே நீர் என்ன சொன்னீர்?","ml":"ഞാൻ വിളിച്ചപേക്ഷിച്ച നാളിൽ നീ എന്തു പറഞ്ഞു?"},"a":{"en":"Fear not","ta":"பயப்படாதே","ml":"ഭയപ്പെടേണ്ടാ"},"ref":[24,3,57]},{"q":{"en":"What has the Lord redeemed?","ta":"ஆண்டவர் எதை மீட்டுக்கொண்டார்?","ml":"കർത്താവു എന്തിനെ വീണ്ടെടുത്തു?"},"a":{"en":"My life","ta":"என் பிராணனை","ml":"എന്റെ ജീവനെ"},"ref":[24,3,58]},{"q":{"en":"What does the writer ask the LORD to judge?","ta":"கர்த்தர் எதைத் தீர்க்கவேண்டும் என்று கேட்கப்படுகிறது?","ml":"യഹോവ എന്തു തീർത്തുതരേണം എന്നു പറയുന്നു?"},"a":{"en":"My cause","ta":"என் நியாயத்தை","ml":"എന്റെ വ്യവഹാരം"},"ref":[24,3,59]},{"q":{"en":"What am I to those who sit down and rise up against me?","ta":"அவர்கள் உட்கார்ந்து எழுந்திருக்கையில் நான் அவர்களுக்கு என்னவாயிருக்கிறேன்?","ml":"അവരുടെ ഇരിപ്പിലും എഴുന്നേല്പിലും ഞാൻ അവർക്കു എന്താകുന്നു?"},"a":{"en":"Their musick","ta":"பாடலாயிருக்கிறேன்","ml":"പാട്ടായിരിക്കുന്നു"},"ref":[24,3,63]},{"q":{"en":"According to what does the writer ask the LORD to render a recompence?","ta":"கர்த்தர் எதற்குத்தக்கதாக பலன் அளிப்பார்?","ml":"യഹോവ എന്തിന്നു തക്കവണ്ണം പകരം ചെയ്യണം?"},"a":{"en":"The work of their hands","ta":"கைகள் செய்த கிரியைகளுக்கு","ml":"പ്രവൃത്തിക്കു"},"ref":[24,3,64]},{"q":{"en":"From under what does the writer ask that they be destroyed?","ta":"அவர்கள் எதன் கீழ் இராதபடிக்கு அழிக்கப்படுவார்கள்?","ml":"അവരെ എന്തിൻ കീഴിൽനിന്നു നശിപ്പിച്ചുകളയും?"},"a":{"en":"The heavens of the LORD","ta":"கர்த்தருடைய வானங்களின் கீழ்","ml":"യഹോവയുടെ ആകാശത്തിൻ"},"ref":[24,3,66]}]