[{"q":{"en":"Who wrote the letter of Jude?","ta":"இந்தக் கடிதத்தை எழுதியவர் யார்?","ml":"ഈ ലേഖനം എഴുതിയതു ആര്?"},"a":{"en":"Jude","ta":"யூதா","ml":"യൂദാ"},"ref":[64,1,1]},{"q":{"en":"Whose servant did Jude call himself?","ta":"யூதா தன்னை யாருடைய ஊழியக்காரன் என்று சொன்னான்?","ml":"യൂദാ തന്നെത്തന്നേ ആരുടെ ദാസൻ എന്നു പറഞ്ഞു?"},"a":{"en":"Jesus Christ","ta":"இயேசுகிறிஸ்து","ml":"യേശുക്രിസ്തു"},"ref":[64,1,1]},{"q":{"en":"Whose brother was Jude?","ta":"யூதா யாருடைய சகோதரன்?","ml":"യൂദാ ആരുടെ സഹോദരൻ?"},"a":{"en":"James","ta":"யாக்கோபு","ml":"യാക്കോബ്"},"ref":[64,1,1]},{"q":{"en":"By whom are the called sanctified?","ta":"அழைக்கப்பட்டவர்கள் யாரால் பரிசுத்தமாக்கப்பட்டார்கள்?","ml":"വിളിക്കപ്പെട്ടവർ ആരാൽ സ്നേഹിക്കപ്പെട്ടിരിക്കുന്നു?"},"a":{"en":"God the Father","ta":"பிதாவாகிய தேவன்","ml":"പിതാവായ ദൈവം"},"ref":[64,1,1]},{"q":{"en":"In whom are the called preserved?","ta":"அழைக்கப்பட்டவர்கள் யாரால் காக்கப்பட்டவர்கள்?","ml":"വിളിക്കപ്പെട്ടവർ ആർക്കായി സൂക്ഷിക്കപ്പെട്ടിരിക്കുന്നു?"},"a":{"en":"Jesus Christ","ta":"இயேசுகிறிஸ்து","ml":"യേശുക്രിസ്തു"},"ref":[64,1,1]},{"q":{"en":"What three things did Jude wish to be multiplied to the believers?","ta":"யூதா விசுவாசிகளுக்குப் பெருகவேண்டும் என்று வாழ்த்திய மூன்று காரியங்கள் என்ன?","ml":"യൂദാ വിശ്വാസികൾക്കു വർദ്ധിക്കട്ടെ എന്നു ആശംസിച്ച മൂന്നു കാര്യങ്ങൾ എന്തെല്ലാം?"},"a":{"en":"Mercy, peace and love","ta":"இரக்கமும் சமாதானமும் அன்பும்","ml":"കരുണയും സമാധാനവും സ്നേഹവും"},"ref":[64,1,2]},{"q":{"en":"What did Jude give all diligence to write about?","ta":"யூதா மிகவும் கருத்தாய் எதைக்குறித்து எழுத எண்ணினான்?","ml":"യൂദാ സകലപ്രയത്നവും ചെയ്തു എന്തിനെക്കുറിച്ചു എഴുതുവാൻ ഇച്ഛിച്ചു?"},"a":{"en":"The common salvation","ta":"பொதுவான இரட்சிப்பு","ml":"പൊതുവിലുള്ള രക്ഷ"},"ref":[64,1,3]},{"q":{"en":"What did Jude urge the believers to earnestly contend for?","ta":"விசுவாசிகள் எதற்காகத் தைரியமாய்ப் போராடவேண்டும் என்று யூதா எழுதினான்?","ml":"വിശ്വാസികൾ എന്തിനു വേണ്ടി പോരാടേണ്ടതിന്നു യൂദാ പ്രബോധിപ്പിച്ചു?"},"a":{"en":"The faith","ta":"விசுவாசம்","ml":"വിശ്വാസം"},"ref":[64,1,3]},{"q":{"en":"To whom was the faith once delivered?","ta":"விசுவாசம் ஒருவிசை யாருக்கு ஒப்புக்கொடுக்கப்பட்டது?","ml":"വിശ്വാസം ഒരിക്കലായി ആരെ ഭരമേല്പിച്ചിരിക്കുന്നു?"},"a":{"en":"The saints","ta":"பரிசுத்தவான்கள்","ml":"വിശുദ്ധന്മാർ"},"ref":[64,1,3]},{"q":{"en":"What did certain ungodly men do to the church?","ta":"பக்தியற்ற சிலர் எப்படி சபைக்குள் வந்தார்கள்?","ml":"ഭക്തിയില്ലാത്ത ചിലർ എങ്ങനെ സഭയിൽ വന്നു?"},"a":{"en":"Crept in unawares","ta":"பக்கவழியாய் நுழைந்தார்கள்","ml":"നുഴഞ്ഞു വന്നു"},"ref":[64,1,4]},{"q":{"en":"Into what did the ungodly men turn the grace of God?","ta":"பக்தியற்றவர்கள் தேவனுடைய கிருபையை எதற்கேதுவாகப் புரட்டினார்கள்?","ml":"അഭക്തർ ദൈവത്തിന്റെ കൃപയെ എന്തിനു ഹേതുവാക്കി?"},"a":{"en":"Lasciviousness","ta":"காமவிகாரம்","ml":"ദുഷ്കാമവൃത്തി"},"ref":[64,1,4]},{"q":{"en":"Whom did the ungodly men deny?","ta":"பக்தியற்றவர்கள் யாரை மறுதலித்தார்கள்?","ml":"അഭക്തർ ആരെ നിഷേധിച്ചു?"},"a":{"en":"The only Lord God and Jesus Christ","ta":"ஆண்டவராகிய தேவனையும் இயேசுகிறிஸ்துவையும்","ml":"ഏകനാഥനും യേശുക്രിസ്തുവും"},"ref":[64,1,4]},{"q":{"en":"From which land did the Lord save His people?","ta":"கர்த்தர் தம் ஜனத்தை எந்த தேசத்திலிருந்து இரட்சித்தார்?","ml":"കർത്താവു ജനത്തെ എവിടെനിന്നു രക്ഷിച്ചു?"},"a":{"en":"Egypt","ta":"எகிப்து","ml":"മിസ്രയീം"},"ref":[64,1,5]},{"q":{"en":"Whom did the Lord afterward destroy?","ta":"கர்த்தர் பின்பு யாரை அழித்தார்?","ml":"കർത്താവു പിന്നത്തേതിൽ ആരെ നശിപ്പിച്ചു?"},"a":{"en":"Them that believed not","ta":"விசுவாசியாதவர்கள்","ml":"വിശ്വസിക്കാത്തവർ"},"ref":[64,1,5]},{"q":{"en":"Which beings left their own habitation?","ta":"தங்களுக்குரிய வாசஸ்தலத்தை விட்டுவிட்டவர்கள் யார்?","ml":"സ്വന്ത വാസസ്ഥലം വിട്ടുപോയവർ ആര്?"},"a":{"en":"The angels","ta":"தூதர்கள்","ml":"ദൂതന്മാർ"},"ref":[64,1,6]},{"q":{"en":"With what has God bound the angels who left their habitation?","ta":"தூதர்களை தேவன் எதினாலே கட்டியிருக்கிறார்?","ml":"വാസസ്ഥലം വിട്ട ദൂതന്മാരെ ദൈവം എന്തിട്ടു സൂക്ഷിച്ചിരിക്കുന്നു?"},"a":{"en":"Everlasting chains","ta":"நித்திய சங்கிலிகள்","ml":"എന്നേക്കുമുള്ള ചങ്ങല"},"ref":[64,1,6]},{"q":{"en":"Under what are the angels kept until the judgment of the great day?","ta":"மகா நாளின் நியாயத்தீர்ப்பு வரை தூதர்கள் எதில் அடைக்கப்பட்டிருக்கிறார்கள்?","ml":"മഹാദിവസത്തിന്റെ വിധിവരെ ദൂതന്മാർ എന്തിൻ കീഴിൽ സൂക്ഷിക്കപ്പെട്ടിരിക്കുന്നു?"},"a":{"en":"Darkness","ta":"அந்தகாரம்","ml":"അന്ധകാരം"},"ref":[64,1,6]},{"q":{"en":"Which two cities are set forth as an example?","ta":"திருஷ்டாந்தமாக வைக்கப்பட்ட இரண்டு பட்டணங்கள் எவை?","ml":"ദൃഷ്ടാന്തമായി കിടക്കുന്ന രണ്ടു പട്ടണങ്ങൾ ഏതു?"},"a":{"en":"Sodom and Gomorrha","ta":"சோதோம் கொமோரா","ml":"സൊദോമും ഗൊമോരയും"},"ref":[64,1,7]},{"q":{"en":"What vengeance did Sodom and Gomorrha suffer?","ta":"சோதோம் கொமோரா பட்டணத்தார் எதன் ஆக்கினையை அடைந்தார்கள்?","ml":"സൊദോമും ഗൊമോരയും എന്തിന്റെ ശിക്ഷാവിധി സഹിക്കുന്നു?"},"a":{"en":"Eternal fire","ta":"நித்திய அக்கினி","ml":"നിത്യാഗ്നി"},"ref":[64,1,7]},{"q":{"en":"What did the filthy dreamers defile?","ta":"சொப்பனக்காரர் எதை அசுசிப்படுத்துகிறார்கள்?","ml":"സ്വപ്നാവസ്ഥയിലുള്ളവർ എന്തിനെ മലിനമാക്കുന്നു?"},"a":{"en":"The flesh","ta":"மாம்சம்","ml":"ജഡം"},"ref":[64,1,8]},{"q":{"en":"Which archangel disputed with the devil?","ta":"பிசாசுடனே தர்க்கித்த பிரதான தூதன் யார்?","ml":"പിശാചിനോടു തർക്കിച്ച പ്രധാനദൂതൻ ആര്?"},"a":{"en":"Michael","ta":"மிகாவேல்","ml":"മിഖായേൽ"},"ref":[64,1,9]},{"q":{"en":"About whose body did Michael dispute with the devil?","ta":"மிகாவேல் யாருடைய சரீரத்தைக் குறித்துப் பிசாசுடன் தர்க்கித்தான்?","ml":"മിഖായേൽ ആരുടെ ശരീരത്തെക്കുറിച്ചു പിശാചിനോടു തർക്കിച്ചു?"},"a":{"en":"Moses","ta":"மோசே","ml":"മോശെ"},"ref":[64,1,9]},{"q":{"en":"What did Michael say to the devil?","ta":"மிகாவேல் பிசாசிடம் என்ன சொன்னான்?","ml":"മിഖായേൽ പിശാചിനോടു എന്തു പറഞ്ഞു?"},"a":{"en":"The Lord rebuke thee","ta":"கர்த்தர் உன்னைக் கடிந்துகொள்வாராக","ml":"കർത്താവു നിന്നെ ഭർത്സിക്കട്ടെ"},"ref":[64,1,9]},{"q":{"en":"Like what do the ungodly men corrupt themselves?","ta":"பக்தியற்றவர்கள் எவைகளைப்போல தங்களைக் கெடுத்துக்கொள்ளுகிறார்கள்?","ml":"അഭക്തർ എന്തുപോലെ തങ്ങളെത്തന്നേ വഷളാക്കുന്നു?"},"a":{"en":"Brute beasts","ta":"புத்தியில்லாத மிருகங்கள்","ml":"ബുദ്ധിയില്ലാത്ത മൃഗങ്ങൾ"},"ref":[64,1,10]},{"q":{"en":"Whose way did the ungodly men walk in?","ta":"பக்தியற்றவர்கள் யாருடைய வழியில் நடந்தார்கள்?","ml":"അഭക്തർ ആരുടെ വഴിയിൽ നടന്നു?"},"a":{"en":"Cain","ta":"காயீன்","ml":"കയീൻ"},"ref":[64,1,11]},{"q":{"en":"Whose error did they run greedily after for reward?","ta":"கூலிக்காக யாருடைய வஞ்சகத்திலே விரைந்தோடினார்கள்?","ml":"കൂലി കൊതിച്ചു അവർ ആരുടെ വഞ്ചനയിൽ ഏല്പിച്ചു?"},"a":{"en":"Balaam","ta":"பிலேயாம்","ml":"ബിലെയാം"},"ref":[64,1,11]},{"q":{"en":"In whose gainsaying did they perish?","ta":"யாருடைய எதிர்த்துப்பேசின பாவத்திற்குள்ளாகிக் கெட்டுப்போனார்கள்?","ml":"അവർ ആരുടെ മത്സരത്തിൽ നശിച്ചുപോയി?"},"a":{"en":"Core","ta":"கோரா","ml":"കോരഹ്"},"ref":[64,1,11]},{"q":{"en":"Like clouds without what are the ungodly men?","ta":"பக்தியற்றவர்கள் எது இல்லாத மேகங்கள் போல இருக்கிறார்கள்?","ml":"അഭക്തർ എന്തില്ലാത്ത മേഘങ്ങൾ പോലെയാകുന്നു?"},"a":{"en":"Water","ta":"தண்ணீர்","ml":"വെള്ളം"},"ref":[64,1,12]},{"q":{"en":"Carried about by what are the waterless clouds?","ta":"தண்ணீரற்ற மேகங்கள் எவைகளால் அடியுண்டோடுகின்றன?","ml":"വെള്ളമില്ലാത്ത മേഘങ്ങൾ എന്തുകൊണ്ടു ഓടുന്നു?"},"a":{"en":"Winds","ta":"காற்றுகள்","ml":"കാറ്റ്"},"ref":[64,1,12]},{"q":{"en":"What do the raging waves of the sea foam out?","ta":"கடலலைகள் எதை நுரைதள்ளுகின்றன?","ml":"കടൽത്തിരകൾ എന്തു നുരെച്ചു തള്ളുന്നു?"},"a":{"en":"Their own shame","ta":"தங்கள் அவமானங்கள்","ml":"നാണക്കേടു"},"ref":[64,1,13]},{"q":{"en":"What is reserved for ever for the wandering stars?","ta":"அலைகிற நட்சத்திரங்களுக்கு என்றென்றைக்கும் எது வைக்கப்பட்டிருக்கிறது?","ml":"വക്രഗതിയുള്ള നക്ഷത്രങ്ങൾക്കു സദാകാലത്തേക്കും എന്തു സൂക്ഷിച്ചിരിക്കുന്നു?"},"a":{"en":"The blackness of darkness","ta":"காரிருள்","ml":"അന്ധതമസ്സു"},"ref":[64,1,13]},{"q":{"en":"Who prophesied about these men?","ta":"இவர்களைக்குறித்து முன்னறிவித்தவன் யார்?","ml":"ഇവരെക്കുറിച്ചു പ്രവചിച്ചതു ആര്?"},"a":{"en":"Enoch","ta":"ஏனோக்கு","ml":"ഹനോക്ക്