[{"q":{"en":"Who wrote the letter to the Colossians?","ta":"கொலோசெயருக்குக் கடிதம் எழுதியவர் யார்?","ml":"കൊലൊസ്സ്യർക്കു ലേഖനം എഴുതിയതു ആര്?"},"a":{"en":"Paul","ta":"பவுல்","ml":"പൌലോസ്"},"ref":[50,1,1]},{"q":{"en":"Who was with Paul when he wrote to the Colossians?","ta":"கொலோசெயருக்கு எழுதியபோது பவுலுடன் இருந்த சகோதரன் யார்?","ml":"കൊലൊസ്സ്യർക്കു എഴുതുമ്പോൾ പൌലോസിനോടുകൂടെ ഉണ്ടായിരുന്ന സഹോദരൻ ആര്?"},"a":{"en":"Timotheus our brother","ta":"தீமோத்தே","ml":"തിമൊഥെയോസ്"},"ref":[50,1,1]},{"q":{"en":"What was Paul by the will of God?","ta":"தேவனுடைய சித்தத்தினாலே பவுல் எவராயிருந்தார்?","ml":"ദൈവേഷ്ടത്താൽ പൌലോസ് എന്തായിരുന്നു?"},"a":{"en":"An apostle of Jesus Christ","ta":"இயேசுகிறிஸ்துவின் அப்போஸ்தலன்","ml":"ക്രിസ്തുയേശുവിന്റെ അപ്പൊസ്തലൻ"},"ref":[50,1,1]},{"q":{"en":"In which city were the saints and faithful brethren to whom Paul wrote?","ta":"பவுல் கடிதம் எழுதிய பரிசுத்தவான்கள் எந்தப் பட்டணத்தில் இருந்தார்கள்?","ml":"പൌലോസ് ലേഖനം എഴുതിയ വിശുദ്ധന്മാർ ഏതു പട്ടണത്തിലുള്ളവർ ആയിരുന്നു?"},"a":{"en":"Colosse","ta":"கொலோசெ","ml":"കൊലൊസ്സ്യ"},"ref":[50,1,2]},{"q":{"en":"What did Paul wish for the Colossians from God our Father?","ta":"பிதாவாகிய தேவனால் உங்களுக்கு உண்டாவதாக என்று பவுல் வாழ்த்தியது என்ன?","ml":"പിതാവായ ദൈവത്തിങ്കൽനിന്നു ഉണ്ടാകട്ടെ എന്നു പൌലോസ് ആശംസിച്ചതു എന്ത്?"},"a":{"en":"Grace and peace","ta":"கிருபையும் சமாதானமும்","ml":"കൃപയും സമാധാനവും"},"ref":[50,1,2]},{"q":{"en":"Whom did Paul and Timothy give thanks to for the Colossians?","ta":"கொலோசெயருக்காக பவுலும் தீமோத்தேயும் யாருக்கு ஸ்தோத்திரம் செலுத்தினார்கள்?","ml":"കൊലൊസ്സ്യർക്കുവേണ്ടി പൌലോസ് ആർക്കു സ്തോത്രം ചെയ്തു?"},"a":{"en":"God the Father","ta":"கர்த்தராகிய இயேசுகிறிஸ்துவின் பிதாவாகிய தேவன்","ml":"നമ്മുടെ കർത്താവായ യേശുക്രിസ്തുവിന്റെ പിതാവായ ദൈവം"},"ref":[50,1,3]},{"q":{"en":"What had Paul heard about the Colossians' faith?","ta":"கொலோசெயரின் விசுவாசத்தைக்குறித்துப் பவுல் கேள்விப்பட்டது எதன்மேலுள்ள விசுவாசம்?","ml":"കൊലൊസ്സ്യരുടെ വിശ്വാസം ആരിൽ ആണെന്നു പൌലോസ് കേട്ടു?"},"a":{"en":"It was in Christ Jesus","ta":"கிறிஸ்து இயேசுவின்மேலுள்ள விசுவாசம்","ml":"ക്രിസ്തുയേശുവിൽ"},"ref":[50,1,4]},{"q":{"en":"Toward whom did the Colossians have love?","ta":"கொலோசெயர் யார்மேல் அன்புடையவர்களாயிருந்தார்கள்?","ml":"കൊലൊസ്സ്യർക്കു ആരോടു സ്നേഹം ഉണ്ടായിരുന്നു?"},"a":{"en":"All the saints","ta":"பரிசுத்தவான்களெல்லார்","ml":"സകലവിശുദ്ധന്മാരോടും"},"ref":[50,1,4]},{"q":{"en":"Where is the hope laid up for the Colossians?","ta":"கொலோசெயருக்காக நம்பிக்கை எங்கே வைக்கப்பட்டிருக்கிறது?","ml":"കൊലൊസ്സ്യർക്കു പ്രത്യാശ എവിടെ സംഗ്രഹിച്ചിരിക്കുന്നു?"},"a":{"en":"In heaven","ta":"பரலோகத்தில்","ml":"സ്വർഗ്ഗത്തിൽ"},"ref":[50,1,5]},{"q":{"en":"In which word had the Colossians heard of the hope before?","ta":"கொலோசெயர் அந்த நம்பிக்கையை எந்த வசனத்தினால் கேள்விப்பட்டார்கள்?","ml":"കൊലൊസ്സ്യർ പ്രത്യാശയെക്കുറിച്ചു ഏതു വചനത്തിൽ കേട്ടു?"},"a":{"en":"The word of the truth of the gospel","ta":"சத்தியவசனமாகிய சுவிசேஷம்","ml":"സുവിശേഷത്തിന്റെ സത്യവചനം"},"ref":[50,1,5]},{"q":{"en":"Where had the gospel spread besides Colosse?","ta":"கொலோசெயரிடத்தில் மட்டுமல்ல, சுவிசேஷம் எங்கெங்கும் பரவியது?","ml":"സുവിശേഷം കൊലൊസ്സ്യയിൽ മാത്രമല്ല, എവിടെയെല്ലാം എത്തി?"},"a":{"en":"In all the world","ta":"உலகமெங்கும்","ml":"സർവ്വലോകത്തിലും"},"ref":[50,1,6]},{"q":{"en":"What does the gospel bring forth in all the world?","ta":"சுவிசேஷம் உலகமெங்கும் பரவி எதைத் தருகிறது?","ml":"സുവിശേഷം സർവ്വലോകത്തിലും എന്തു കായിക്കുന്നു?"},"a":{"en":"Fruit","ta":"பலன்","ml":"ഫലം"},"ref":[50,1,6]},{"q":{"en":"From whom did the Colossians learn the gospel?","ta":"கொலோசெயர் சுவிசேஷத்தை யாரிடத்தில் கற்றறிந்தார்கள்?","ml":"കൊലൊസ്സ്യർ സുവിശേഷം ആരോടു പഠിച്ചു?"},"a":{"en":"Epaphras","ta":"எப்பாப்பிரா","ml":"എപ്പഫ്രാസ്"},"ref":[50,1,7]},{"q":{"en":"How did Paul describe Epaphras?","ta":"பவுல் எப்பாப்பிராவை எப்படி அழைத்தார்?","ml":"പൌലോസ് എപ്പഫ്രാസിനെ എങ്ങനെ വിശേഷിപ്പിച്ചു?"},"a":{"en":"Our dear fellowservant","ta":"பிரியமான உடன்வேலையாள்","ml":"പ്രിയ സഹഭൃത്യൻ"},"ref":[50,1,7]},{"q":{"en":"What did Epaphras declare to Paul about the Colossians?","ta":"எப்பாப்பிரா பவுலுக்கு எதைத் தெரியப்படுத்தினான்?","ml":"എപ്പഫ്രാസ് പൌലോസിനോടു എന്തിനെക്കുറിച്ചു അറിയിച്ചു?"},"a":{"en":"Their love in the Spirit","ta":"ஆவிக்குள்ளான அன்பு","ml":"ആത്മാവിനാലുള്ള സ്നേഹം"},"ref":[50,1,8]},{"q":{"en":"What did Paul and Timothy not cease to do for the Colossians?","ta":"கொலோசெயருக்காக பவுலும் தீமோத்தேயும் எதை விடவில்லை?","ml":"കൊലൊസ്സ്യർക്കുവേണ്ടി പൌലോസ് എന്തു മുടങ്ങാതെ ചെയ്തു?"},"a":{"en":"Pray","ta":"ஜெபம்","ml":"പ്രാർത്ഥന"},"ref":[50,1,9]},{"q":{"en":"With what did Paul pray that the Colossians be filled?","ta":"கொலோசெயர் எதினால் நிரப்பப்படவேண்டுமென்று பவுல் ஜெபித்தார்?","ml":"കൊലൊസ്സ്യർ എന്തുകൊണ്ടു നിറയണമെന്നു പൌലോസ് പ്രാർത്ഥിച്ചു?"},"a":{"en":"The knowledge of his will","ta":"அவருடைய சித்தத்தை அறிகிற அறிவு","ml":"അവന്റെ ഇഷ്ടത്തിന്റെ പരിജ്ഞാനം"},"ref":[50,1,9]},{"q":{"en":"How did Paul pray that the Colossians would walk?","ta":"கொலோசெயர் எப்படி நடக்கவேண்டுமென்று பவுல் ஜெபித்தார்?","ml":"കൊലൊസ്സ്യർ എങ്ങനെ നടക്കണമെന്നു പൌലോസ് പ്രാർത്ഥിച്ചു?"},"a":{"en":"Worthy of the Lord","ta":"கர்த்தருக்குப் பாத்திரராய்","ml":"കർത്താവിന്നു യോഗ്യമാകുംവണ്ണം"},"ref":[50,1,10]},{"q":{"en":"In what should the Colossians be fruitful?","ta":"கொலோசெயர் எதிலே கனிதர வேண்டும்?","ml":"കൊലൊസ്സ്യർ ഏതിൽ ഫലം കായിക്കേണം?"},"a":{"en":"Every good work","ta":"சகலவித நற்கிரியைகள்","ml":"സകല സൽപ്രവൃത്തി"},"ref":[50,1,10]},{"q":{"en":"According to what power are believers strengthened?","ta":"விசுவாசிகள் எவ்வல்லமையின்படி பலப்படுத்தப்படுகிறார்கள்?","ml":"വിശ്വാസികൾ ഏതു ശക്തിക്കു ഒത്തവണ്ണം ബലപ്പെടുന്നു?"},"a":{"en":"His glorious power","ta":"மகிமையான அவருடைய வல்லமை","ml":"അവന്റെ മഹത്വത്തിന്റെ വല്ലഭത്വം"},"ref":[50,1,11]},{"q":{"en":"Who has made us meet to be partakers of the inheritance of the saints in light?","ta":"ஒளியிலுள்ள பரிசுத்தவான்களுடைய சுதந்தரத்தில் பங்கடைய நம்மைத் தகுதியுள்ளவர்களாக்கினவர் யார்?","ml":"വിശുദ്ധന്മാരുടെ അവകാശത്തിന്നു നമ്മെ പ്രാപ്തന്മാരാക്കിയതു ആര്?"},"a":{"en":"The Father","ta":"பிதா","ml":"പിതാവു"},"ref":[50,1,12]},{"q":{"en":"From what power has the Father delivered us?","ta":"பிதா நம்மை எதினின்று விடுதலையாக்கினார்?","ml":"പിതാവു നമ്മെ എന്തിൽനിന്നു വിടുവിച്ചു?"},"a":{"en":"The power of darkness","ta":"இருளின் அதிகாரம்","ml":"ഇരുട്ടിന്റെ അധികാരം"},"ref":[50,1,13]},{"q":{"en":"Into whose kingdom has God translated us?","ta":"தேவன் நம்மை யாருடைய ராஜ்யத்திற்கு உட்படுத்தினார்?","ml":"ദൈവം നമ്മെ ആരുടെ രാജ്യത്തിലാക്കി?"},"a":{"en":"His dear Son","ta":"தமது அன்பின் குமாரன்","ml":"സ്നേഹസ്വരൂപനായ പുത്രൻ"},"ref":[50,1,13]},{"q":{"en":"What do we have in Christ through his blood?","ta":"கிறிஸ்துவுக்குள் அவருடைய இரத்தத்தினாலே நமக்கு உண்டாயிருப்பது என்ன?","ml":"ക്രിസ്തുവിൽ നമുക്കു ഉള്ളതു എന്ത്?"},"a":{"en":"Redemption","ta":"மீட்பு","ml":"വീണ്ടെടുപ്പു"},"ref":[50,1,14]},{"q":{"en":"What is the redemption we have in Christ?","ta":"கிறிஸ்துவில் நமக்குள்ள மீட்பு என்னது?","ml":"ക്രിസ്തുവിലെ വീണ്ടെടുപ്പു എന്താകുന്നു?"},"a":{"en":"The forgiveness of sins","ta":"பாவமன்னிப்பு","ml":"പാപമോചനം"},"ref":[50,1,14]},{"q":{"en":"Whose image is Christ?","ta":"கிறிஸ்து யாருடைய தற்சுரூபமானவர்?","ml":"ക്രിസ്തു ആരുടെ പ്രതിമയാകുന്നു?"},"a":{"en":"The invisible God","ta":"அதரிசனமான தேவன்","ml":"അദൃശ്യനായ ദൈവം"},"ref":[50,1,15]},{"q":{"en":"Of what is Christ the firstborn?","ta":"கிறிஸ்து எதற்கு முந்தின பேறானவர்?","ml":"ക്രിസ്തു എന്തിനു ആദ്യജാതൻ ആകുന്നു?"},"a":{"en":"Every creature","ta":"சர்வ சிருஷ்டி","ml":"സർവ്വസൃഷ്ടി"},"ref":[50,1,15]},{"q":{"en":"By whom were all things created?","ta":"சகலமும் யாருக்குள் சிருஷ்டிக்கப்பட்டது?","ml":"സകലവും ആർ മുഖാന്തരം സൃഷ്ടിക്കപ്പെട്ടു?"},"a":{"en":"By Christ","ta":"கிறிஸ்து","ml":"ക്രിസ്തു"},"ref":[50,1,16]},{"q":{"en":"Which four powers are named among the things created?","ta":"சிருஷ்டிக்கப்பட்டவைகளில் குறிப்பிடப்பட்ட நான்கு வகைகள் யாவை?","ml":"സൃഷ്ടിക്കപ്പെട്ടവയിൽ പറഞ്ഞിരിക്കുന്ന നാലു കാര്യങ്ങൾ ഏതെല്ലാം?"},"a":{"en":"Thrones, dominions, principalities, powers","ta":"சிங்காசனங்கள், கர்த்தத்துவங்கள், துரைத்தனங்கள், அதிகாரங்கள்","ml":"സിംഹാസനങ്ങൾ, കർത്തൃത്വങ്ങൾ, വാഴ്ചകൾ, അധികാരങ്ങൾ"},"ref":[50,1,16]},{"q":{"en":"In whom do all things consist?","ta":"எல்லாம் யாருக்குள் நிலைநிற்கிறது?","ml":"സകലത്തിന്നും ആധാരമായിരിക്കുന്നതു ആര്?"},"a":{"en":"Christ","ta":"கிறிஸ்து","ml":"ക്രിസ്തു"},"ref":[50,1,17]},{"q":{"en":"Of what body is Christ the head?","ta":"கிறிஸ்து எந்த சரீரத்துக்குத் தலையானவர்?","ml":"ക്രിസ്തു ഏതു ശരീരത്തിന്റെ തലയാകുന്നു?"},"a":{"en":"The church","ta":"சபை","ml":"സഭ"},"ref":[50,1,18]},{"q":{"en":"Christ is the firstborn from where?","ta":"கிறிஸ்து எவர்களிலிருந்து எழுந்த முதற்பேறானவர்?","ml":"ക്രിസ്തു ആരുടെ ഇടയിൽനിന്നു ആദ്യനായി എഴുന്നേറ്റവൻ?"},"a":{"en":"From the dead","ta":"மரித்தோர்","ml":"മരിച്ചവർ"},"ref":[50,1,18]},{"q":{"en":"What pleased the Father to dwell in Christ?","ta":"பிதாவுக்குப் பிரியமாய் கிறிஸ்துவுக்குள் வாசமாயிருப்பது என்ன?","ml":"പിതാവിന്നു പ്രസാദം തോന്നി, ക്രിസ്തുവിൽ വസിക്കുന്നതു എന്ത്?"},"a":{"en":"All fulness","ta":"சகல பரிபூரணம்","ml":"സർവ്വസമ്പൂർണ്ണത"},"ref":[50,1,19]},{"q":{"en":"Through what did Christ make peace?","ta":"கிறிஸ்து எதினாலே சமாதானத்தை உண்டாக்கினார்?","ml":"ക്രിസ്തു എന്തു കൊണ്ടു സമാധാനം ഉണ്ടാക്കി?"},"a":{"en":"The blood of his cross","ta":"சிலுவையில் சிந்தின இரத்தம்","ml":"ക്രൂശിൽ ചൊരിഞ്ഞ രക്തം"},"ref":[50,1,20]},{"q":{"en":"What were the Colossians before being reconciled?","ta":"முன்னே கொலோசெயர் எப்படிப்பட்டவர்களாயிருந்தார்கள்?","ml":"മുമ്പെ കൊലൊസ്സ്യർ എങ്ങനെയുള്ളവരായിരുന്നു?"},"a":{"en":"Alienated and enemies","ta":"அந்நியராயும் சத்துருக்களாயும்","ml":"അകന്നവരും ശത്രുക്കളും"},"ref":[50,1,21]},{"q":{"en":"Through what has Christ reconciled us in the body of his flesh?","ta":"கிறிஸ்து தமது மாம்ச சரீரத்தில் எதினாலே நம்மை ஒப்புரவாக்கினார்?","ml":"ക്രിസ്തു തന്റെ ജഡശരീരത്തിൽ എന്തിനാൽ നമ്മെ നിരപ്പിച്ചു?"},"a":{"en":"Death","ta":"மரணம்","ml":"മരണം"},"ref":[50,1,22]},{"q":{"en":"How will Christ present the reconciled before him?","ta":"கிறிஸ்து தமக்கு முன் எப்படி நிறுத்துவார்?","ml":"ക്രിസ്തു തന്റെ മുമ്പിൽ നമ്മെ എങ്ങനെ നിറുത്തും?"},"a":{"en":"Holy and unblameable and unreproveable","ta":"பரிசுத்தராகவும் குற்றமற்றவர்களாகவும்","ml":"വിശുദ്ധരും നിഷ്കളങ്കരും കുറ്റമില്ലാത്തവരും"},"ref":[50,1,22]},{"q":{"en":"In what must the Colossians continue, grounded and settled?","ta":"கொலோசெயர் எதிலே ஸ்திரமாயும் உறுதியாயும் நிலைத்திருக்கவேண்டும்?","ml":"കൊലൊസ്സ്യർ ഏതിൽ അടിസ്ഥാനപ്പെട്ടവരായി നിലനിൽക്കേണം?"},"a":{"en":"The faith","ta":"விசுவாசம்","ml":"വിശ്വാസം"},"ref":[50,1,23]},{"q":{"en":"To whom was the gospel preached, of which Paul was made a minister?","ta":"பவுல் ஊழியக்காரனான சுவிசேஷம் யாருக்குப் பிரசங்கிக்கப்பட்டது?","ml":"പൌലോസ് ശുശ്രൂഷകനായ സുവിശേഷം ആരുടെ ഇടയിൽ ഘോഷിക്കപ്പെട്ടു?"},"a":{"en":"Every creature under heaven","ta":"வானத்தின் கீழிருக்கிற சகல சிருஷ்டிகள்","ml":"ആകാശത്തിൻ കീഴെ സകല സൃഷ്ടികൾ"},"ref":[50,1,23]},{"q":{"en":"In what did Paul rejoice?","ta":"பவுல் எதில் சந்தோஷமடைந்தார்?","ml":"പൌലോസ് എന്തിൽ സന്തോഷിച്ചു?"},"a":{"en":"His sufferings for the Colossians","ta":"உங்கள் நிமித்தம் அநுபவிக்கிற பாடுகள்","ml":"നിങ്ങൾക്കു വേണ്ടിയുള്ള കഷ്ടാനുഭവങ്ങൾ"},"ref":[50,1,24]},{"q":{"en":"What is the body of Christ?","ta":"கிறிஸ்துவின் சரீரம் என்பது என்ன?","ml":"ക്രിസ്തുവിന്റെ ശരീരം എന്താകുന്നു?"},"a":{"en":"The church","ta":"சபை","ml":"സഭ"},"ref":[50,1,24]},{"q":{"en":"Of what was Paul made a minister according to God's dispensation?","ta":"தேவனால் அளிக்கப்பட்ட உத்தியோகத்தின்படி பவுல் எதற்கு ஊழியக்காரனானார்?","ml":"ദൈവം നല്കിയ ഉദ്യോഗപ്രകാരം പൌലോസ് എന്തിന്റെ ശുശ്രൂഷകനായി?"},"a":{"en":"The church","ta":"சபை","ml":"സഭ"},"ref":[50,1,25]},{"q":{"en":"What had been hid from ages and generations?","ta":"ஆதிகாலங்களுக்கும் தலைமுறைகளுக்கும் மறைவாயிருந்தது என்ன?","ml":"പൂർവ്വകാലങ്ങൾക്കും തലമുറകൾക്കും മറഞ്ഞുകിടന്നതു എന്ത്?"},"a":{"en":"The mystery","ta":"இரகசியம்","ml":"മർമ്മം"},"ref":[50,1,26]},{"q":{"en":"To whom has the mystery now been made manifest?","ta":"இப்பொழுது இரகசியம் யாருக்கு வெளியாக்கப்பட்டது?","ml":"മർമ്മം ഇപ്പോൾ ആർക്കു വെളിപ്പെട്ടിരിക്കുന്നു?"},"a":{"en":"His saints","ta":"பரிசுத்தவான்கள்","ml":"വിശുദ്ധന്മാർ"},"ref":[50,1,26]},{"q":{"en":"Among whom is the riches of the glory of this mystery?","ta":"இந்த இரகசியத்தின் மகிமையின் ஐசுவரியம் யாருக்குள்ளே விளங்கிற்று?","ml":"ഈ മർമ്മത്തിന്റെ മഹിമാധനം ആരുടെ ഇടയിൽ അറിയിക്കപ്പെട്ടു?"},"a":{"en":"The Gentiles","ta":"புறஜாதிகள்","ml":"ജാതികൾ"},"ref":[50,1,27]},{"q":{"en":"What is the mystery?","ta":"அந்த இரகசியம் என்ன?","ml":"ആ മർമ്മം എന്ത്?"},"a":{"en":"Christ in you","ta":"கிறிஸ்து உங்களுக்குள் இருப்பது","ml":"ക്രിസ്തു നിങ്ങളിൽ"},"ref":[50,1,27]},{"q":{"en":"Whom do Paul and Timothy preach?","ta":"பவுலும் தீமோத்தேயும் யாரை அறிவிக்கிறார்கள்?","ml":"പൌലോസും കൂട്ടരും ആരെ അറിയിക്കുന്നു?"},"a":{"en":"Christ","ta":"கிறிஸ்து","ml":"ക്രിസ്തു"},"ref":[50,1,28]},{"q":{"en":"How do they want to present every man in Christ Jesus?","ta":"ஒவ்வொருவரையும் கிறிஸ்து இயேசுவுக்குள் எப்படி நிறுத்த விரும்புகிறார்கள்?","ml":"ഏതു മനുഷ്യനെയും ക്രിസ്തുവിൽ എങ്ങനെ നിറുത്തുവാൻ ആഗ്രഹിക്കുന്നു?"},"a":{"en":"Perfect","ta":"தேறினவனாக","ml":"തികഞ്ഞവനായി"},"ref":[50,1,28]},{"q":{"en":"According to whose working did Paul labour and strive?","ta":"பவுல் யாருடைய பலத்தின்படி போராடிப் பிரயாசப்பட்டார்?","ml":"പൌലോസ് ആരുടെ വ്യാപാരശക്തിക്കു ഒത്തവണ്ണം അദ്ധ്വാനിച്ചു?"},"a":{"en":"Christ's working in him mightily","ta":"தமக்குள்ளே வல்லமையாய்க் கிரியை நடப்பிக்கிற கிறிஸ்து","ml":"തന്നിൽ ബലത്തോടെ വ്യാപരിക്കുന്ന ക്രിസ്തു"},"ref":[50,1,29]},{"q":{"en":"For whom besides the Colossians did Paul have great conflict?","ta":"கொலோசெயர் அல்லாமல் யாருக்காக பவுலுக்கு மிகுந்த போராட்டம் இருந்தது?","ml":"കൊലൊസ്സ്യർ അല്ലാതെ ആർക്കുവേണ്ടി പൌലോസ് വലിയ പോരാട്ടം കഴിച്ചു?"},"a":{"en":"Them at Laodicea","ta":"லவோதிக்கேயாவிலிருக்கிறவர்கள்","ml":"ലവുദിക്യയിലുള്ളവർ"},"ref":[50,2,1]},{"q":{"en":"What did Paul have for the Colossians and Laodiceans?","ta":"கொலோசெயருக்காகவும் லவோதிக்கேயருக்காகவும் பவுலுக்கு இருந்தது என்ன?","ml":"കൊലൊസ്സ്യർക്കും ലവുദിക്യയിലുള്ളവർക്കും വേണ്ടി പൌലോസിനു ഉണ്ടായിരുന്നതു എന്ത്?"},"a":{"en":"Great conflict","ta":"மிகுந்த போராட்டம்","ml":"വലിയ പോരാട്ടം"},"ref":[50,2,1]},{"q":{"en":"What did Paul want their hearts to be?","ta":"அவர்களுடைய இருதயங்கள் எப்படியிருக்க பவுல் விரும்பினார்?","ml":"അവരുടെ ഹൃദയങ്ങൾക്കു എന്തു ലഭിക്കേണം എന്നു പൌലോസ് ആഗ്രഹിച്ചു?"},"a":{"en":"Comforted","ta":"தேற்றப்பட்டு","ml":"ആശ്വാസം"},"ref":[50,2,2]},{"q":{"en":"In what were their hearts to be knit together?","ta":"அவர்கள் எதினால் இணைக்கப்பட வேண்டும்?","ml":"അവർ ഏതിൽ ഏകീഭവിക്കേണം?"},"a":{"en":"Love","ta":"அன்பு","ml":"സ്നേഹം"},"ref":[50,2,2]},{"q":{"en":"What is the mystery of God, according to this verse?","ta":"தேவனுடைய இரகசியம் யார் என்று இந்த வசனம் கூறுகிறது?","ml":"ദൈവ മർമ്മം ആരാകുന്നു?"},"a":{"en":"Christ","ta":"கிறிஸ்து","ml":"ക്രിസ്തു"},"ref":[50,2,2]},{"q":{"en":"In Christ are hid all the treasures of what?","ta":"கிறிஸ்துவுக்குள் அடங்கியிருக்கிற பொக்கிஷங்கள் எவை?","ml":"ക്രിസ്തുവിൽ ഗുപ്തമായിരിക്കുന്ന നിക്ഷേപങ്ങൾ ഏതിന്റേതു?"},"a":{"en":"Wisdom and knowledge","ta":"ஞானம் அறிவு","ml":"ജ്ഞാനവും പരിജ്ഞാനവും"},"ref":[50,2,3]},{"q":{"en":"Why did Paul say these things to the Colossians?","ta":"பவுல் இவற்றை ஏன் சொன்னார்?","ml":"പൌലോസ് ഇതു എന്തിനു പറഞ്ഞു?"},"a":{"en":"Lest any man beguile them","ta":"ஒருவனும் வஞ்சியாதபடிக்கு","ml":"ആരും ചതിക്കാതിരിപ്പാൻ"},"ref":[50,2,4]},{"q":{"en":"With what kind of words might a man beguile them?","ta":"எப்படிப்பட்ட வார்த்தைகளால் ஒருவன் வஞ்சிக்கலாம்?","ml":"ഏതുവിധ വാക്കുകൊണ്ടു ആരെങ്കിലും ചതിച്ചേക്കാം?"},"a":{"en":"Enticing words","ta":"நயவசனிப்பு","ml":"വശീകരണവാക്കു"},"ref":[50,2,4]},{"q":{"en":"Where was Paul absent, though with them in the spirit?","ta":"பவுல் எதில் தூரமாயிருந்தார்?","ml":"പൌലോസ് ഏതിൽ ദൂരസ്ഥനായിരുന്നു?"},"a":{"en":"In the flesh","ta":"சரீரம்","ml":"ശരീരം"},"ref":[50,2,5]},{"q":{"en":"What did Paul rejoice to behold in the Colossians?","ta":"கொலோசெயரில் பவுல் எதைப் பார்த்துச் சந்தோஷப்பட்டார்?","ml":"കൊലൊസ്സ്യരിൽ പൌലോസ് എന്തു കണ്ടു സന്തോഷിച്ചു?"},"a":{"en":"Their order and stedfast faith","ta":"ஒழுங்கும் விசுவாசத்தின் உறுதியும்","ml":"ക്രമവും വിശ്വാസത്തിന്റെ സ്ഥിരതയും"},"ref":[50,2,5]},{"q":{"en":"As you have received Christ Jesus the Lord, how should you walk?","ta":"கிறிஸ்து இயேசுவை ஏற்றுக்கொண்டபடியே யாருக்குள் நடக்க வேண்டும்?","ml":"കർത്താവായ ക്രിസ്തുയേശുവിനെ കൈക്കൊണ്ടതുപോലെ ആരിൽ നടക്കേണം?"},"a":{"en":"In him","ta":"அவருக்குள்","ml":"അവന്റെ കൂട്ടായ്മയിൽ"},"ref":[50,2,6]},{"q":{"en":"In what are believers to be stablished?","ta":"விசுவாசிகள் எதில் உறுதிப்படவேண்டும்?","ml":"വിശ്വാസികൾ ഏതിൽ ഉറെച്ചിരിക്കേണം?"},"a":{"en":"The faith","ta":"விசுவாசம்","ml":"വിശ്വാസം"},"ref":[50,2,7]},{"q":{"en":"With what should believers abound in the faith?","ta":"விசுவாசத்தில் எதோடே பெருகவேண்டும்?","ml":"വിശ്വാസത്തിൽ എന്തിനാൽ കവിഞ്ഞിരിക്കേണം?"},"a":{"en":"Thanksgiving","ta":"ஸ்தோத்திரம்","ml":"സ്തോത്രം"},"ref":[50,2,7]},{"q":{"en":"Of what should believers beware, lest any man spoil them?","ta":"ஒருவனும் கொள்ளைகொண்டுபோகாதபடிக்கு எதைக்குறித்து எச்சரிக்கையாயிருக்க வேண்டும்?","ml":"ആരും കവർന്നുകളയാതിരിപ്പാൻ എന്തിനെക്കുറിച്ചു സൂക്ഷിക്കേണം?"},"a":{"en":"Philosophy and vain deceit","ta":"லெளகிக ஞானம் மாயமான தந்திரம்","ml":"തത്വജ്ഞാനവും വെറും വഞ്ചനയും"},"ref":[50,2,8]},{"q":{"en":"Not after whom is the tradition of men?","ta":"மனுஷர்களின் பாரம்பரியம் யாரைப் பற்றினதல்ல?","ml":"മനുഷ്യരുടെ സമ്പ്രദായം ആരെ അനുസരിച്ചുള്ളതല്ല?"},"a":{"en":"Christ","ta":"கிறிஸ்து","ml":"ക്രിസ്തു"},"ref":[50,2,8]},{"q":{"en":"What dwells in Christ bodily?","ta":"கிறிஸ்துவுக்குள் சரீரப்பிரகாரமாக வாசமாயிருப்பது என்ன?","ml":"ക്രിസ്തുവിൽ ദേഹരൂപമായി വസിക്കുന്നതു എന്ത്?"},"a":{"en":"All the fulness of the Godhead","ta":"தேவத்துவத்தின் பரிபூரணம்","ml":"ദൈവത്തിന്റെ സർവ്വ സമ്പൂർണ്ണത"},"ref":[50,2,9]},{"q":{"en":"Of what is Christ the head?","ta":"கிறிஸ்து எதற்கெல்லாம் தலைவராயிருக்கிறார்?","ml":"ക്രിസ്തു എന്തിനെല്ലാം തലയാകുന്നു?"},"a":{"en":"All principality and power","ta":"சகல துரைத்தனங்களுக்கும் அதிகாரத்துக்கும்","ml":"എല്ലാവാഴ്ചെക്കും അധികാരത്തിന്നും"},"ref":[50,2,10]},{"q":{"en":"In whom are believers complete?","ta":"விசுவாசிகள் யாருக்குள் பரிபூரணமுள்ளவர்களாயிருக்கிறார்கள்?","ml":"വിശ്വാസികൾ ആരിൽ പരിപൂർണ്ണരായിരിക്കുന്നു?"},"a":{"en":"In Christ","ta":"கிறிஸ்து","ml":"ക്രിസ്തു"},"ref":[50,2,10]},{"q":{"en":"What kind of circumcision have believers received in Christ?","ta":"கிறிஸ்துவுக்குள் எப்படிப்பட்ட விருத்தசேதனத்தைப் பெற்றோம்?","ml":"ക്രിസ്തുവിൽ ഏതുതരം പരിച്ഛേദന ലഭിച്ചു?"},"a":{"en":"Made without hands","ta":"கையால் செய்யப்படாதது","ml":"കൈകൊണ്ടല്ലാത്തതു"},"ref":[50,2,11]},{"q":{"en":"With whom are believers buried in baptism?","ta":"ஞானஸ்நானத்திலே விசுவாசிகள் யாரோடு அடக்கம்பண்ணப்பட்டார்கள்?","ml":"സ്നാനത്തിൽ വിശ്വാസികൾ ആരോടുകൂടെ അടക്കപ്പെട്ടു?"},"a":{"en":"With Christ","ta":"கிறிஸ்து","ml":"ക്രിസ്തു"},"ref":[50,2,12]},{"q":{"en":"Who raised Christ from the dead?","ta":"கிறிஸ்துவை மரித்தோரிலிருந்தெழுப்பினவர் யார்?","ml":"ക്രിസ്തുവിനെ മരിച്ചവരുടെ ഇടയിൽനിന്നു ഉയിർത്തെഴുന്നേല്പിച്ചതു ആര്?"},"a":{"en":"God","ta":"தேவன்","ml":"ദൈവം"},"ref":[50,2,12]},{"q":{"en":"In what were the Colossians dead before being made alive?","ta":"கொலோசெயர் உயிர்ப்பிக்கப்படுமுன் எவைகளினால் மரித்தவர்களாயிருந்தார்கள்?","ml":"ജീവിപ്പിക്കപ്പെടുംമുമ്പു കൊലൊസ്സ്യർ എന്തിൽ മരിച്ചവരായിരുന്നു?"},"a":{"en":"Their sins and uncircumcision","ta":"பாவங்களினாலும் விருத்தசேதனமில்லாமையினாலும்","ml":"അതിക്രമങ്ങളിലും അഗ്രചർമ്മത്തിലും"},"ref":[50,2,13]},{"q":{"en":"What has God done with all our trespasses?","ta":"நம்முடைய அக்கிரமங்களையெல்லாம் தேவன் என்ன செய்தார்?","ml":"നമ്മുടെ അതിക്രമങ്ങളെല്ലാം ദൈവം എന്തു ചെയ്തു?"},"a":{"en":"Forgiven them","ta":"மன்னித்தார்","ml":"ക്ഷമിച്ചു"},"ref":[50,2,13]},{"q":{"en":"What did Christ blot out that was against us?","ta":"நமக்கு விரோதமாயிருந்ததில் கிறிஸ்து எதைக் குலைத்தார்?","ml":"നമുക്കു വിരോധമായിരുന്നതിൽ ക്രിസ്തു എന്തു മായിച്ചു?"},"a":{"en":"The handwriting of ordinances","ta":"கையெழுத்து","ml":"കയ്യെഴുത്തു"},"ref":[50,2,14]},{"q":{"en":"To what did Christ nail the handwriting?","ta":"கிறிஸ்து கையெழுத்தை எதின்மேல் ஆணியடித்தார்?","ml":"ക്രിസ്തു കയ്യെഴുത്തു എവിടെ തറെച്ചു?"},"a":{"en":"His cross","ta":"சிலுவை","ml":"ക്രൂശ്"},"ref":[50,2,14]},{"q":{"en":"Whom did Christ spoil and make a shew of openly?","ta":"கிறிஸ்து யாரை உரிந்துகொண்டு வெளியரங்கமான கோலமாக்கினார்?","ml":"ക്രിസ്തു ആരെ ആയുധവർഗ്ഗം വെപ്പിച്