[["சிறிய பாலையை விட்டுக்கொள்ளுங்கள்.",-1],["காலையான பாதையில் பாதுகிறேன்.",-1],["லெலுயா கர்த்தரியி",0],["ஏக பண்து பியுங்கர்",0],["அவன் நடத்தும் செய்யுங்கள்",1],["செயல்களெல்லாம் பாட்டோரைக் குதியும்",1],["நன்றாக வருங்கள்",1],["சம்மையாய் கிடியே செய்யும் அல்லோரிக்",2],["பல்லோரிக்குதியும் கர்க்கிறேன்",2],["எல்லோரையும் கேட்சுக்கொள்ளும்",3],["பொருளும் கேசுமை குபியும் கேன்",3],["ராஜாலி ராஜாலி செல்லுங்கள்",4],["செல்லுங்கள்",4],["நான் குழந்தையை வாழ்க்கிறேன்",5],["வாய்வும் தேவுயா, வாய்வும் தேவுயா,",6],["தேவாலி புதியமுக்கல",7],["அன்லேலுயா, அன்லேலுயா",6],["அல்லியுயா! தேவனைத் துதியுங்கள்!",7],["இயேசுராஜன்",7],["இயேசுராஜன்",7],["கண்டரியும் குழுக்கும்",8],["நான் பத்திநான் பாவன் கடை",9],["கடையின் போத்தினா புதியுங்கள்",9],["கடையில் குழுக்கை",10],["ஏய்ந்தாலும் உள்ளே நீலைத் துவியும்",10],["செய்யுங்கள் நீங்கள் காலை",10],["ஏன் காலத்தில் காலத்தில் கேசுக்கிறார்கள்?",11],["ஏசோ பெர்த்து திவுங்காலாம்",11],["நான் நான் நிதான் நான் நீ சுதாகி",12],["சிலாகின்று பூரியில் ஆட்சி செய்காது",13],["சிக்ஸேகா அல்லேயோயா",14],["ஏதோ ஏதோ ஏதோ ஏதோ",15],["வெளியை வாழ்க்கும் பாதையில்",15],["காலுமே உங்கா, காலுமே துயாம்",15],["ஏவாரிக்கும் நியும் பர்வேறு",15],["சூரிய வேறு",16],["சந்தி நலி, நேர்வரைக் குழியு,",16],["ஐயா",16],["ரொடியாதே நெய்யெங்கெலுள்ளம்",17],["அடித்தோய் துதியுங்க",17],["பத்தினியே கல்வர",18],["கல் வருயே, பாடைக்கோவே துவியுங்கள்",18],["நட்பினியா",19],["தினியால் கல்வந்த கலி.",19],["தூலை போலை தூலியும் பெலே",19],["காசாலி ராஜனோ பின் சுரோக்கு",20],["சுரோக்கு நூபு, பூவியை மாற்றி செய்வான்",21],["அல்லவு யாரு?",22],["நம்மா நிலும்பியாம் நம்மா நிலும்பியாம்",22],["காலையை விடுவேன்",23],["அலுவலியா, அலுவலியா,",22],["தேவா விட்டு யுந்துவிடு",23],["காட்சாலி ராஜனா வீசுகாடு",20],["ஏன் சுவார்து, பிருமியில் ஆசிரிசை வா.",21],["சிவா அல்லேலுயா",22],["தெருயாம் தெருயாம் தேவனைத் துதியுங்கள்",23],["அல்லேலுயா",22],["அல்லேலுயா, அல்லேலுயா, தேவா",22],["தேவரைத் துதியுங்கள்",23],["ஐயா",23],["ஏனென்றால் நான் பார்க்கலாம்",23],["ஐயா",23],["அல்லிலுயா கத்தரையா",0],["கத்தரையில் ஏகமைத் துதியுங்கள்",0],["அவன் அடத்தும்",1],["செயல்களெல்லாம் பாட்டோரைக்க