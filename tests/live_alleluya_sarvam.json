[[38.3,"எப்படியும்."],[41.7,"அப்படி வந்தவுடனே நீங்க பண்ண முதல் விஷயம்"],[45,"இந்த மாதிரி வேலை."],[53.1,"எல்லோரையும்."],[60.8,"ஹல்லேலூயா."],[64.2,"யா கர்த்தரையே."],[67.7,"மிகவும் துதியுங்கள்."],[71,"அவர் நடத்தும் செயல்களெல்லாம்."],[75.2,"காத்துரை குதியுங்கள்."],[77.6,"எல்லாரையும்."],[80.9,"இயேசுவைத்."],[84.3,"எல்லோரையும்."],[87.6,"எல்லோரையும் ஏற்றுக்கொள்ளும்."],[91.6,"எங்கள்."],[95.5,"ராஜாவாகிய இயேசுவுக்காய்."],[99.5,"மீளா செய்யும்."],[103.3,"அல்லேலூயா அல்லேலூயா."],[106.6,"தேவனை துதியுங்கள்."],[112.8,"அல்லேலூயா அல்லேலூயா."],[116.6,"இயேசுவைத்."],[165.7,"கர்த்தரை."],[169.2,"ஏகபற்றுங்கள்."],[172.2,"அவர் நடத்தும் செயல்களெல்லாம்."],[175.6,"எல்லாரையும்."],[181.6,"இயேசுவைத்."],[187.7,"எல்லோரையும்."],[193.7,"எல்லோரையும்."],[199.8,"இயேசுவக்காய் பூமியில் ஆட்சி செய்வார்."]]
